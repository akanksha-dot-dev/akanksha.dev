---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = posts.find(p => p.data.featured);
const rest = posts.filter(p => p !== featured);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="Blog — Akanksha | Production AI Engineer" description="Writing about production AI systems, RAG architecture, agentic AI, and the journey from EEE to AI Engineer.">
  
  <section class="relative overflow-hidden">
    <div class="orb orb-purple" style="top: -100px; right: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="fade-in mb-12">
        <span class="badge mb-4">Blog</span>
        <h1 class="font-(--font-heading) text-4xl md:text-5xl font-800 mb-4 tracking-tight">
          Thoughts & <span class="gradient-text">Insights</span>
        </h1>
        <p class="text-(--color-text-secondary) text-lg max-w-2xl">
          Writing about production AI, RAG architecture, agentic systems, and lessons 
          from building enterprise AI at scale.
        </p>
      </div>
      
      {/* Featured Post */}
      {featured && (
        <a href={`/blog/${featured.id}`} class="glass p-6 md:p-8 block group mb-10 fade-in relative overflow-hidden">
          <div class="orb orb-teal" style="top: -150px; right: -150px; width: 200px; height: 200px; opacity: 0.06;"></div>
          <div class="relative z-10">
            <span class="badge-amber badge text-[0.6rem] mb-3">Featured</span>
            <h2 class="font-(--font-heading) font-700 text-xl md:text-2xl mb-3 group-hover:text-(--color-teal) transition-colors">
              {featured.data.title}
            </h2>
            <p class="text-(--color-text-secondary) text-sm leading-relaxed mb-4">
              {featured.data.description}
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-(--font-mono) text-xs text-(--color-text-muted)">{formatDate(featured.data.date)}</span>
              {featured.data.readTime && (
                <>
                  <span class="text-(--color-text-muted)">·</span>
                  <span class="font-(--font-mono) text-xs text-(--color-text-muted)">{featured.data.readTime} read</span>
                </>
              )}
              <div class="flex gap-1.5 ml-auto">
                {featured.data.tags.map(t => <span class="badge text-[0.55rem]">{t}</span>)}
              </div>
            </div>
          </div>
        </a>
      )}
      
      {/* Other Posts */}
      {rest.length > 0 ? (
        <div class="space-y-4 stagger">
          {rest.map(post => (
            <a href={`/blog/${post.id}`} class="glass p-5 flex flex-col md:flex-row md:items-center gap-3 group fade-in">
              <div class="flex-1">
                <h3 class="font-(--font-heading) font-600 text-base group-hover:text-(--color-teal) transition-colors mb-1">
                  {post.data.title}
                </h3>
                <p class="text-(--color-text-secondary) text-sm leading-relaxed line-clamp-2">
                  {post.data.description}
                </p>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="font-(--font-mono) text-xs text-(--color-text-muted)">{formatDate(post.data.date)}</span>
                <svg class="w-4 h-4 text-(--color-text-muted) group-hover:text-(--color-teal) transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      ) : !featured && (
        <div class="text-center py-20 glass p-8 fade-in">
          <p class="text-4xl mb-4">📝</p>
          <p class="text-(--color-text-secondary) text-lg font-(--font-heading) font-600 mb-2">Coming Soon</p>
          <p class="text-(--color-text-muted) text-sm">First post dropping soon. Follow on LinkedIn for updates.</p>
        </div>
      )}
      
      <!-- Cross-post notice -->
      <div class="fade-in mt-10 glass-static p-5 text-center rounded-xl">
        <p class="text-(--color-text-secondary) text-sm">
          Posts are also published on 
          <a href="https://dev.to/akanksha-dev" target="_blank" rel="noopener" class="text-(--color-teal) hover:underline">Dev.to</a>, 
          <a href="https://linkedin.com/in/akankshadev" target="_blank" rel="noopener" class="text-(--color-teal) hover:underline">LinkedIn</a>, and 
          <a href="https://medium.com/@akankshadev" target="_blank" rel="noopener" class="text-(--color-teal) hover:underline">Medium</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
