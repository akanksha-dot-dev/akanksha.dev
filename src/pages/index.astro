---
import BaseLayout from '../layouts/BaseLayout.astro';

const metrics = [
  { value: '4+', label: 'Years Experience' },
  { value: '300+', label: 'Certifications' },
  { value: '500+', label: 'Incidents Resolved' },
  { value: '98%', label: 'Service Reliability' },
];

const featuredProjects = [
  {
    title: 'AgenticAI Workshop',
    description: 'Multi-agent AI orchestration framework with Google ADK, MCP protocol integration, tool-use patterns & autonomous workflows.',
    tags: ['Google ADK', 'LangChain', 'Agentic AI', 'MCP'],
    href: 'https://github.com/akanksha-dot-dev/AgenticAI-Workshop',
    icon: '🤖',
  },
  {
    title: 'Multi-Agent Research System',
    description: 'Production-grade multi-agent research framework with guardrails, evaluation harness & async pipelines for machine-generated text.',
    tags: ['Python', 'FastAPI', 'Multi-Agent', 'Guardrails'],
    href: 'https://github.com/akanksha-dot-dev/Multi-Agent-For-MGT',
    icon: '🧠',
  },
  {
    title: 'Near Miss Incident Analysis',
    description: 'Predictive knowledge graph web app leveraging NLP for near-miss incident analysis & prevention in industrial settings.',
    tags: ['NLP', 'Knowledge Graph', 'Python', 'Dashboard'],
    href: 'https://github.com/akanksha-dot-dev/Urban-Intelligence-Dashboard-Final',
    icon: '🔬',
  },
];

const techStack = [
  { name: 'Python', icon: '🐍' },
  { name: 'Google ADK', icon: '🤖' },
  { name: 'LangChain', icon: '🔗' },
  { name: 'FastAPI', icon: '⚡' },
  { name: 'RAG', icon: '🔍' },
  { name: 'LLMs', icon: '🧠' },
  { name: 'Docker', icon: '🐳' },
  { name: 'AWS', icon: '☁️' },
];
---

<BaseLayout title="Akanksha — Production AI Engineer | RAG · Agents · LLMs">
  
  <!-- ═══ HERO SECTION ═══ -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <!-- Background Orbs -->
    <div class="orb orb-teal" style="top: -200px; right: -100px;"></div>
    <div class="orb orb-amber" style="bottom: -150px; left: -100px;"></div>
    
    <div class="max-w-6xl mx-auto px-6 py-20 relative z-10">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="fade-in mb-6">
          <span class="badge">
            <span class="w-2 h-2 rounded-full bg-(--color-teal) animate-pulse"></span>
            Currently building AI at Samsung SDS
          </span>
        </div>
        
        <!-- Heading -->
        <h1 class="fade-in font-(--font-heading) text-5xl md:text-7xl font-800 leading-[1.1] mb-6">
          Hey, I'm <span class="gradient-text">Akanksha</span>
        </h1>
        
        <p class="fade-in text-xl md:text-2xl text-(--color-text-secondary) mb-4 font-(--font-heading) font-500">
          Production AI Engineer
        </p>
        
        <p class="fade-in text-lg text-(--color-text-secondary) mb-8 max-w-2xl leading-relaxed">
          I build AI systems that enterprises actually rely on — not just proof-of-concepts that impress in demos. 
          <span class="text-(--color-teal)">RAG pipelines</span>, 
          <span class="text-(--color-amber)">autonomous agents</span>, and 
          <span class="text-(--color-teal)">LLM infrastructure</span> at scale.
        </p>
        
        <!-- CTAs -->
        <div class="fade-in flex flex-wrap gap-4">
          <a href="/projects" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            View Projects
          </a>
          <a href="/contact" class="btn-outline">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- ═══ METRICS BAR ═══ -->
  <section class="relative z-10 -mt-8 mb-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="glass p-2 grid grid-cols-2 md:grid-cols-4">
        {metrics.map(m => (
          <div class="metric">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- ═══ TECH STACK MARQUEE ═══ -->
  <section class="mb-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex gap-4 flex-wrap justify-center">
        {techStack.map(tech => (
          <span class="badge text-sm px-4 py-2">
            <span>{tech.icon}</span> {tech.name}
          </span>
        ))}
      </div>
    </div>
  </section>
  
  <!-- ═══ FEATURED PROJECTS ═══ -->
  <section class="max-w-6xl mx-auto px-6 mb-24">
    <div class="fade-in text-center mb-12">
      <h2 class="section-title gradient-text">Featured Projects</h2>
      <p class="section-subtitle">Production-grade AI systems, not tutorial clones</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map(project => (
        <a href={project.href} target="_blank" rel="noopener" class="glass p-6 flex flex-col gap-4 group cursor-pointer">
          <div class="text-3xl">{project.icon}</div>
          <h3 class="font-(--font-heading) font-700 text-lg group-hover:text-(--color-teal) transition-colors">
            {project.title}
          </h3>
          <p class="text-(--color-text-secondary) text-sm leading-relaxed flex-1">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map(tag => (
              <span class="badge text-[0.65rem]">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-8">
      <a href="/projects" class="btn-outline text-sm">
        View All Projects →
      </a>
    </div>
  </section>
  
  <!-- ═══ ABOUT PREVIEW ═══ -->
  <section class="max-w-6xl mx-auto px-6 mb-24">
    <div class="glass p-8 md:p-12 relative overflow-hidden">
      <div class="orb orb-teal" style="top: -200px; right: -200px; width: 300px; height: 300px; opacity: 0.1;"></div>
      
      <div class="relative z-10 max-w-3xl">
        <div class="fade-in">
          <h2 class="section-title">The Short Version</h2>
          <p class="text-(--color-text-secondary) leading-relaxed mb-6">
            I'm a Production AI Engineer at Samsung SDS, Gurugram. I architect the full GenAI stack: 
            autonomous AI agents with Google ADK, enterprise RAG pipelines processing financial documents, 
            and LLM infrastructure serving 500+ daily queries at 92% accuracy.
          </p>
          <p class="text-(--color-text-secondary) leading-relaxed mb-6">
            My journey is unconventional — I studied Electrical Engineering in Darbhanga, Bihar, taught 
            myself to code through hackathons, and built my way to leading AI projects at a global company. 
            I've earned <span class="text-(--color-amber) font-semibold">300+ certifications</span> and 
            <span class="text-(--color-teal) font-semibold">won national hackathons</span> along the way.
          </p>
          <a href="/about" class="btn-primary inline-flex">
            Read My Full Story →
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- ═══ CTA SECTION ═══ -->
  <section class="max-w-6xl mx-auto px-6 mb-12">
    <div class="fade-in text-center py-16">
      <h2 class="font-(--font-heading) text-3xl md:text-4xl font-800 mb-4">
        Let's build the future of AI <span class="gradient-text">together</span>
      </h2>
      <p class="text-(--color-text-secondary) mb-8 max-w-lg mx-auto">
        Open to collaborations on Agentic AI, Production RAG, LLM Infrastructure & Enterprise AI.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="mailto:me@akanksha.dev" class="btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Email Me
        </a>
        <a href="https://linkedin.com/in/akankshadev" target="_blank" rel="noopener" class="btn-outline">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
  
</BaseLayout>
