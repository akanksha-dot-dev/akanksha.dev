---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found | akanksha.dev">
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="text-center px-6">
      <p class="text-8xl font-(--font-heading) font-800 gradient-text mb-4">404</p>
      <h1 class="font-(--font-heading) text-2xl font-700 mb-3">Page not found</h1>
      <p class="text-(--color-text-secondary) mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist. Maybe it was moved, or maybe it never existed — 
        like a hallucination from a poorly-tuned LLM.
      </p>
      <a href="/" class="btn-primary">
        ← Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
