---
import BaseLayout from '../layouts/BaseLayout.astro';

const socials = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/akankshadev', icon: '💼', description: 'Professional updates & career content' },
  { name: 'GitHub', href: 'https://github.com/akanksha-dot-dev', icon: '🐙', description: 'Open-source projects & code' },
  { name: 'Twitter/X', href: 'https://x.com/akankshadotdev', icon: '🐦', description: 'Quick thoughts & AI insights' },
  { name: 'Dev.to', href: 'https://dev.to/akanksha-dev', icon: '📝', description: 'Technical articles & tutorials' },
  { name: 'HuggingFace', href: 'https://huggingface.co/akanksha-dev', icon: '🤗', description: 'Models & ML experiments' },
  { name: 'Kaggle', href: 'https://kaggle.com/akankshadotdev', icon: '📊', description: 'Data science competitions' },
];

const topics = [
  { id: 'role', label: '🎯 Senior AI Role / Hiring' },
  { id: 'project', label: '🤝 Project Advisory / Consulting' },
  { id: 'speaking', label: '🎤 Speaking / Workshop' },
  { id: 'general', label: '💡 General Inquiry / Hello' },
];
---

<BaseLayout title="Contact & Conversion — Akanksha | Production AI Engineer" description="Get in touch with Akanksha. Open to Senior/Staff Production AI Engineer roles, collaborations, speaking engagements, and enterprise AI advisory.">
  
  <section class="relative overflow-hidden" aria-label="Contact Conversion Form">
    <div class="orb orb-amber" style="top: -100px; right: -200px;"></div>
    <div class="orb orb-teal" style="bottom: 200px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="fade-in mb-10">
        <!-- Live Availability Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-300 text-xs font-(--font-mono) mb-4">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          <span>Open to Senior/Staff AI Engineer Roles · Q3/Q4 2026 · Replies within 24h</span>
        </div>

        <h1 class="font-(--font-heading) text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-white">
          Let's <span class="gradient-text">Connect</span>
        </h1>
        <p class="text-(--color-text-secondary) text-base sm:text-lg max-w-2xl leading-relaxed">
          Whether you're looking to discuss a Senior/Staff AI Engineer role, invite me to speak at a conference, 
          or explore enterprise RAG and Agentic systems — I'd love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
        <!-- Main Form (7 cols) -->
        <div class="lg:col-span-7 glass p-6 sm:p-8 fade-in relative" id="contact-form-container">
          <h2 class="font-(--font-heading) font-bold text-lg sm:text-xl mb-4 text-white">
            Send a Direct Message
          </h2>
          
          <form id="contact-form" class="flex flex-col gap-4" novalidate>
            <!-- Invisible Bot Defense (Honeypot) -->
            <input type="text" name="_gotcha" id="form-gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            
            <!-- Timestamp for speed-bot detection -->
            <input type="hidden" id="form-render-timestamp" value="" />

            <!-- Topic Selector -->
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider">What is this regarding?</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="topic-button-group">
                {topics.map((t, idx) => (
                  <button 
                    type="button" 
                    class:list={['topic-btn text-left p-2.5 rounded-xl border text-xs font-(--font-mono) transition-all cursor-pointer flex items-center gap-1.5', idx === 0 ? 'border-(--color-teal) bg-(--color-teal-glow) text-(--color-teal)' : 'border-(--color-border) bg-[#080E1E]/40 text-(--color-text-secondary) hover:border-white/20']}
                    data-topic={t.label}
                  >
                    <span>{t.label}</span>
                  </button>
                ))}
              </div>
              <input type="hidden" id="selected-topic" value={topics[0].label} />
            </div>

            <!-- Name Field -->
            <div class="flex flex-col gap-1">
              <label for="contact-name" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider">Your Name <span class="text-red-400">*</span></label>
              <input 
                type="text" 
                id="contact-name" 
                required 
                placeholder="Alex Mercer"
                class="w-full bg-[#080E1E]/60 border border-(--color-border) p-3 text-xs sm:text-sm rounded-xl text-(--color-text-primary) font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal)"
              />
              <span id="error-name" class="hidden text-[10px] font-(--font-mono) text-red-400">Please enter your name.</span>
            </div>

            <!-- Email Field -->
            <div class="flex flex-col gap-1">
              <label for="contact-email" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider">Your Email <span class="text-red-400">*</span></label>
              <input 
                type="email" 
                id="contact-email" 
                required 
                placeholder="alex@company.com"
                class="w-full bg-[#080E1E]/60 border border-(--color-border) p-3 text-xs sm:text-sm rounded-xl text-(--color-text-primary) font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal)"
              />
              <span id="error-email" class="hidden text-[10px] font-(--font-mono) text-red-400">Please enter a valid email address.</span>
            </div>

            <!-- Message Field -->
            <div class="flex flex-col gap-1">
              <div class="flex justify-between items-center">
                <label for="contact-message" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider">Message <span class="text-red-400">*</span></label>
                <span id="char-counter" class="text-[10px] font-(--font-mono) text-(--color-text-muted)">0 / 1000</span>
              </div>
              <textarea 
                id="contact-message" 
                rows="4" 
                required 
                maxlength="1000"
                placeholder="Tell me about your role, team, or project details..."
                class="w-full bg-[#080E1E]/60 border border-(--color-border) p-3 text-xs sm:text-sm rounded-xl text-(--color-text-primary) font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) leading-relaxed"
              ></textarea>
              <span id="error-message" class="hidden text-[10px] font-(--font-mono) text-red-400">Please provide a brief message.</span>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="btn-submit-contact" 
              class="btn-primary w-full py-3 text-sm font-semibold mt-2 cursor-pointer shadow-[0_0_16px_rgba(0,240,181,0.3)]"
            >
              🚀 Dispatch Message
            </button>
            <p class="text-[10px] font-(--font-mono) text-(--color-text-muted) text-center mt-1">
              Direct delivery to me@akanksha.dev · Client-side verified · No tracking spam
            </p>
          </form>

          <!-- Success State Box (Hidden initially) -->
          <div id="contact-success-state" class="hidden flex flex-col items-center justify-center text-center gap-4 py-8 animate-fadeIn">
            <div class="w-14 h-14 rounded-full bg-(--color-teal-glow) border border-(--color-teal) flex items-center justify-center text-2xl text-(--color-teal) shadow-lg">
              ✓
            </div>
            <div>
              <h3 class="font-(--font-heading) font-extrabold text-xl text-white mb-1">Message Prepared!</h3>
              <p class="text-xs text-(--color-text-secondary) max-w-sm leading-relaxed" id="success-msg-desc">
                Your message has been formatted. Click below to confirm dispatch via your default email client or copy the formatted note.
              </p>
            </div>
            <div class="flex flex-wrap gap-3 justify-center">
              <a id="btn-open-email-client" href="#" class="btn-primary text-xs py-2 px-4">
                Open Email Client
              </a>
              <button type="button" id="btn-copy-formatted-msg" class="btn-outline text-xs py-2 px-4">
                Copy Formatted Note
              </button>
            </div>
            <button type="button" id="btn-reset-form" class="text-xs font-(--font-mono) text-(--color-text-muted) hover:text-(--color-teal) mt-2 underline cursor-pointer">
              Send another note
            </button>
          </div>
        </div>

        <!-- Sidebar Conversion Options (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-4 fade-in">
          <!-- Direct Email Box -->
          <div class="glass p-5 flex flex-col gap-3">
            <div class="flex items-center gap-2 text-(--color-teal)">
              <span class="text-xl">📧</span>
              <h3 class="font-(--font-heading) font-bold text-sm text-white">Direct Inbox</h3>
            </div>
            <p class="text-xs text-(--color-text-secondary) leading-relaxed">
              Prefer writing directly from your client? Feel free to email me anytime:
            </p>
            <div class="font-(--font-mono) text-sm text-(--color-teal) font-semibold select-all">
              me@akanksha.dev
            </div>
            <button 
              type="button" 
              id="btn-copy-email" 
              class="btn-outline text-xs py-2 flex items-center justify-center gap-2 cursor-pointer mt-1"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span id="copy-email-label">Copy Email Address</span>
            </button>
          </div>

          <!-- Resume Dossier Box -->
          <div class="glass p-5 flex flex-col gap-3">
            <div class="flex items-center gap-2 text-(--color-amber)">
              <span class="text-xl">📄</span>
              <h3 class="font-(--font-heading) font-bold text-sm text-white">Resume Dossier</h3>
            </div>
            <p class="text-xs text-(--color-text-secondary) leading-relaxed">
              Updated for Senior/Staff Production AI Engineer roles (Agentic RAG, LLM Infrastructure, Multi-Agent Orchestration).
            </p>
            <a 
              href="/resume/akanksha_resume.pdf" 
              target="_blank" 
              rel="noopener" 
              class="btn-outline text-xs py-2 flex items-center justify-center gap-2 border-amber-500/40 text-amber-300 hover:bg-amber-500/10"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download PDF Dossier</span>
            </a>
          </div>

          <!-- Availability Signaling -->
          <div class="glass-static p-4 border border-(--color-border) bg-[#080E1E]/50 rounded-xl text-xs font-(--font-mono) flex flex-col gap-2">
            <div class="text-[10px] text-(--color-text-muted) uppercase tracking-wider font-semibold">Response Guarantee</div>
            <div class="flex items-center justify-between">
              <span class="text-(--color-text-secondary)">⚡ Response Time:</span>
              <span class="text-(--color-teal) font-bold">&lt; 24–48 Hours</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-(--color-text-secondary)">Timezone:</span>
              <span class="text-(--color-text-muted)">IST (UTC+5:30) · Global Sync</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Social Links Grid -->
      <div class="fade-in">
        <h2 class="section-title mb-2 text-white">Find Me Across the Web</h2>
        <p class="section-subtitle mb-6">Open source, research papers, technical writing & professional updates</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
          {socials.map(s => (
            <a 
              href={s.href} 
              target="_blank" 
              rel="noopener" 
              class="glass p-4 flex items-center gap-3 group hover:border-(--color-teal) transition-all"
            >
              <span class="text-2xl p-2 rounded-lg bg-white/5 border border-white/5">{s.icon}</span>
              <div>
                <h3 class="font-(--font-heading) font-semibold text-xs sm:text-sm text-white group-hover:text-(--color-teal) transition-colors flex items-center gap-1">
                  <span>{s.name}</span>
                  <span class="text-[10px] text-(--color-text-muted)">↗</span>
                </h3>
                <p class="text-[11px] text-(--color-text-muted)">{s.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    function initContactPage() {
      const renderTimestampInput = document.getElementById('form-render-timestamp') as HTMLInputElement | null;
      if (renderTimestampInput) {
        renderTimestampInput.value = Date.now().toString();
      }

      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const successState = document.getElementById('contact-success-state');
      const topicButtons = document.querySelectorAll('.topic-btn');
      const selectedTopicInput = document.getElementById('selected-topic') as HTMLInputElement | null;
      const charCounter = document.getElementById('char-counter');
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const gotchaInput = document.getElementById('form-gotcha') as HTMLInputElement | null;

      const errName = document.getElementById('error-name');
      const errEmail = document.getElementById('error-email');
      const errMessage = document.getElementById('error-message');

      const btnOpenEmailClient = document.getElementById('btn-open-email-client') as HTMLAnchorElement | null;
      const btnCopyFormattedMsg = document.getElementById('btn-copy-formatted-msg');
      const btnResetForm = document.getElementById('btn-reset-form');

      const btnCopyEmail = document.getElementById('btn-copy-email');
      const copyEmailLabel = document.getElementById('copy-email-label');
      const playSound = (window as any).__AK_PLAY_SOUND__ || (() => {});

      // Copy raw email
      btnCopyEmail?.addEventListener('click', () => {
        playSound('click');
        navigator.clipboard.writeText('me@akanksha.dev').then(() => {
          playSound('success');
          if (copyEmailLabel) copyEmailLabel.textContent = 'Email Copied!';
          setTimeout(() => {
            if (copyEmailLabel) copyEmailLabel.textContent = 'Copy Email Address';
          }, 2000);
        });
      });

      // Topic Selection
      topicButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          playSound('click');
          topicButtons.forEach(b => {
            b.classList.remove('border-(--color-teal)', 'bg-(--color-teal-glow)', 'text-(--color-teal)');
            b.classList.add('border-(--color-border)', 'bg-[#080E1E]/40', 'text-(--color-text-secondary)');
          });
          btn.classList.add('border-(--color-teal)', 'bg-(--color-teal-glow)', 'text-(--color-teal)');
          btn.classList.remove('border-(--color-border)', 'bg-[#080E1E]/40', 'text-(--color-text-secondary)');
          
          const topicVal = btn.getAttribute('data-topic');
          if (selectedTopicInput && topicVal) {
            selectedTopicInput.value = topicVal;
          }
        });
      });

      // Char Counter
      messageInput?.addEventListener('input', () => {
        if (charCounter && messageInput) {
          charCounter.textContent = `${messageInput.value.length} / 1000`;
        }
      });

      // Form Submit & Client-side Validation
      form?.addEventListener('submit', (e) => {
        e.preventDefault();

        // Bot defenses
        if (gotchaInput && gotchaInput.value) {
          console.warn("Bot detected via honeypot trap.");
          return;
        }

        const renderTime = parseInt(renderTimestampInput?.value || '0', 10);
        if (Date.now() - renderTime < 800) {
          console.warn("Bot detected via sub-second submission.");
          return;
        }

        let hasError = false;
        const name = nameInput?.value.trim() || '';
        const email = emailInput?.value.trim() || '';
        const message = messageInput?.value.trim() || '';
        const topic = selectedTopicInput?.value || 'General';

        if (!name) {
          errName?.classList.remove('hidden');
          hasError = true;
        } else {
          errName?.classList.add('hidden');
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) {
          errEmail?.classList.remove('hidden');
          hasError = true;
        } else {
          errEmail?.classList.add('hidden');
        }

        if (!message) {
          errMessage?.classList.remove('hidden');
          hasError = true;
        } else {
          errMessage?.classList.add('hidden');
        }

        if (hasError) {
          playSound('click');
          return;
        }

        playSound('success');

        // Build mailto link
        const subject = encodeURIComponent(`[akanksha.dev] ${topic} from ${name}`);
        const bodyText = `Hi Akanksha,\n\n${message}\n\n---\nSender: ${name} (${email})\nTopic: ${topic}`;
        const mailtoUrl = `mailto:me@akanksha.dev?subject=${subject}&body=${encodeURIComponent(bodyText)}`;

        if (btnOpenEmailClient) {
          btnOpenEmailClient.href = mailtoUrl;
        }

        // Copy formatted note button
        btnCopyFormattedMsg?.addEventListener('click', () => {
          playSound('click');
          navigator.clipboard.writeText(bodyText).then(() => {
            playSound('success');
            if (btnCopyFormattedMsg) btnCopyFormattedMsg.textContent = 'Copied to Clipboard!';
            setTimeout(() => {
              if (btnCopyFormattedMsg) btnCopyFormattedMsg.textContent = 'Copy Formatted Note';
            }, 2000);
          });
        });

        // Switch to success state
        form.classList.add('hidden');
        successState?.classList.remove('hidden');

        // Automatically trigger mailto for seamless client transition
        window.location.href = mailtoUrl;
      });

      // Reset
      btnResetForm?.addEventListener('click', () => {
        playSound('click');
        form?.reset();
        successState?.classList.add('hidden');
        form?.classList.remove('hidden');
        if (charCounter) charCounter.textContent = '0 / 1000';
      });
    }

    initContactPage();
    document.addEventListener('astro:page-load', initContactPage);
  </script>
</BaseLayout>
