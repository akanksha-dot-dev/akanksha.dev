---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
---

<BaseLayout 
  title="AI Knowledge Graph — Akanksha | Production AI Engineer"
  description="Interactive visual node graph mapping production AI concepts, agentic framework stack, system design sandboxes, and enterprise RAG projects."
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 space-y-16">
    <!-- Hero Header -->
    <div class="max-w-3xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        Interactive Architecture Map
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Enterprise AI <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400">
          Knowledge Graph
        </span>
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed">
        Map the relational dependencies across Agentic RAG, NeMo Guardrail security, vLLM inference optimization, Ragas metrics, and enterprise project implementations at Samsung SDS.
      </p>
    </div>

    <!-- Main Knowledge Graph Component -->
    <KnowledgeGraph />

    <!-- Related Deep Dives -->
    <div class="pt-8 border-t border-white/10 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/orchestrator" class="p-6 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-xl hover:border-cyan-500/40 transition-all group">
        <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors flex items-center justify-between">
          <span>Orchestrator Studio</span>
          <span>→</span>
        </h3>
        <p class="text-slate-400 text-xs mt-2 leading-relaxed">
          Simulate multi-agent execution graphs, step telemetry, and tool invocation parameters.
        </p>
      </a>

      <a href="/evals" class="p-6 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-xl hover:border-purple-500/40 transition-all group">
        <h3 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors flex items-center justify-between">
          <span>LLM Evals & Guardrails</span>
          <span>→</span>
        </h3>
        <p class="text-slate-400 text-xs mt-2 leading-relaxed">
          Benchmark Ragas context precision, faithfulness, and NeMo prompt injection guardrails.
        </p>
      </a>

      <a href="/sandbox" class="p-6 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-xl hover:border-emerald-500/40 transition-all group">
        <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors flex items-center justify-between">
          <span>System Design Sandbox</span>
          <span>→</span>
        </h3>
        <p class="text-slate-400 text-xs mt-2 leading-relaxed">
          Calculate token vector memory budgets, indexing latencies, and throughput scaling.
        </p>
      </a>
    </div>
  </div>
</BaseLayout>
