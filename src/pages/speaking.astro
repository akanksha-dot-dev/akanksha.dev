---
import BaseLayout from '../layouts/BaseLayout.astro';

const speakingEngagements = [
  {
    title: 'AI Mobile Hackathon — Deep Dive Session on AI for Mobile Developers',
    event: 'AI Mobile Hackathon',
    organizer: 'Community (Anand Gaur)',
    date: '2026-06-16',
    location: 'Delhi NCR',
    role: 'Session Leader',
    audience: 'Mobile developers and AI enthusiasts',
    topics: [
      'Evolution of Intelligence: OpenAI history to Transformer architectures',
      'Attention mechanisms and token prediction algorithms',
      'Fine-tuning with Temperature, Top-P, Top-K hyper-parameters',
      'RAG implementation, Graph vector search, and prompt engineering',
      'Live demo: Training custom models and deploying edge inferences',
    ],
    videoUrl: 'https://www.youtube.com/watch?v=-8xTRNfq-DE',
    codelabUrl: 'https://github.com/akanksha-dot-dev/AgenticAI-Workshop',
    linkedinUrl: 'https://www.linkedin.com/in/akankshadev',
    icon: '📹',
  },
  {
    title: 'INCEPT\'26 — Industry Talk on AI, Career Growth & Production Software Engineering',
    event: 'INCEPT\'26',
    organizer: 'Google Developer Groups - GLA University, Mathura',
    date: '2026-04-28',
    location: 'GLA University, Mathura',
    role: 'Keynote Speaker',
    audience: '100+ engineering students and developers',
    topics: [
      'Skills that matter in modern AI software engineering careers',
      'How Generative AI & autonomous agents are transforming development',
      'Using AI tools for developer productivity and production observability',
      'What enterprise companies expect from future-ready AI engineers',
      'Journey breakdown: From tier-3 college to leading AI squads',
    ],
    coSpeakers: ['Nitish Singh (Founder, CampusX)', 'Anand Gaur (Mobile Tech Lead)'],
    linkedinUrl: 'https://www.linkedin.com/in/akankshadev',
    icon: '🎤',
  },
];

const eventsAttended = [
  { name: 'Google Cloud Summit: Builder Connect India', date: 'Jun 10, 2026', org: 'Google Cloud', location: 'Yashobhoomi, Delhi', topics: ['Agentic AI', 'Enterprise Agent Platform', 'ADK'] },
  { name: 'Google Cloud Summit India', date: 'Jun 6, 2026', org: 'Google Cloud', location: 'Yashobhoomi', topics: ['Agentic AI', 'ADK', 'MCP', 'A2A'] },
  { name: 'Google Cloud Builder Day Delhi', date: 'May 26, 2026', org: 'Google for Developers', location: 'Delhi', topics: ['Agentic AI', 'Gemini', 'ADK deployment'] },
  { name: 'AI Day for Startups India', date: 'May 19, 2026', org: 'IHFC (IIT Delhi) + Google', location: 'Delhi', topics: ['Physical AI', 'Sovereign AI', 'MedGemma'] },
  { name: 'GitHub Copilot Community Days', date: 'May 12, 2026', org: 'AICamp', location: 'Virtual', topics: ['Context Engineering', 'RAG', '12-Factor Agents'] },
  { name: 'Data & GenAI Nexus 7.0', date: 'May 6, 2026', org: 'GDG Noida', location: 'Noida', topics: ['Event-Driven AI Agents', 'Neo4j Graph Eval'] },
  { name: 'Cloud/AI/Data Security — US Embassy Event', date: 'Apr 21, 2026', org: 'American Center + Microsoft UG', location: 'US Embassy, New Delhi', topics: ['Azure Cosmos DB', 'AI-Native', 'Agentic Apps'] },
  { name: 'SheLeadsAI Symposium', date: 'Apr 14, 2026', org: 'ShesSharp', location: 'REA Cyber City, Gurugram', topics: ['Women in AI', 'Agentic AI in Enterprise'] },
  { name: 'Experts Live India @ Microsoft Gurugram', date: 'Apr 2, 2026', org: 'Microsoft UG', location: 'Microsoft Office, Gurugram', topics: ['Microsoft Fabric', 'Agentic AI', 'AIOps'] },
  { name: 'India AI Impact Summit 2026', date: 'Feb 16, 2026', org: 'Government of India', location: 'Bharat Mandapam, New Delhi', topics: ['Physical AI', 'Sovereign AI', 'PARAM 2'] },
  { name: 'AWS User Group Delhi NCR', date: 'Feb 12, 2026', org: 'AWS UG NCR', location: 'Delhi NCR', topics: ['Amazon Bedrock', 'Kiro', 'Agentic Architecture'] },
  { name: 'Build Space 2.0 — ADK + RAG Workshop', date: 'Feb 6, 2026', org: 'Google / Community', location: 'Delhi NCR', topics: ['Google ADK', 'Cross-Encoders', 'HyDE'] },
  { name: 'Atlassian Community Event', date: 'Jan 13, 2026', org: 'Atlassian', location: 'Delhi NCR', topics: ['PRD Agent', 'Rovo', 'AI in Jira'] },
  { name: 'Data Leadership World Summit 1.0', date: 'Dec 31, 2025', org: 'Microsoft UG', location: 'Delhi NCR', topics: ['Agentic AI', 'Copilot', 'Data Leadership'] },
  { name: 'Google × Kaggle 5-Day AI Agents Intensive', date: 'Dec 20, 2025', org: 'Google + Kaggle', location: 'Virtual', topics: ['AI Agent Design', 'MCP', 'A2A', 'Evaluation'] },
  { name: 'DevFest Noida', date: 'Dec 7, 2025', org: 'GDG Noida', location: 'Noida', topics: ['Core Web Vitals', 'Hybrid AI Mobile Apps'] },
  { name: 'ServiceNow Developer Meetup', date: 'Nov 28, 2025', org: 'ServiceNow Delhi + Nagarro', location: 'Delhi NCR', topics: ['Workflow Data Fabric', 'AIOps'] },
  { name: 'Redis Released — Delhi Meetup', date: 'Nov 21, 2025', org: 'Redis Delhi', location: 'Delhi', topics: ['Redis LangCache', 'Vector Sets', 'AI-first caching'] },
  { name: 'Startup Mahakumbh', date: 'Apr 3, 2025', org: 'Government/Industry', location: 'New Delhi', topics: ['Startups', 'Innovation'] },
];

const communities = [
  'GDG Noida', 'GDG Cloud New Delhi', 'GDG Gurugram', 'AWS User Group Delhi NCR',
  'Microsoft UG: UP Power BI Club', 'Redis Delhi Community', 'ServiceNow Delhi',
  'GitHub India Community', 'Hack2skill Community', 'AICamp', 'Cloud Native Gurugram', 'IHFC (IIT Delhi)',
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="Speaking & Community — Akanksha | Production AI Engineer" description="Speaker at INCEPT'26 and AI Mobile Hackathon. Active across 12+ Delhi NCR AI communities with 25+ events attended. YouTube recordings available.">
  
  <section class="relative overflow-hidden" aria-label="Speaking and Community Leadership">
    <div class="orb orb-teal" style="top: -100px; right: -200px;"></div>
    <div class="orb orb-amber" style="bottom: 400px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="fade-in mb-10">
        <span class="badge mb-4">Tech Ecosystem & Thought Leadership</span>
        <h1 class="font-(--font-heading) text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-white">
          Speaking & <span class="gradient-text">Community</span>
        </h1>
        <p class="text-(--color-text-secondary) text-base sm:text-lg max-w-2xl leading-relaxed">
          I believe in building in public and giving back to the developer ecosystem. From keynote sessions to mentoring hackathons and attending 25+ tech summits.
        </p>
      </div>
      
      <!-- Stats Bar -->
      <div class="fade-in glass-static p-2 grid grid-cols-2 md:grid-cols-4 rounded-2xl mb-14 border border-(--color-border)">
        <div class="metric">
          <div class="metric-value">2</div>
          <div class="metric-label">Speaker Talks</div>
        </div>
        <div class="metric">
          <div class="metric-value">25+</div>
          <div class="metric-label">Events Attended</div>
        </div>
        <div class="metric">
          <div class="metric-value">12+</div>
          <div class="metric-label">AI Communities</div>
        </div>
        <div class="metric">
          <div class="metric-value">8.8K</div>
          <div class="metric-label">LinkedIn Reach</div>
        </div>
      </div>
      
      <!-- ─── Speaking Engagements ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6 text-white">🎤 Speaking Engagements & Workshops</h2>
        
        <div class="space-y-6">
          {speakingEngagements.map(talk => (
            <div class="glass p-6 sm:p-8">
              <div class="flex items-start gap-4">
                <span class="text-3xl p-2.5 rounded-xl bg-[#080E1E] border border-(--color-border)">{talk.icon}</span>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="badge-amber badge text-xs">{talk.role}</span>
                    <span class="text-xs font-(--font-mono) text-(--color-text-muted)">{formatDate(talk.date)}</span>
                    <span class="text-xs font-(--font-mono) text-(--color-text-muted)">· {talk.location}</span>
                  </div>
                  
                  <h3 class="font-(--font-heading) font-bold text-lg sm:text-xl text-white mb-1">
                    {talk.title}
                  </h3>
                  
                  <p class="text-xs text-(--color-text-muted) font-(--font-mono) mb-3">
                    {talk.event} · Organized by {talk.organizer} · Audience: {talk.audience}
                  </p>
                  
                  {talk.coSpeakers && (
                    <p class="text-xs text-(--color-text-secondary) mb-3 font-(--font-mono)">
                      <strong class="text-white">Co-Speakers:</strong> {talk.coSpeakers.join(', ')}
                    </p>
                  )}
                  
                  <!-- Topics Covered -->
                  <div class="mb-4">
                    <h4 class="text-xs font-(--font-mono) uppercase tracking-wider text-(--color-text-muted) mb-2">Key Topics</h4>
                    <ul class="space-y-1 text-xs text-(--color-text-secondary)">
                      {talk.topics.map(t => (
                        <li class="flex items-start gap-2">
                          <span class="text-(--color-teal) mt-0.5">•</span>
                          <span>{t}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  
                  <!-- Action Links -->
                  <div class="flex flex-wrap gap-3 pt-3 border-t border-(--color-border)">
                    {talk.videoUrl && (
                      <a href={talk.videoUrl} target="_blank" rel="noopener" class="btn-primary text-xs py-1.5 px-3">
                        ▶ Watch Hackathon Session Recording ↗
                      </a>
                    )}
                    {talk.codelabUrl && (
                      <a href={talk.codelabUrl} target="_blank" rel="noopener" class="btn-outline text-xs py-1.5 px-3">
                        Workshop Materials ↗
                      </a>
                    )}
                    <a href={talk.linkedinUrl} target="_blank" rel="noopener" class="text-xs font-(--font-mono) text-(--color-text-muted) hover:text-(--color-teal) flex items-center gap-1 transition-colors self-center">
                      LinkedIn Post ↗
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- ─── Communities ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-2 text-white">🌐 Active Community Memberships</h2>
        <p class="section-subtitle mb-6">Regular participant across 12+ Delhi NCR tech communities</p>
        
        <div class="glass-static p-6 rounded-2xl border border-(--color-border) bg-[#080E1E]/50">
          <div class="flex flex-wrap gap-2.5">
            {communities.map(c => (
              <span class="badge text-xs py-1.5 px-3">{c}</span>
            ))}
          </div>
        </div>
      </div>
      
      <!-- ─── Events Attended ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-2 text-white">📅 Tech Summits & Events Attended</h2>
        <p class="section-subtitle mb-6">25+ events in 2025–2026 across Delhi NCR and virtual ecosystems</p>
        
        <div class="glass-static p-4 sm:p-6 rounded-2xl border border-(--color-border) bg-[#080E1E]/50">
          <div class="divide-y divide-white/5 space-y-3">
            {eventsAttended.map(e => (
              <div class="pt-3 first:pt-0 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs">
                <div>
                  <span class="font-semibold text-white">{e.name}</span>
                  <span class="text-(--color-text-muted) font-(--font-mono) ml-2">({e.org})</span>
                  <div class="flex flex-wrap gap-1 mt-1">
                    {e.topics.map(t => (
                      <span class="text-[0.62rem] text-(--color-teal) font-mono bg-(--color-teal-glow) px-1.5 py-0.5 rounded">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="text-right sm:text-right shrink-0">
                  <span class="text-(--color-text-muted) font-(--font-mono) text-[11px]">{e.date}</span>
                  <span class="text-(--color-text-muted) text-[11px] block">{e.location}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="fade-in text-center py-6">
        <h3 class="font-(--font-heading) text-xl sm:text-2xl font-bold mb-3 text-white">
          Want Me to Speak at Your Event?
        </h3>
        <p class="text-(--color-text-secondary) text-sm mb-6 max-w-md mx-auto">
          I speak on Production GenAI, Agentic RAG, LLM orchestration, and developer career transitions.
        </p>
        <a href="/contact" class="btn-primary">
          Invite to Speak / Get in Touch
        </a>
      </div>
    </div>
  </section>
  
</BaseLayout>
