---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';

const speakingEngagements = [
  {
    id: 'ai-mobile-hackathon',
    title: 'AI Mobile Hackathon — Deep Dive Session on AI for Mobile Developers',
    event: 'AI Mobile Hackathon',
    organizer: 'Community (Anand Gaur)',
    date: '2026-06-16',
    location: 'Delhi NCR',
    role: 'Session Leader',
    audience: 'Mobile developers and AI enthusiasts',
    topics: [
      'Evolution of Intelligence: OpenAI history to Transformer architectures',
      'Attention mechanisms and token prediction',
      'Fine-tuning with Temperature, Top-P, Top-K parameters',
      'RAG implementation and prompt engineering',
      'Live demo: Training custom models with Teachable Machines',
    ],
    videoUrl: 'https://www.youtube.com/watch?v=-8xTRNfq-DE',
    embedUrl: 'https://www.youtube-nocookie.com/embed/-8xTRNfq-DE',
    codelabUrl: 'https://github.com/imaakanksha/AI-Unboxed-Teachable-Machine-Codelab',
    linkedinUrl: 'https://www.linkedin.com/feed/update/urn%3Ali%3Ashare%3A7472486822854451200',
    icon: '📹',
  },
  {
    id: 'incept-26',
    title: 'INCEPT\'26 — Industry Talk on AI, Career Growth & Software Engineering',
    event: 'INCEPT\'26',
    organizer: 'Google Developers Groups - GLA University, Mathura',
    date: '2026-04-28',
    location: 'GLA University, Mathura',
    role: 'Speaker',
    audience: '100+ engineering students',
    topics: [
      'Skills that matter in software engineering careers',
      'How AI is transforming app development',
      'Using AI tools for productivity, learning, and projects',
      'What companies expect from future-ready engineers',
      'Journey: College to corporate tech world',
    ],
    coSpeakers: ['Nitish Singh (Founder, CampusX)', 'Anand Gaur (Mobile Development)'],
    linkedinUrl: 'https://www.linkedin.com/feed/update/urn%3Ali%3AugcPost%3A7454719715660206081',
    icon: '🎤',
  },
];

const eventsAttended = [
  { name: 'Google Cloud Summit: Builder Connect India', date: 'Jun 10, 2026', org: 'Google Cloud', location: 'Yashobhoomi, Delhi', topics: ['Agentic AI', 'Enterprise Agent Platform', 'ADK'] },
  { name: 'Google Cloud Summit India', date: 'Jun 6, 2026', org: 'Google Cloud', location: 'Yashobhoomi', topics: ['Agentic AI', 'ADK', 'MCP', 'A2A'] },
  { name: 'Google Cloud Builder Day Delhi', date: 'May 26, 2026', org: 'Google for Developers', location: 'Delhi', topics: ['Agentic AI', 'Gemini', 'ADK deployment'] },
  { name: 'AI Day for Startups India', date: 'May 19, 2026', org: 'IHFC (IIT Delhi) + Google', location: 'Delhi', topics: ['Physical AI', 'Sovereign AI', 'MedGemma'] },
  { name: 'GitHub Copilot Community Days', date: 'May 12, 2026', org: 'AICamp', location: 'Virtual', topics: ['Context Engineering', 'RAG', '12-Factor Agents'] },
  { name: 'Data & GenAI Nexus 7.0', date: 'May 6, 2026', org: 'GDG Noida', location: 'Noida', topics: ['Event-Driven AI Agents', 'Neo4j Graph Eval'] },
  { name: 'Cloud/AI/Data Security — US Embassy Event', date: 'Apr 21, 2026', org: 'American Center + Microsoft UG', location: 'US Embassy, New Delhi', topics: ['Azure Cosmos DB', 'AI-Native', 'Agentic Apps'] },
  { name: 'SheLeadsAI Symposium', date: 'Apr 14, 2026', org: 'ShesSharp', location: 'REA Cyber City, Gurugram', topics: ['Women in AI', 'Agentic AI in Enterprise'] },
  { name: 'Experts Live India @ Microsoft Gurugram', date: 'Apr 2, 2026', org: 'Microsoft UG', location: 'Microsoft Office, Gurugram', topics: ['Microsoft Fabric', 'Agentic AI', 'AIOps'] },
  { name: 'India AI Impact Summit 2026', date: 'Feb 16, 2026', org: 'Government of India', location: 'Bharat Mandapam, New Delhi', topics: ['Physical AI', 'Sovereign AI', 'PARAM 2'] },
  { name: 'AWS User Group Delhi NCR', date: 'Feb 12, 2026', org: 'AWS UG NCR', location: 'Delhi NCR', topics: ['Amazon Bedrock', 'Kiro', 'Agentic Architecture'] },
  { name: 'Build Space 2.0 — ADK + RAG Workshop', date: 'Feb 6, 2026', org: 'Google / Community', location: 'Delhi NCR', topics: ['Google ADK', 'Cross-Encoders', 'HyDE'] },
  { name: 'Atlassian Community Event', date: 'Jan 13, 2026', org: 'Atlassian', location: 'Delhi NCR', topics: ['PRD Agent', 'Rovo', 'AI in Jira'] },
  { name: 'Data Leadership World Summit 1.0', date: 'Dec 31, 2025', org: 'Microsoft UG', location: 'Delhi NCR', topics: ['Agentic AI', 'Copilot', 'Data Leadership'] },
  { name: 'Google × Kaggle 5-Day AI Agents Intensive', date: 'Dec 20, 2025', org: 'Google + Kaggle', location: 'Virtual', topics: ['AI Agent Design', 'MCP', 'A2A', 'Evaluation'] },
  { name: 'DevFest Noida', date: 'Dec 7, 2025', org: 'GDG Noida', location: 'Noida', topics: ['Core Web Vitals', 'Hybrid AI Mobile Apps'] },
  { name: 'ServiceNow Developer Meetup', date: 'Nov 28, 2025', org: 'ServiceNow Delhi + Nagarro', location: 'Delhi NCR', topics: ['Workflow Data Fabric', 'AIOps'] },
  { name: 'Redis Released — Delhi Meetup', date: 'Nov 21, 2025', org: 'Redis Delhi', location: 'Delhi', topics: ['Redis LangCache', 'Vector Sets', 'AI-first caching'] },
  { name: 'Startup Mahakumbh', date: 'Apr 3, 2025', org: 'Government/Industry', location: 'New Delhi', topics: ['Startups', 'Innovation'] },
];

const communities = [
  'GDG Noida', 'GDG Cloud New Delhi', 'GDG Gurugram', 'AWS User Group Delhi NCR',
  'Microsoft UG: UP Power BI Club', 'Redis Delhi Community', 'ServiceNow Delhi',
  'GitHub India Community', 'Hack2skill Community', 'AICamp', 'Cloud Native Gurugram', 'IHFC (IIT Delhi)',
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const eventSchemas = speakingEngagements.map(talk => ({
  '@type': 'Event',
  'name': talk.title,
  'startDate': talk.date,
  'location': {
    '@type': 'Place',
    'name': talk.location,
  },
  'organizer': {
    '@type': 'Organization',
    'name': talk.organizer,
  },
  'performer': {
    '@id': 'https://akanksha.dev/#person'
  }
}));
---

<BaseLayout title="Speaking & Community — Akanksha | Production AI Engineer" description="Speaker at INCEPT'26 and AI Mobile Hackathon. Active across 12+ Delhi NCR AI communities with 25+ events attended. YouTube recordings available.">
  <StructuredData schema={eventSchemas} />
  
  <section class="relative overflow-hidden">
    <div class="orb orb-teal" style="top: -100px; right: -200px;"></div>
    <div class="orb orb-amber" style="bottom: 400px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="fade-in mb-12">
        <span class="badge mb-4">Community</span>
        <h1 class="font-(--font-heading) text-4xl md:text-5xl font-800 mb-4 tracking-tight">
          Speaking & <span class="gradient-text">Community</span>
        </h1>
        <p class="text-(--color-text-secondary) text-lg max-w-2xl">
          I believe in building in public and giving back. From speaking on stage to attending 
          25+ community events — learning, contributing, and connecting with the AI ecosystem.
        </p>
      </div>
      
      <!-- Stats Bar -->
      <div class="fade-in glass-static p-1.5 grid grid-cols-2 md:grid-cols-4 rounded-xl mb-16">
        <div class="metric">
          <div class="metric-value">2</div>
          <div class="metric-label">Speaker Talks</div>
        </div>
        <div class="metric">
          <div class="metric-value">25+</div>
          <div class="metric-label">Events Attended</div>
        </div>
        <div class="metric">
          <div class="metric-value">12+</div>
          <div class="metric-label">Communities</div>
        </div>
        <div class="metric">
          <div class="metric-value">8.8K</div>
          <div class="metric-label">LinkedIn Reactions</div>
        </div>
      </div>
      
      <!-- ─── Speaking Engagements ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-8">🎤 Speaking Engagements</h2>
        
        <div class="space-y-6">
          {speakingEngagements.map(talk => (
            <div class="glass p-6 md:p-8">
              <div class="flex items-start gap-4 mb-4">
                <span class="text-3xl">{talk.icon}</span>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="badge-amber badge text-[0.65rem]">{talk.role}</span>
                    <span class="text-(--color-text-muted) text-xs font-(--font-mono)">{formatDate(talk.date)}</span>
                    <span class="text-(--color-text-muted) text-xs">·</span>
                    <span class="text-(--color-text-muted) text-xs">{talk.location}</span>
                  </div>
                  <h3 class="font-(--font-heading) font-700 text-lg mb-1">{talk.title}</h3>
                  <p class="text-(--color-text-secondary) text-sm mb-1">{talk.event} — {talk.organizer}</p>
                  <p class="text-(--color-text-muted) text-xs">Audience: {talk.audience}</p>
                </div>
              </div>
              
              {talk.coSpeakers && (
                <div class="mb-4">
                  <p class="text-xs text-(--color-text-muted) font-(--font-mono) uppercase tracking-wider mb-1">Co-speakers</p>
                  <div class="flex flex-wrap gap-2">
                    {talk.coSpeakers.map(s => <span class="badge-ghost badge text-[0.65rem]">{s}</span>)}
                  </div>
                </div>
              )}
              
              <div class="mb-4">
                <p class="text-xs text-(--color-text-muted) font-(--font-mono) uppercase tracking-wider mb-2">Topics Covered</p>
                <ul class="space-y-1">
                  {talk.topics.map(t => (
                    <li class="flex items-start gap-2">
                      <span class="text-(--color-teal) mt-1 text-[0.5rem]">●</span>
                      <span class="text-(--color-text-secondary) text-sm">{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
              
              <div class="flex flex-wrap gap-3 pt-4 border-t border-(--color-border)">
                {talk.embedUrl && (
                  <button 
                    data-embed={talk.embedUrl} 
                    data-title={talk.title}
                    class="watch-talk-btn btn-primary text-xs py-2 px-4 cursor-pointer"
                  >
                    ▶ Watch Video Modal
                  </button>
                )}
                {talk.videoUrl && (
                  <a href={talk.videoUrl} target="_blank" rel="noopener" class="btn-outline text-xs py-2 px-4">
                    ↗ Open YouTube
                  </a>
                )}
                {talk.codelabUrl && (
                  <a href={talk.codelabUrl} target="_blank" rel="noopener" class="btn-outline text-xs py-2 px-4">
                    📂 View Codelab
                  </a>
                )}
                <a href={talk.linkedinUrl} target="_blank" rel="noopener" class="btn-outline text-xs py-2 px-4">
                  💼 LinkedIn Post
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- ─── Events Timeline ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-2">📅 Events Attended</h2>
        <p class="section-subtitle">{eventsAttended.length} events across 2025-2026</p>
        
        <div class="relative pl-10 space-y-4">
          <div class="timeline-line" style="left: 0.85rem;"></div>
          
          {eventsAttended.map((event, i) => (
            <div class="fade-in relative">
              <div class="timeline-dot" style={`top: 0.75rem; left: 0.35rem; width: 0.7rem; height: 0.7rem; ${i > 12 ? 'background: var(--color-text-muted); box-shadow: none;' : ''}`}></div>
              <div class="glass p-4">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-1 mb-2">
                  <h3 class="font-(--font-heading) font-600 text-sm">{event.name}</h3>
                  <span class="text-(--color-text-muted) text-xs font-(--font-mono) flex-shrink-0">{event.date}</span>
                </div>
                <p class="text-(--color-text-muted) text-xs mb-2">{event.org} · {event.location}</p>
                <div class="flex flex-wrap gap-1.5">
                  {event.topics.map(t => (
                    <span class="badge text-[0.55rem] py-0.5">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- ─── Communities ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">🌐 Community Memberships</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {communities.map(c => (
            <div class="glass p-3 text-center">
              <p class="text-(--color-text-secondary) text-sm font-500">{c}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- ─── LinkedIn Stats ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">📊 LinkedIn 2025 Wrap</h2>
        <div class="glass p-6 md:p-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="text-center">
              <p class="text-2xl font-800 font-(--font-heading) text-(--color-teal)">8,839</p>
              <p class="text-[0.65rem] text-(--color-text-muted) font-(--font-mono)">REACTIONS</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-800 font-(--font-heading) text-(--color-amber)">2,304</p>
              <p class="text-[0.65rem] text-(--color-text-muted) font-(--font-mono)">NEW CONNECTIONS</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-800 font-(--font-heading) text-(--color-teal)">334</p>
              <p class="text-[0.65rem] text-(--color-text-muted) font-(--font-mono)">DAYS ACTIVE</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-800 font-(--font-heading) text-(--color-amber)">Top 5%</p>
              <p class="text-[0.65rem] text-(--color-text-muted) font-(--font-mono)">OF ALL MEMBERS</p>
            </div>
          </div>
          <p class="text-(--color-text-muted) text-xs text-center mt-4 font-(--font-mono)">Source: LinkedIn Year-in-Review 2025</p>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="fade-in text-center">
        <p class="text-(--color-text-secondary) mb-4">Interested in having me speak at your event?</p>
        <a href="/contact" class="btn-primary">Get in Touch →</a>
      </div>
    </div>
  </section>

  <!-- Video Modal -->
  <dialog id="talk-video-modal" class="bg-transparent backdrop:bg-space/85 backdrop:backdrop-blur-md p-4 max-w-3xl w-full mx-auto my-auto rounded-2xl border border-(--color-border) text-(--color-text-primary) shadow-2xl">
    <div class="glass-static p-4 md:p-6 rounded-2xl relative">
      <button id="close-video-modal" class="absolute top-3 right-3 text-(--color-text-muted) hover:text-(--color-teal) transition-colors p-2 text-lg z-10">✕</button>
      <h3 id="video-modal-title" class="font-(--font-heading) text-base md:text-lg font-700 mb-3 pr-8">Talk Recording</h3>

      <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-space-light border border-(--color-border)">
        <iframe 
          id="talk-video-iframe" 
          src="" 
          title="Speaker Talk Video" 
          class="w-full h-full border-0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </dialog>

  <script>
    function initVideoModal() {
      const modal = document.getElementById('talk-video-modal') as HTMLDialogElement | null;
      const iframe = document.getElementById('talk-video-iframe') as HTMLIFrameElement | null;
      const titleEl = document.getElementById('video-modal-title');
      const closeBtn = document.getElementById('close-video-modal');
      const watchButtons = document.querySelectorAll('.watch-talk-btn');

      if (!modal || !iframe) return;

      watchButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const embedUrl = btn.getAttribute('data-embed');
          const title = btn.getAttribute('data-title');
          if (embedUrl) {
            iframe.src = `${embedUrl}?autoplay=1`;
            if (titleEl && title) titleEl.textContent = title;
            modal.showModal();
          }
        });
      });

      function stopAndClose() {
        if (iframe) iframe.src = '';
        if (modal) modal.close();
      }

      if (closeBtn) closeBtn.addEventListener('click', stopAndClose);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) stopAndClose();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
      initVideoModal();
    }
  </script>
</BaseLayout>
