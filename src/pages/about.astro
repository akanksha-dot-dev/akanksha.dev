---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = {
  'AI Agents & Orchestration': [
    'Google ADK', 'LangChain', 'LangGraph', 'CrewAI', 'MCP Protocol',
    'A2A Protocol', 'Multi-Agent Systems', 'Tool-Use Patterns',
  ],
  'RAG & Vector Search': [
    'Graph RAG', 'Agentic RAG', 'FAISS', 'Chroma', 'Pinecone',
    'Embeddings', 'Hybrid Search', 'RAGAS Evaluation',
  ],
  'LLMs & Fine-tuning': [
    'GPT-4', 'Llama-2/3', 'Mistral', 'BERT', 'Gemini',
    'PEFT/LoRA/QLoRA', 'Prompt Engineering', 'LangSmith',
  ],
  'NLP & ML': [
    'SpaCy', 'Transformers', 'Hugging Face', 'Scikit-Learn',
    'PyTorch', 'Text Analytics', 'Sentiment Analysis',
  ],
  'Backend & APIs': [
    'Python', 'FastAPI', 'Django', 'Flask', 'REST APIs', 'Pydantic',
    'SQL', 'PostgreSQL', 'MySQL', 'SQL Server',
  ],
  'Cloud & DevOps': [
    'AWS (Bedrock, Lambda, SageMaker, Transcribe)',
    'Azure (ML, Cognitive Services)',
    'Docker', 'Kubernetes', 'CI/CD', 'Git', 'GitHub Actions',
  ],
  'Tools & Platforms': [
    'VS Code', 'Jupyter', 'Postman', 'Selenium', 'PyTest',
    'Power BI', 'Jira', 'Confluence', 'o9 Solutions',
  ],
};

const highlights = [
  { icon: '🏆', text: '1st Runner-Up — PromptWars Noida (Hack2skill × Google for Developers, Jun 2026)' },
  { icon: '🎤', text: 'Speaker at INCEPT\'26 (GLA University) alongside CampusX founder Nitish Singh' },
  { icon: '📹', text: 'Session Leader at AI Mobile Hackathon — YouTube recording with live demo' },
  { icon: '☁️', text: 'Google Cloud Summit India 2026 — Builder Connect participant at Yashobhoomi' },
  { icon: '🇺🇸', text: 'Cloud/AI/Data Security event at US Embassy, New Delhi' },
  { icon: '🏛️', text: 'India AI Impact Summit at Bharat Mandapam (Government of India)' },
  { icon: '👩‍💻', text: 'SheLeadsAI Symposium — Women in AI, Agentic AI in Enterprise' },
  { icon: '📚', text: '300+ certifications across Coursera, LinkedIn Learning, Anthropic, ISRO, Udacity' },
  { icon: '⭐', text: 'NPTEL Star, Domain Scholar & Discipline Star (2021-2022)' },
  { icon: '🌐', text: 'Active member of 12+ Delhi NCR AI communities (GDG, AWS UG, Microsoft UG)' },
  { icon: '📊', text: 'LinkedIn Top 5% member — 8,839 reactions, 2,304 new connections in 2025' },
  { icon: '🥇', text: '1st Place TEQIP-III Hackathon (2019) + MIT COVID-19 Challenge Team Lead (2020)' },
];
---

<BaseLayout title="About — Akanksha | Production AI Engineer" description="From Electrical Engineering in Darbhanga to Production AI Engineer at Samsung SDS. 4+ years, 300+ certifications, national hackathon wins, and 25+ tech events.">
  
  <section class="relative overflow-hidden">
    <div class="orb orb-teal" style="top: -100px; right: -200px;"></div>
    <div class="orb orb-amber" style="bottom: 200px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-6 py-16">
      <!-- Header -->
      <div class="fade-in mb-12">
        <span class="badge mb-4">About Me</span>
        <h1 class="font-(--font-heading) text-4xl md:text-5xl font-800 mb-4 tracking-tight">
          From <span class="gradient-text">Darbhanga</span> to <span class="gradient-text">Samsung SDS</span>
        </h1>
        <p class="text-(--color-text-secondary) text-lg">
          An unconventional path — EEE student who taught herself to code through hackathons, 
          earned 300+ certifications, won national competitions, and now builds production AI at enterprise scale.
        </p>
      </div>
      
      <!-- Main Story -->
      <div class="fade-in mb-16">
        <div class="glass p-8 md:p-10 space-y-5 text-(--color-text-secondary) leading-relaxed">
          <p>
            I build production AI systems that enterprises actually rely on — not just proof-of-concepts 
            that impress in demos.
          </p>
          
          <p>
            As a <span class="text-(--color-text-primary) font-semibold">Production AI Engineer at Samsung SDS</span>, 
            I architect the full GenAI stack: autonomous AI agents using Google ADK for content generation 
            and QA automation (<span class="text-(--color-teal)">60% reduction in manual effort</span>), 
            enterprise Graph RAG pipelines processing annual reports with advanced PDF extraction, and LLM 
            infrastructure serving <span class="text-(--color-teal)">500+ daily queries at 92% accuracy</span>. 
            I lead a team of 3 developers and collaborate across India & Korea teams.
          </p>
          
          <p>
            Before Samsung SDS, I spent 2 years at <span class="text-(--color-text-primary) font-semibold">HCLTech</span> 
            shipping ML to production — profile matching, CV parsing, smart search — for enterprise recruitment 
            platforms. I deployed ML models for 10+ features, resolved 
            <span class="text-(--color-amber)">500+ production incidents</span>, and maintained 
            <span class="text-(--color-teal)">98% service reliability</span>. I started as a Graduate Engineer 
            Trainee and was promoted to Software Engineer within my first year.
          </p>
          
          <p>
            My journey is unconventional: I studied <span class="text-(--color-text-primary) font-semibold">Electrical & Electronics Engineering</span> 
            at Darbhanga College of Engineering, Bihar. I taught myself to code through hackathons — winning 
            1st place at TEQIP-III (2019), leading MIT COVID-19 Challenge teams (2020), and getting shortlisted 
            for AICTE Vishwakarma Awards. In 2026, I was 1st Runner-Up at PromptWars Noida (Hack2skill × Google 
            for Developers).
          </p>
          
          <p>
            I've earned <span class="text-(--color-amber) font-semibold">300+ certifications</span> across 
            Coursera (150+), LinkedIn Learning (89), Skillsoft (40+), plus flagship certs from Udacity, Anthropic, 
            ISRO, IIT Kanpur, and Cisco. I'm an NPTEL Star, Domain Scholar, and Discipline Star.
          </p>

          <p>
            Beyond building, I <span class="text-(--color-teal)">speak at tech events</span> (INCEPT'26 alongside 
            CampusX founder Nitish Singh, AI Mobile Hackathon with YouTube recording), attend 25+ community events 
            yearly (Google Cloud Summit, India AI Impact Summit at Bharat Mandapam, US Embassy tech event), and am 
            active across <span class="text-(--color-teal)">12+ Delhi NCR AI communities</span> including GDG, 
            AWS UG, and Microsoft UG.
          </p>
          
          <blockquote class="border-l-2 border-(--color-teal) pl-4 mt-6">
            <p class="text-(--color-text-primary) italic font-(--font-heading) font-500 text-lg">
              "I care about AI that ships, not just AI that demos."
            </p>
          </blockquote>
        </div>
      </div>
      
      <!-- Highlights -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">Highlights & Milestones</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 stagger">
          {highlights.map(h => (
            <div class="glass p-4 flex items-start gap-3 fade-in">
              <span class="text-xl flex-shrink-0">{h.icon}</span>
              <p class="text-(--color-text-secondary) text-sm leading-relaxed">{h.text}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Tech Stack -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">Tech Arsenal</h2>
        <div class="space-y-6">
          {Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="font-(--font-heading) font-600 text-xs uppercase tracking-wider text-(--color-teal) mb-2">{category}</h3>
              <div class="flex flex-wrap gap-1.5">
                {items.map(skill => (
                  <span class="badge text-[0.65rem]">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Journey Timeline -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">The Journey</h2>
        <div class="glass p-6 md:p-8 font-(--font-mono) text-sm text-(--color-text-secondary) space-y-1.5 leading-relaxed">
          <p><span class="text-(--color-text-muted)">📍</span> <span class="text-(--color-text-primary)">Darbhanga, Bihar</span></p>
          <p class="text-(--color-text-muted) pl-5">↓  EEE student who taught herself to code through hackathons</p>
          <p class="text-(--color-text-muted) pl-5">↓  Won TEQIP-III (1st), led MIT COVID-19 teams, AICTE regionals</p>
          <p class="text-(--color-text-muted) pl-5">↓  DCA at 16, started 300+ certification marathon</p>
          <p class="text-(--color-text-muted) pl-5">↓</p>
          <p><span class="text-(--color-text-muted)">💼</span> <span class="text-(--color-text-primary)">HCLTech, Noida</span> <span class="text-(--color-teal)">(Sep 2022–Sep 2024)</span></p>
          <p class="text-(--color-text-muted) pl-5">↓  GET → Software Engineer (promoted in 1 year)</p>
          <p class="text-(--color-text-muted) pl-5">↓  10+ ML features shipped, 500+ incidents resolved, 98% reliability</p>
          <p class="text-(--color-text-muted) pl-5">↓</p>
          <p><span class="text-(--color-text-muted)">🚀</span> <span class="text-(--color-text-primary)">Samsung SDS, Gurugram</span> <span class="text-(--color-teal)">(Oct 2024–Present)</span></p>
          <p class="text-(--color-text-muted) pl-5">↓  Google ADK agents, Graph RAG, LLM infrastructure</p>
          <p class="text-(--color-text-muted) pl-5">↓  Leading team of 3, India-Korea cross-border collaboration</p>
          <p class="text-(--color-text-muted) pl-5">↓  Speaker at INCEPT'26, 1st Runner-Up PromptWars</p>
          <p class="text-(--color-text-muted) pl-5">↓</p>
          <p><span class="text-(--color-text-muted)">🎯</span> <span class="text-(--color-amber) font-600">Next: Senior/Staff AI Engineer at a top-tier AI company</span></p>
        </div>
      </div>
      
      <!-- Philosophy -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-6">My Philosophy</h2>
        <div class="glass p-6 md:p-8">
          <p class="text-(--color-text-secondary) leading-relaxed mb-4">
            I believe success is only 20% education. The remaining 80% depends on communication, 
            networking, negotiation, branding, adaptability, and decision-making.
          </p>
          <p class="text-(--color-text-secondary) leading-relaxed">
            That's why I invest equally in building real systems, growing community presence, 
            speaking at events, and creating genuine connections. Engineering is the foundation, 
            but impact comes from everything else.
          </p>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="fade-in text-center">
        <a href="/contact" class="btn-primary">Let's Connect →</a>
      </div>
    </div>
  </section>
</BaseLayout>
