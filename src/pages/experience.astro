---

<BaseLayout title="Experience & System Changelog — Akanksha | Production AI Engineer" description="Professional journey & execution trace: Samsung SDS (Production AI Engineer) → HCLTech (Software Engineer). 4+ years shipping enterprise AI, 300+ certifications, 6 hackathon awards.">
  
  <section class="relative overflow-hidden" aria-label="Experience System Changelog">
    <div class="orb orb-teal" style="top: 200px; right: -200px;"></div>
    <div class="orb orb-amber" style="bottom: 400px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="fade-in mb-10">
        <span class="badge mb-4">v.Latest Release</span>
        <h1 class="font-(--font-heading) text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
          System <span class="gradient-text">Changelog</span>
        </h1>
        <p class="text-(--color-text-secondary) font-(--font-mono) text-xs sm:text-sm">
          &gt; Execution trace: Release history of roles, enterprise deployments, and architectural milestones.
        </p>
      </div>
      
      <!-- ─── Timeline ─── -->
      <div class="relative pl-6 sm:pl-10 md:pl-12 space-y-10 mb-20 border-l border-(--color-border) ml-2 sm:ml-4">
        {experience.map((exp) => (
          <div class="fade-in relative">
            <div class="absolute -left-[2.15rem] sm:-left-[3.15rem] md:-left-[3.65rem] top-6 w-3.5 sm:w-4 h-3.5 sm:h-4 rounded-full border-2 border-(--color-space) z-10" style={`background: ${exp.color === 'teal' ? 'var(--color-teal)' : exp.color === 'amber' ? 'var(--color-amber)' : 'var(--color-text-muted)'}; box-shadow: 0 0 12px ${exp.color === 'teal' ? 'rgba(0,229,176,0.6)' : exp.color === 'amber' ? 'rgba(245,163,0,0.6)' : 'transparent'};`}></div>
            
            <div class="glass p-5 sm:p-7 border border-(--color-border) hover:border-(--color-teal)/50 transition-colors">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-5 pb-4 border-b border-(--color-border)/50">
                <div>
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                     <span class="text-xs font-(--font-mono) px-2 py-0.5 rounded bg-(--color-space) border border-(--color-border)" style={`color: ${exp.color === 'teal' ? 'var(--color-teal)' : exp.color === 'amber' ? 'var(--color-amber)' : 'var(--color-text-muted)'}`}>release-{exp.period.split(' – ')[0].toLowerCase().replace(' ', '')}</span>
                     <span class="text-[11px] text-(--color-text-muted) font-(--font-mono)">commit: {exp.commitHash}</span>
                     <span class="badge-ghost badge text-[0.6rem]">{exp.roleTag}</span>
                  </div>
                  <h2 class="font-(--font-heading) font-bold text-base sm:text-lg text-(--color-text-primary)">{exp.title} <span class="text-(--color-text-muted) font-normal">@ {exp.company}</span></h2>
                  <p class="text-(--color-text-muted) text-xs font-(--font-mono) mt-0.5">{exp.subtitle}</p>
                </div>
                <div class="md:text-right flex-shrink-0">
                  <p class="font-(--font-mono) text-xs text-(--color-teal) font-semibold">{exp.period}</p>
                  <p class="text-(--color-text-muted) text-[0.65rem] font-(--font-mono) uppercase tracking-wider mt-0.5">{exp.location}</p>
                </div>
              </div>
              
              <div class="space-y-5">
                {exp.projects.map(project => (
                  <div>
                    <p class="text-(--color-text-primary) text-xs font-semibold mb-2 font-(--font-mono) flex items-center gap-2">
                      <svg class="w-3.5 h-3.5 text-(--color-teal)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                      <span>[module] {project.name}</span>
                    </p>
                    <ul class="space-y-1.5 pl-4">
                      {project.bullets.map(b => (
                        <li class="flex items-start gap-2 font-(--font-mono) text-xs text-(--color-text-secondary) leading-relaxed">
                          <span class="text-(--color-teal) mt-0.5 text-[0.65rem] opacity-80">+</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              
              <div class="flex flex-wrap gap-1.5 pt-4 mt-5 border-t border-(--color-border)/50">
                {exp.tech.map(t => (
                  <span class="badge text-[0.62rem] bg-space-light/40">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- ─── Awards & Hackathons ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-5">🏆 Hackathon Awards & Recognitions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {awards.map(a => (
            <div class="glass p-4 flex items-center gap-3.5">
              <span class="text-2xl p-2 rounded-xl bg-space-light/50 border border-(--color-border)">{a.icon}</span>
              <div class="flex-1">
                <p class="text-(--color-text-primary) text-xs sm:text-sm font-semibold">{a.title}</p>
                <p class="text-(--color-text-muted) text-[11px] font-(--font-mono)">{a.org} · {a.year}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- ─── Certifications ─── -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-2">📜 Continuous Learning & Certifications</h2>
        <p class="section-subtitle mb-6">300+ credentials verified across 8+ global learning platforms</p>
        
        <h3 class="text-xs font-(--font-mono) text-(--color-teal) uppercase tracking-wider mb-3 font-semibold">Flagship & Specialization Credentials</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-6">
          {certifications.filter(c => c.tier === 'flagship').map(cert => (
            <div class="glass p-4 flex items-center gap-3.5">
              <span class="text-2xl p-2 rounded-xl bg-space-light/50 border border-(--color-border)">{cert.icon}</span>
              <div>
                <p class="text-(--color-text-primary) text-xs sm:text-sm font-semibold">{cert.name}</p>
                <p class="text-(--color-text-muted) text-[11px]">{cert.org}</p>
              </div>
            </div>
          ))}
        </div>

        <h3 class="text-xs font-(--font-mono) text-(--color-amber) uppercase tracking-wider mb-3 font-semibold">Platform & Academic Milestones</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {certifications.filter(c => c.tier !== 'flagship').map(cert => (
            <div class="glass p-4 flex items-center gap-3.5">
              <span class="text-2xl p-2 rounded-xl bg-space-light/50 border border-(--color-border)">{cert.icon}</span>
              <div>
                <p class="text-(--color-text-primary) text-xs sm:text-sm font-semibold">{cert.name}</p>
                <p class="text-(--color-text-muted) text-[11px]">{cert.org}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="fade-in text-center pt-4">
        <a href="/contact" class="btn-primary">
          Discuss Senior AI Roles & Opportunities →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
