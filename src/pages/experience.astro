---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    id: 'samsung-sds',
    company: 'Samsung SDS',
    title: 'Production AI Engineer',
    subtitle: 'Senior Executive Engineer',
    period: 'Oct 2024 – Present',
    location: 'Gurugram, India',
    color: 'teal',
    roleTag: 'Current Role',
    projects: [
      {
        name: 'Agentic AI Content Generation & Evaluation',
        bullets: [
          'Architect autonomous AI agents using Google ADK for enterprise content generation and QA automation — 60% reduction in manual effort',
          'Lead developer squad of 3 engineers on GenAI projects, mentoring on RAG architecture, prompt safety, and RAGAS evaluation guidelines',
          'Collaborate across India & Korea teams on enterprise AI solution delivery with zero SLA regressions',
        ],
      },
      {
        name: 'Graph RAG for Financial Services',
        bullets: [
          'Built end-to-end Graph RAG pipeline processing annual financial reports with advanced PDF extraction (GMFT, Partition PDF)',
          'Achieved 92% retrieval accuracy on 500+ daily queries with 40% improvement in document retrieval over standard vector baselines',
          'Deployed GPT-4 and Llama-3 with token-optimized divide-and-conquer strategies',
        ],
      },
      {
        name: 'Agentic RAG Chatbot & Automated Reporting',
        bullets: [
          'Implemented Agentic RAG chatbot with SMTP integration for automated email reporting workflows',
          'Designed vector DB architecture using FAISS & Chroma for efficient LLM context retrieval and sub-second latency',
        ],
      },
      {
        name: 'QA Automation & Productivity Analyzer',
        bullets: [
          'Built QA Automation Engine with structured JSON schema comparison across o9 platform tenants',
          'Developed RAG-based productivity analyzer processing JIRA stories and Confluence documents for weekly engineering insights',
        ],
      },
    ],
    tech: ['Google ADK', 'LangGraph', 'Graph RAG', 'FastAPI', 'GPT-4', 'Llama-3', 'FAISS', 'Chroma', 'Docker', 'Neo4j'],
  },
  {
    id: 'hcltech-se',
    company: 'HCLTech',
    title: 'Software Engineer',
    subtitle: 'iTAP & Edge Platform Team',
    period: 'Sep 2023 – Sep 2024',
    location: 'Noida, India',
    color: 'amber',
    roleTag: 'Full-Time Promotion',
    projects: [
      {
        name: 'iTAP & Edge — Enterprise Recruitment Platform',
        bullets: [
          'Deployed ML algorithms for 10+ features: CV parsing, profile matching, content tagging, smart search — 95% user satisfaction',
          'Resolved 500+ production incidents, achieving 30% reduction in system downtime across enterprise deployments',
          'Deployed web services on AWS & Azure, maintaining 98% service reliability',
          'Built automated Power BI dashboards for scheduler monitoring across 3+ applications',
          'Implemented Text Analytics and NLP pipelines for intelligent job recommendations',
        ],
      },
    ],
    tech: ['Python', 'Django', 'SQL Server', 'Azure', 'AWS', 'Power BI', 'NLP', 'Machine Learning'],
  },
  {
    id: 'hcltech-get',
    company: 'HCLTech',
    title: 'Graduate Engineer Trainee',
    subtitle: 'Training & Foundation Phase',
    period: 'Sep 2022 – Sep 2023',
    location: 'Noida, India',
    color: 'amber',
    roleTag: 'Engineering Foundation',
    projects: [
      {
        name: 'Technical Training & First Full-Stack Projects',
        bullets: [
          'Completed 70+ hours technical training in Python, SQL, C#, Golang, ASP.NET MVC',
          'Built full-stack web applications during training phase with unit test suites',
          'Promoted to Software Engineer within first year based on high delivery velocity',
        ],
      },
    ],
    tech: ['Python', 'C#', 'Golang', 'SQL', 'ASP.NET', 'Git'],
  },
  {
    id: 'collegedunia',
    company: 'Collegedunia',
    title: 'Technical & SEO Content Writer',
    subtitle: 'Concurrent Writing & Research',
    period: 'May 2021 – Mar 2024',
    location: 'Remote',
    color: 'muted',
    roleTag: 'Content & Research',
    projects: [
      {
        name: 'SEO Content & Technical Writing',
        bullets: [
          'Authored high-ranking SEO content, technical guides, and educational articles',
          'Built discipline in clear communication, structured documentation, and content delivery',
        ],
      },
    ],
    tech: ['SEO Strategy', 'Technical Writing', 'Data Analysis'],
  },
  {
    id: 'trtc',
    company: 'TRTC Patna',
    title: 'Engineering Intern',
    subtitle: 'Hardware & Networking',
    period: 'Feb 2020 – May 2021',
    location: 'Patna, Bihar',
    color: 'muted',
    roleTag: 'Hardware Roots',
    projects: [
      {
        name: 'Telecom Infrastructure & Embedded Systems',
        bullets: [
          'Hands-on training in telecom infrastructure, networking switches, and hardware systems',
          'Foundation experience that built systematic problem-solving skills and low-level understanding',
        ],
      },
    ],
    tech: ['Networking', 'Hardware', 'Telecom Protocols'],
  },
];

const certifications = [
  { name: 'AI Programming with Python Nanodegree', org: 'Udacity', icon: '🧠', tier: 'flagship' },
  { name: '5-Day AI Agents Intensive', org: 'Google × Kaggle', icon: '🤖', tier: 'flagship' },
  { name: 'Claude Code + MCP (5 certs)', org: 'Anthropic', icon: '🔗', tier: 'flagship' },
  { name: 'Full Stack Development', org: 'ICT Academy, IIT Kanpur', icon: '🎓', tier: 'flagship' },
  { name: 'Remote Sensing (3 certs)', org: 'ISRO/IIRS', icon: '🛰️', tier: 'flagship' },
  { name: '150+ Coursera Certifications', org: 'Coursera (Google, IBM, Meta, etc.)', icon: '📜', tier: 'platform' },
  { name: '89 LinkedIn Learning Courses', org: 'LinkedIn Learning', icon: '💼', tier: 'platform' },
  { name: '40+ Skillsoft Badges', org: 'Skillsoft / HCLTech', icon: '🏅', tier: 'platform' },
  { name: 'Cisco Certifications', org: 'Cisco Networking Academy', icon: '🌐', tier: 'platform' },
  { name: 'NPTEL Star + Domain Scholar', org: 'NPTEL (IIT/IISC)', icon: '⭐', tier: 'academic' },
];
---

<BaseLayout title="Experience & Impact — Akanksha | Production AI Engineer" description="Professional engineering experience: Production AI Engineer at Samsung SDS (Graph RAG, Google ADK agents) and Software Engineer at HCLTech (ML systems, 500+ production incidents resolved).">
  
  <section class="relative overflow-hidden" aria-label="Professional Experience">
    <div class="orb orb-teal" style="top: -100px; right: -200px;"></div>
    <div class="orb orb-amber" style="bottom: 300px; left: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="fade-in mb-12">
        <span class="badge mb-4">Production Track Record</span>
        <h1 class="font-(--font-heading) text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-white">
          Experience & <span class="gradient-text">Impact</span>
        </h1>
        <p class="text-(--color-text-secondary) text-base sm:text-lg max-w-2xl leading-relaxed">
          From self-taught programmer to leading enterprise GenAI squads at Samsung SDS. 
          4+ years of shipping machine learning, Agentic RAG, and high-reliability systems in production.
        </p>
      </div>
      
      <!-- Experience Timeline -->
      <div class="relative pl-8 sm:pl-10 space-y-12 mb-20">
        <div class="timeline-line"></div>
        
        {experience.map(role => (
          <div class="relative fade-in" id={role.id}>
            <!-- Dot -->
            <div class="timeline-dot" style={`top: 1.75rem; ${role.color === 'amber' ? 'background: var(--color-amber); box-shadow: 0 0 16px rgba(245, 163, 0, 0.5);' : role.color === 'muted' ? 'background: #94A3B8; box-shadow: none;' : ''}`}></div>
            
            <!-- Card -->
            <div class="glass p-6 sm:p-8">
              <!-- Role Header -->
              <div class="flex flex-wrap items-start justify-between gap-2 mb-4 pb-4 border-b border-(--color-border)">
                <div>
                  <div class="flex items-center gap-2 flex-wrap mb-1">
                    <h2 class="font-(--font-heading) text-xl sm:text-2xl font-extrabold text-white">
                      {role.company}
                    </h2>
                    <span class:list={[
                      role.color === 'teal' ? 'badge' : role.color === 'amber' ? 'badge-amber badge' : 'badge-ghost badge',
                      'text-xs'
                    ]}>
                      {role.roleTag}
                    </span>
                  </div>
                  <p class="text-(--color-teal) font-semibold text-sm sm:text-base">
                    {role.title}
                  </p>
                  <p class="text-(--color-text-muted) text-xs">
                    {role.subtitle} · {role.location}
                  </p>
                </div>
                
                <span class="text-xs font-(--font-mono) text-(--color-text-secondary) bg-[#080E1E] px-3 py-1.5 rounded-lg border border-(--color-border)">
                  {role.period}
                </span>
              </div>
              
              <!-- Projects within role -->
              <div class="space-y-5">
                {role.projects.map(p => (
                  <div>
                    <h3 class="font-(--font-heading) font-bold text-sm sm:text-base text-white mb-2 flex items-center gap-2">
                      <span class="text-(--color-teal) text-xs">▸</span>
                      <span>{p.name}</span>
                    </h3>
                    <ul class="space-y-2 text-xs sm:text-sm text-(--color-text-secondary) leading-relaxed">
                      {p.bullets.map(b => (
                        <li class="flex items-start gap-2">
                          <span class="text-(--color-teal) text-xs mt-1 shrink-0">•</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              
              <!-- Tech Stack Tags -->
              <div class="flex flex-wrap gap-1.5 mt-5 pt-4 border-t border-(--color-border)">
                {role.tech.map(t => (
                  <span class="badge text-[0.65rem] py-0.5">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- ─── Certifications Section ─── -->
      <div class="fade-in mb-16">
        <div class="mb-8">
          <span class="badge mb-3">Continuous Mastery</span>
          <h2 class="font-(--font-heading) text-2xl sm:text-3xl font-extrabold text-white">
            300+ Verified <span class="gradient-text">Credentials</span>
          </h2>
          <p class="text-(--color-text-secondary) text-sm mt-1">
            Flagship nanodegrees, AI intensive programs, vendor certifications, and academic honors.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {certifications.map(cert => (
            <div class="glass-static p-3.5 sm:p-4 flex items-center gap-3.5 border border-(--color-border) bg-[#080E1E]/60 rounded-xl">
              <span class="text-2xl p-2 rounded-lg bg-white/5 border border-white/5">{cert.icon}</span>
              <div>
                <h3 class="font-(--font-heading) font-semibold text-xs sm:text-sm text-white">{cert.name}</h3>
                <p class="text-[11px] text-(--color-text-muted) font-(--font-mono)">{cert.org}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- CTA -->
      <div class="fade-in text-center py-8">
        <h3 class="font-(--font-heading) text-xl sm:text-2xl font-bold mb-3 text-white">
          Looking for a Senior/Staff AI Engineer?
        </h3>
        <p class="text-(--color-text-secondary) text-sm mb-6 max-w-md mx-auto">
          I'm open to production AI engineering opportunities in India, remote, and global teams.
        </p>
        <div class="flex flex-wrap gap-3.5 justify-center">
          <a href="/contact" class="btn-primary">
            Get in Touch / View Availability
          </a>
          <a href="/projects" class="btn-outline">
            View All Projects
          </a>
        </div>
      </div>
    </div>
  </section>
  
</BaseLayout>
