---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    company: 'Samsung SDS',
    title: 'Production AI Engineer',
    subtitle: 'Senior Executive Engineer',
    period: 'Oct 2024 – Present',
    location: 'Gurugram, India',
    color: 'teal',
    bullets: [
      { icon: '🤖', text: 'Architect autonomous AI agents using Google ADK for content generation and QA automation — 60% reduction in manual effort' },
      { icon: '🔍', text: 'Built end-to-end RAG pipeline for financial document processing with Graph RAG, achieving 92% accuracy on 500+ daily queries' },
      { icon: '🧠', text: 'Deploy and optimize LLM infrastructure (GPT-4, Llama, Mistral) with token-optimized divide-and-conquer strategies' },
      { icon: '👥', text: 'Lead team of 3 developers, collaborate across India & Korea teams at enterprise scale' },
      { icon: '🏗️', text: 'Developed QPORT Card System using Agentic AI for automated quality reporting across Samsung manufacturing' },
    ],
    tech: ['Google ADK', 'LangGraph', 'Graph RAG', 'FastAPI', 'GPT-4', 'Docker'],
  },
  {
    company: 'HCLTech',
    title: 'Software Engineer',
    subtitle: 'iTAP Platform Team',
    period: 'Sep 2022 – Sep 2024',
    location: 'Noida, India',
    color: 'amber',
    bullets: [
      { icon: '🤖', text: 'Deployed ML algorithms for 10+ features: CV parsing, profile matching, content tagging, smart search' },
      { icon: '🛠️', text: 'Resolved 500+ production incidents, achieving 30% reduction in system downtime' },
      { icon: '☁️', text: 'Deployed web services on AWS & Azure, maintaining 98% service reliability' },
      { icon: '📈', text: 'Built automated dashboards using Power BI for scheduler monitoring across 3+ applications' },
      { icon: '🏆', text: 'Promoted from Graduate Engineer Trainee to Software Engineer within first year' },
    ],
    tech: ['Python', 'Django', 'SQL Server', 'Azure', 'AWS', 'Power BI'],
  },
  {
    company: 'Collegedunia',
    title: 'Freelance Content Writer',
    subtitle: 'Concurrent with primary roles',
    period: 'May 2021 – Mar 2024',
    location: 'Remote',
    color: 'teal',
    bullets: [
      { icon: '✍️', text: 'SEO content writing, proofreading, and editing for education platform' },
      { icon: '📊', text: 'Built discipline in professional delivery while maintaining full-time engineering career' },
    ],
    tech: ['SEO', 'Content Strategy', 'Technical Writing'],
  },
];

const certifications = [
  { name: 'AI Programming with Python', org: 'Udacity', icon: '🧠' },
  { name: '5-Day AI Agents Intensive', org: 'Google × Kaggle', icon: '🤖' },
  { name: 'Claude Code + MCP (5 certs)', org: 'Anthropic', icon: '🔗' },
  { name: 'Full Stack Development', org: 'IIT Kanpur', icon: '🎓' },
  { name: 'Remote Sensing (3 certs)', org: 'ISRO/IIRS', icon: '🛰️' },
  { name: '150+ Coursera Certifications', org: 'Coursera', icon: '📜' },
  { name: '89 LinkedIn Learning Courses', org: 'LinkedIn', icon: '💼' },
  { name: '40+ Skillsoft Badges', org: 'Skillsoft', icon: '🏅' },
];

const awards = [
  { title: '1st Runner-Up — PromptWars Noida', org: 'Hack2skill × Google for Developers', year: '2026' },
  { title: '1st Place — AI & ML Training', org: 'EdgeFX × DCE', year: '2021' },
  { title: '1st Place — TEQIP-III Hackathon', org: 'Emerging Technologies', year: '2019' },
  { title: '2nd Place — SPIU Bihar STEM', org: 'Robotics Hackathon', year: '2020' },
];
---

<BaseLayout title="Experience — Akanksha | Production AI Engineer" description="Professional journey: Samsung SDS (Production AI Engineer) → HCLTech (Software Engineer). 4+ years shipping AI to production with 300+ certifications.">
  
  <section class="relative overflow-hidden">
    <div class="orb orb-teal" style="top: 200px; right: -200px;"></div>
    
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="fade-in mb-12">
        <span class="badge mb-4">Career</span>
        <h1 class="font-(--font-heading) text-4xl md:text-5xl font-800 mb-4">
          Professional <span class="gradient-text">Journey</span>
        </h1>
        <p class="text-(--color-text-secondary) text-lg">
          From resolving production incidents to architecting autonomous AI agents.
        </p>
      </div>
      
      <!-- Timeline -->
      <div class="relative pl-12 space-y-12 mb-20">
        <div class="timeline-line"></div>
        
        {experience.map((exp, i) => (
          <div class="fade-in relative">
            <div class="timeline-dot" style={`top: 1.5rem; ${exp.color === 'amber' ? 'background: var(--color-amber); box-shadow: 0 0 12px rgba(245, 163, 0, 0.4);' : ''}`}></div>
            
            <div class="glass p-6 md:p-8">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
                <div>
                  <h3 class="font-(--font-heading) font-700 text-xl text-(--color-text-primary)">{exp.title}</h3>
                  <p class="text-(--color-teal) font-semibold">{exp.company}</p>
                  <p class="text-(--color-text-muted) text-sm">{exp.subtitle}</p>
                </div>
                <div class="text-right">
                  <p class="font-(--font-mono) text-sm text-(--color-text-secondary)">{exp.period}</p>
                  <p class="text-(--color-text-muted) text-sm">{exp.location}</p>
                </div>
              </div>
              
              <ul class="space-y-3 mb-4">
                {exp.bullets.map(b => (
                  <li class="flex items-start gap-3">
                    <span class="text-lg flex-shrink-0 mt-0.5">{b.icon}</span>
                    <span class="text-(--color-text-secondary) text-sm leading-relaxed">{b.text}</span>
                  </li>
                ))}
              </ul>
              
              <div class="flex flex-wrap gap-2 pt-4 border-t border-(--color-border)">
                {exp.tech.map(t => (
                  <span class="badge text-[0.65rem]">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Awards -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-8">🏆 Awards & Hackathons</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {awards.map(a => (
            <div class="glass p-4 flex items-center gap-4">
              <span class="text-2xl">🏅</span>
              <div>
                <p class="text-(--color-text-primary) text-sm font-semibold">{a.title}</p>
                <p class="text-(--color-text-muted) text-xs">{a.org} · {a.year}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Certifications -->
      <div class="fade-in mb-16">
        <h2 class="section-title mb-2">📜 Certifications</h2>
        <p class="section-subtitle">300+ across 8+ learning platforms</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {certifications.map(cert => (
            <div class="glass p-4 flex items-center gap-4">
              <span class="text-2xl">{cert.icon}</span>
              <div>
                <p class="text-(--color-text-primary) text-sm font-semibold">{cert.name}</p>
                <p class="text-(--color-text-muted) text-xs">{cert.org}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Education -->
      <div class="fade-in">
        <h2 class="section-title mb-8">🎓 Education</h2>
        <div class="glass p-6">
          <div class="flex items-start gap-4">
            <span class="text-3xl">🏛️</span>
            <div>
              <h3 class="font-(--font-heading) font-700 text-lg">B.Tech in Electrical & Electronics Engineering</h3>
              <p class="text-(--color-teal)">Darbhanga College of Engineering</p>
              <p class="text-(--color-text-muted) text-sm">Aryabhatta Knowledge University · 2018–2022 · 8.8 CGPA</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
