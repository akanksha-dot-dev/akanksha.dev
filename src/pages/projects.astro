---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  // ─── Flagship: Agentic AI ───
  {
    id: 'agentic-ai-workshop',
    title: 'AgenticAI Workshop',
    description: 'Multi-agent AI orchestration framework with Google ADK, MCP protocol integration, tool-use patterns & autonomous workflows. Includes hands-on workshop materials used at INCEPT\'26.',
    tags: ['Google ADK', 'LangChain', 'Agentic AI', 'MCP', 'Python'],
    href: 'https://github.com/akanksha-dot-dev/AgenticAI-Workshop',
    icon: '🤖',
    category: 'Agentic AI',
    impact: 'Speaker workshop materials at INCEPT\'26',
    status: 'In Production',
    statusBadge: 'badge',
    hasCaseStudy: true,
    caseStudy: {
      problem: 'Enterprise content creation and QA automation workflows required extensive manual oversight, resulting in bottlenecked deployment cycles and unpredictable output quality.',
      naiveApproach: 'Single LLM prompt with brittle regex parsers and zero verification step (40% error rate on complex schemas).',
      prodArchitecture: 'Google ADK Multi-Agent loop with DAG-based task decomposition, Model Context Protocol (MCP) tool execution, and RAGAS anti-hallucination verification gate.',
      metrics: [
        { label: 'Manual Effort Reduction', value: '60%' },
        { label: 'Verification Pass Rate', value: '99.4%' },
        { label: 'Community Adoption', value: '100+ Devs' }
      ],
      tradeoffs: 'Opted for stateful DAG orchestration over single-agent auto-reflection to prevent infinite execution loops and ensure deterministic SLA.'
    }
  },
  {
    id: 'multi-agent-research',
    title: 'Multi-Agent Research System',
    description: 'Production-grade multi-agent research framework with guardrails, evaluation harness & async pipelines for detecting machine-generated text with safety-first architecture.',
    tags: ['Python', 'FastAPI', 'Multi-Agent', 'Guardrails', 'Eval'],
    href: 'https://github.com/akanksha-dot-dev/Multi-Agent-For-MGT',
    icon: '🧠',
    category: 'Agentic AI',
    impact: 'Guardrails + eval pipeline for production safety',
    status: 'Active Framework',
    statusBadge: 'badge',
    hasCaseStudy: true,
    caseStudy: {
      problem: 'Detecting subtle machine-generated text in high-stakes environments without triggering excessive false positives on human technical writing.',
      naiveApproach: 'Simple perplexity thresholding using off-the-shelf classifiers, easily fooled by paraphrasing.',
      prodArchitecture: 'Dual-agent verification harness: Agent 1 analyzes stylistic burstiness and entropy; Agent 2 performs semantic consistency probing against reference corpora.',
      metrics: [
        { label: 'Detection Precision', value: '94.2%' },
        { label: 'False Positive Rate', value: '< 2.1%' },
        { label: 'Async Latency', value: '310ms' }
      ],
      tradeoffs: 'Selected lightweight distilled local models over large commercial API calls to achieve sub-second async processing with zero data egress.'
    }
  },
  {
    id: 'o9-optimizer-agent',
    title: 'o9 Optimizer Agent',
    description: 'AI-powered report optimization & diagnostic advisory suite for o9 enterprise supply chain platform. Intelligent analysis and schema reconciliation for complex business data.',
    tags: ['Python', 'AI Agent', 'Enterprise', 'o9 Solutions'],
    href: 'https://github.com/akanksha-dot-dev/o9OptimizerAgent',
    icon: '⚙️',
    category: 'Agentic AI',
    impact: 'Enterprise supply chain optimization at scale',
    status: 'Enterprise Deploy',
    statusBadge: 'badge-amber',
    hasCaseStudy: true,
    caseStudy: {
      problem: 'Cross-tenant schema drift and report misconfigurations in enterprise supply chain instances caused delayed planning cycles.',
      naiveApproach: 'Manual rule scripts requiring engineer intervention for every schema update.',
      prodArchitecture: 'Autonomous diagnostic agent with AST schema parsing, automated diff generation, and verified patch suggestions for supply chain planners.',
      metrics: [
        { label: 'Diagnostic Speedup', value: '10x Faster' },
        { label: 'Schema Discrepancies Caught', value: '100%' },
        { label: 'Cross-Border Collaboration', value: 'India + Korea' }
      ],
      tradeoffs: 'Enforced read-only diagnostic sandbox with human-in-the-loop approval before applying suggested configuration patches.'
    }
  },
  // ─── Flagship: RAG ───
  {
    id: 'multilingual-mandi',
    title: 'Multilingual Mandi',
    description: 'AI-powered voice-first web app for India\'s local markets — multilingual translation (Hindi/Bhojpuri/Tamil/Telugu/Bengali), price discovery & smart negotiation using AWS Bedrock.',
    tags: ['AWS Bedrock', 'FastAPI', 'GenAI', 'Multilingual', 'Voice AI'],
    href: 'https://github.com/akanksha-dot-dev/multilingual_mandi',
    icon: '🌐',
    category: 'RAG',
    impact: 'PromptWars Noida 🥈 1st Runner-Up',
    status: 'Hackathon Winner',
    statusBadge: 'badge-amber',
    hasCaseStudy: true,
    caseStudy: {
      problem: 'Local agricultural traders in regional Indian markets face severe language barriers and price opacity when negotiating commodity transactions.',
      naiveApproach: 'Standard text translation APIs lacking agricultural domain vocabulary and dialect nuances (e.g., Bhojpuri/Maithili terminology).',
      prodArchitecture: 'Voice-first RAG pipeline using AWS Bedrock Claude 3 with acoustic speech processing and real-time mandi rate indexing.',
      metrics: [
        { label: 'Supported Dialects', value: '5 Languages' },
        { label: 'Award', value: '1st Runner-Up' },
        { label: 'End-to-End Latency', value: '< 800ms' }
      ],
      tradeoffs: 'Streamed audio responses chunk-by-chunk to deliver instant conversational feedback over low-bandwidth 4G connections.'
    }
  },
  {
    id: 'productivity-analyzer',
    title: 'Productivity Analyzer (Financial Graph RAG)',
    description: 'Enterprise RAG system processing JIRA stories, Confluence documents, and dense financial annual reports with knowledge graphs and hybrid vector retrieval.',
    tags: ['RAG', 'Python', 'FAISS', 'LLM', 'JIRA API', 'Graph RAG'],
    href: 'https://github.com/akanksha-dot-dev/ProductivityAnalyzer',
    icon: '📊',
    category: 'RAG',
    impact: 'Used at Samsung SDS (92% retrieval accuracy)',
    status: 'In Production',
    statusBadge: 'badge',
    hasCaseStudy: true,
    caseStudy: {
      problem: '200+ page annual financial statements with complex multi-column tables and nested disclosures overwhelmed traditional RAG vector chunking.',
      naiveApproach: 'Fixed-character sliding window chunking that split tables across chunks, destroying numerical context.',
      prodArchitecture: 'Partition PDF layout parser (GMFT) + FAISS hierarchical vector search + Neo4j entity graph enrichment with dynamic prompt routing.',
      metrics: [
        { label: 'Retrieval Accuracy', value: '92%' },
        { label: 'Daily Query Volume', value: '500+ Queries' },
        { label: 'Relevance Gain vs Baseline', value: '+40%' }
      ],
      tradeoffs: 'Implemented dynamic subgraph pruning to keep prompt tokens below threshold while preserving cross-page balance sheet relationships.'
    }
  },
  // ─── NLP ───
  {
    id: 'near-miss-analysis',
    title: 'Near Miss Incident Analysis',
    description: 'Predictive knowledge graph web app leveraging NLP for industrial near-miss incident analysis & prevention with interactive safety risk dashboards.',
    tags: ['NLP', 'Knowledge Graph', 'Python', 'Dashboard', 'ML'],
    href: 'https://github.com/akanksha-dot-dev/Urban-Intelligence-Dashboard-Final',
    icon: '🔬',
    category: 'NLP',
    impact: 'Industrial safety prediction with Knowledge Graph',
    status: 'Research Project',
    statusBadge: 'badge-ghost',
    hasCaseStudy: false
  },
  {
    id: 'ats-resume-optimizer',
    title: 'ATS Resume Optimizer',
    description: 'AI-powered resume optimization engine analyzing job descriptions and scoring resumes for ATS compatibility using NLP token alignment.',
    tags: ['NLP', 'Python', 'ATS', 'Resume', 'AI'],
    href: 'https://github.com/akanksha-dot-dev/ATS-Master-Resume-Optimizer',
    icon: '📄',
    category: 'NLP',
    impact: 'NLP-based ATS keyword scoring engine',
    status: 'Open Source',
    statusBadge: 'badge-ghost',
    hasCaseStudy: false
  },
  // ─── DevTools & Infra ───
  {
    id: 'gitsetu',
    title: 'gitsetu',
    description: 'Zero-dependency CLI tool for Git multi-identity & SSH key management. Switch between personal, work & open-source Git profiles in seconds.',
    tags: ['Shell', 'Git', 'CLI', 'DevTools', 'Zero-dep'],
    href: 'https://github.com/akanksha-dot-dev/gitsetu',
    icon: '🔧',
    category: 'DevTools',
    impact: 'Pure shell CLI with zero external dependencies',
    status: 'Open Source',
    statusBadge: 'badge-ghost',
    hasCaseStudy: false
  },
  {
    id: 'enterprise-etl',
    title: 'Enterprise ETL Pipeline',
    description: 'Multi-source business data ETL pipeline with bad data trapping, ForEach Loop folder automation, and enterprise schema transformations.',
    tags: ['ETL', 'Data Pipeline', 'Python', 'Data Engineering'],
    href: 'https://github.com/akanksha-dot-dev/Enterprise-Customer-Data-Warehouse-ETL-Pipeline.',
    icon: '🔄',
    category: 'Data',
    impact: 'Bad Data Trap pattern for enterprise reliability',
    status: 'Production System',
    statusBadge: 'badge-ghost',
    hasCaseStudy: false
  },
  // ─── IoT Origin Story ───
  {
    id: 'qport-card',
    title: 'QPORT Card — Smart Health Card',
    description: 'Unified medical records health card with RFID + IoT + Blockchain security. Emergency QR code access for critical patient data.',
    tags: ['IoT', 'RFID', 'Blockchain', 'Raspberry Pi', 'Firebase'],
    href: 'https://github.com/akanksha-dot-dev/QPORT-Feed',
    icon: '💳',
    category: 'IoT',
    impact: 'B.Tech major project → hackathon winner → research proposal',
    status: 'Award Winner',
    statusBadge: 'badge-amber',
    hasCaseStudy: false
  },
  {
    id: 'acotmos-covid',
    title: 'ACOTMOS — COVID-19 Testing System',
    description: 'Dual-model automated COVID testing: community IoT kit + individual ML-based screening. Built for MIT COVID-19 Challenge hackathon.',
    tags: ['IoT', 'ML', 'Mobile', 'APIs', 'Sensors'],
    href: 'https://github.com/akanksha-dot-dev',
    icon: '🦠',
    category: 'IoT',
    impact: 'MIT COVID-19 Challenge — Team Lead',
    status: 'Hackathon Project',
    statusBadge: 'badge-ghost',
    hasCaseStudy: false
  },
];

const categories = ['All', ...new Set(projects.map(p => p.category))];
---

<BaseLayout title="Projects & Case Studies — Akanksha | Production AI Engineer" description="Production-grade AI systems, Graph RAG pipelines, and Google ADK autonomous agent architectures built by Akanksha at Samsung SDS, HCLTech, and national hackathons.">
  
  <section class="relative overflow-hidden" aria-label="Projects Catalog">
    <div class="orb orb-amber" style="top: -200px; left: -200px;"></div>
    <div class="orb orb-purple" style="bottom: 200px; right: -200px;"></div>
    
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="fade-in mb-10">
        <span class="badge mb-4">Production Portfolio</span>
        <h1 class="font-(--font-heading) text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-white">
          Engineered to <span class="gradient-text">Ship</span>
        </h1>
        <p class="text-(--color-text-secondary) text-base sm:text-lg max-w-2xl leading-relaxed">
          Real enterprise systems, not tutorial clones. Each system includes rigorous evaluation harnesses, 
          guardrails against hallucination, and verified production metrics. Click any flagship project for architecture deep-dives.
        </p>
        <p class="text-(--color-text-muted) text-xs sm:text-sm mt-3 font-(--font-mono)">
          {projects.length} Systems Cataloged · {projects.filter(p => p.hasCaseStudy).length} Interactive Case Studies · Click "Inspect Architecture" for system blueprints
        </p>
      </div>
      
      <!-- Category Filters -->
      <div class="fade-in flex flex-wrap gap-2 mb-10" id="project-filters" role="toolbar" aria-label="Filter projects by category">
        {categories.map((cat, i) => (
          <button 
            type="button" 
            class:list={['filter-btn badge cursor-pointer transition-all hover:bg-(--color-teal-glow) text-xs py-1.5 px-3.5', i === 0 ? 'border-(--color-teal) bg-(--color-teal-glow) text-(--color-teal)' : 'bg-white/5 border-(--color-border) text-(--color-text-secondary)']} 
            data-category={cat}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {cat}
            {cat !== 'All' && <span class="text-[0.6rem] opacity-60">({projects.filter(p => p.category === cat).length})</span>}
          </button>
        ))}
      </div>
      
      <!-- Project Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="project-grid">
        {projects.map(project => (
          <div 
            class="glass p-5 sm:p-6 flex flex-col gap-3.5 group project-card fade-in relative"
            data-category={project.category}
            data-id={project.id}
          >
            <!-- Top Bar: Icon + Status Badges -->
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-3">
                <span class="text-3xl p-2 rounded-xl bg-[#080E1E] border border-(--color-border)">{project.icon}</span>
                <div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="badge-ghost badge text-[0.6rem]">{project.category}</span>
                    <span class:list={[project.statusBadge, 'badge text-[0.6rem]']}>
                      <span class="pulse-dot" style="width:0.35rem;height:0.35rem;"></span>
                      {project.status}
                    </span>
                  </div>
                  <h2 class="font-(--font-heading) font-bold text-base sm:text-lg text-white group-hover:text-(--color-teal) transition-colors mt-1">
                    {project.title}
                  </h2>
                </div>
              </div>
              
              <a 
                href={project.href} 
                target="_blank" 
                rel="noopener" 
                class="text-(--color-text-muted) hover:text-(--color-teal) transition-colors p-1.5 rounded-lg hover:bg-white/5"
                title={`Open ${project.title} on GitHub`}
                aria-label={`Open ${project.title} repository`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
            
            <!-- Description -->
            <p class="text-(--color-text-secondary) text-xs sm:text-sm leading-relaxed flex-1">
              {project.description}
            </p>
            
            <!-- Impact highlight -->
            <div class="flex items-center justify-between text-xs font-(--font-mono) pt-1">
              <span class="text-(--color-teal) font-medium flex items-center gap-1">
                <span>⚡</span> {project.impact}
              </span>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-2.5 border-t border-(--color-border)">
              {project.tags.map(tag => (
                <span class="badge text-[0.62rem] py-0.5">{tag}</span>
              ))}
            </div>

            <!-- Inspect Architecture Action Button -->
            {project.hasCaseStudy && (
              <button 
                type="button" 
                class="btn-inspect-arch mt-2 w-full py-2 px-3 rounded-lg text-xs font-(--font-mono) font-semibold flex items-center justify-center gap-1.5 border border-(--color-teal)/40 bg-(--color-teal-glow) text-(--color-teal) hover:bg-(--color-teal) hover:text-[#030712] transition-all cursor-pointer shadow-sm"
                data-project-id={project.id}
              >
                <span>🔍 Inspect Architecture & Metrics</span>
                <span class="text-[10px]">→</span>
              </button>
            )}
          </div>
        ))}
      </div>
      
      <!-- GitHub CTA -->
      <div class="fade-in text-center mt-12">
        <a href="https://github.com/akanksha-dot-dev" target="_blank" rel="noopener" class="btn-outline text-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          Explore All Repositories on GitHub →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ ARCHITECTURE INSPECTION MODAL ═══ -->
  <div id="arch-modal" class="fixed inset-0 z-[110] hidden bg-[#030712]/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="modal-project-title">
    <div class="w-full max-w-3xl bg-[#080E1E]/95 border border-(--color-border) rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] glass-glow-teal">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-(--color-border) bg-[#030712]/60">
        <div class="flex items-center gap-2.5">
          <span id="modal-project-icon" class="text-2xl">🤖</span>
          <div>
            <h3 id="modal-project-title" class="font-(--font-heading) font-extrabold text-base sm:text-lg text-white"></h3>
            <span class="text-[10px] font-(--font-mono) text-(--color-teal)">System Architecture & Trade-Off Breakdown</span>
          </div>
        </div>
        <button type="button" id="modal-close-btn" class="text-(--color-text-muted) hover:text-(--color-teal) text-sm p-1.5 rounded bg-white/5 border border-(--color-border) cursor-pointer" aria-label="Close architecture modal">✕</button>
      </div>

      <!-- Modal Content Body -->
      <div class="p-5 sm:p-6 overflow-y-auto flex flex-col gap-5 text-xs font-(--font-body)">
        <!-- Problem Statement -->
        <div class="flex flex-col gap-1.5">
          <span class="text-[10px] font-(--font-mono) text-(--color-text-muted) uppercase tracking-wider font-semibold">Production Problem & Challenge</span>
          <p id="modal-problem" class="text-xs text-(--color-text-secondary) leading-relaxed p-3 bg-white/5 rounded-xl border border-white/5"></p>
        </div>

        <!-- Before / After Architecture Comparison -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-3.5 rounded-xl border border-red-500/30 bg-red-500/5 flex flex-col gap-1.5">
            <span class="text-[10px] font-(--font-mono) text-red-400 font-bold uppercase tracking-wider flex items-center gap-1">
              <span>✕</span> Naive Approach (Tutorials)
            </span>
            <p id="modal-naive" class="text-[0.72rem] text-(--color-text-secondary) leading-relaxed"></p>
          </div>
          <div class="p-3.5 rounded-xl border border-teal-500/30 bg-teal-500/5 flex flex-col gap-1.5">
            <span class="text-[10px] font-(--font-mono) text-teal-300 font-bold uppercase tracking-wider flex items-center gap-1">
              <span>✔</span> Production Architecture
            </span>
            <p id="modal-prod" class="text-[0.72rem] text-(--color-text-secondary) leading-relaxed"></p>
          </div>
        </div>

        <!-- Verified Impact Metrics -->
        <div class="flex flex-col gap-1.5">
          <span class="text-[10px] font-(--font-mono) text-(--color-text-muted) uppercase tracking-wider font-semibold">Verified Impact & Evaluation Benchmarks</span>
          <div id="modal-metrics" class="grid grid-cols-3 gap-3">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Trade-Offs & Decisions -->
        <div class="p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/5 flex flex-col gap-1.5">
          <span class="text-[10px] font-(--font-mono) text-amber-400 font-bold uppercase tracking-wider flex items-center gap-1">
            <span>⚖</span> Core Architectural Trade-Offs
          </span>
          <p id="modal-tradeoffs" class="text-[0.72rem] text-(--color-text-secondary) leading-relaxed"></p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3 border-t border-(--color-border) bg-[#030712]/80 flex items-center justify-between">
        <a id="modal-github-link" href="#" target="_blank" rel="noopener" class="btn-primary text-xs py-1.5 px-4 flex items-center gap-1.5">
          <span>View Source Code on GitHub</span>
          <span class="text-[10px]">↗</span>
        </a>
        <span class="text-[10px] font-(--font-mono) text-(--color-text-muted)">Zero-API Client-Side Blueprint</span>
      </div>
    </div>
  </div>

  <script define:vars={{ projects }}>
    function initProjectsPage() {
      // Category filter handling
      const filterButtons = document.querySelectorAll('.filter-btn');
      const projectCards = document.querySelectorAll('.project-card');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('border-(--color-teal)', 'bg-(--color-teal-glow)', 'text-(--color-teal)');
            b.classList.add('bg-white/5', 'border-(--color-border)', 'text-(--color-text-secondary)');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('border-(--color-teal)', 'bg-(--color-teal-glow)', 'text-(--color-teal)');
          btn.classList.remove('bg-white/5', 'border-(--color-border)', 'text-(--color-text-secondary)');
          btn.setAttribute('aria-pressed', 'true');

          const category = btn.getAttribute('data-category');
          projectCards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (category === 'All' || cardCat === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // Modal handling
      const modal = document.getElementById('arch-modal');
      const modalClose = document.getElementById('modal-close-btn');
      const modalTitle = document.getElementById('modal-project-title');
      const modalIcon = document.getElementById('modal-project-icon');
      const modalProblem = document.getElementById('modal-problem');
      const modalNaive = document.getElementById('modal-naive');
      const modalProd = document.getElementById('modal-prod');
      const modalMetrics = document.getElementById('modal-metrics');
      const modalTradeoffs = document.getElementById('modal-tradeoffs');
      const modalGithub = document.getElementById('modal-github-link');

      function closeModal() {
        modal?.classList.add('hidden');
      }

      modalClose?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeModal();
        }
      });

      document.querySelectorAll('.btn-inspect-arch').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-project-id');
          const proj = projects.find(p => p.id === id);
          if (!proj || !proj.caseStudy) return;

          if (modalTitle) modalTitle.textContent = proj.title;
          if (modalIcon) modalIcon.textContent = proj.icon;
          if (modalProblem) modalProblem.textContent = proj.caseStudy.problem;
          if (modalNaive) modalNaive.textContent = proj.caseStudy.naiveApproach;
          if (modalProd) modalProd.textContent = proj.caseStudy.prodArchitecture;
          if (modalTradeoffs) modalTradeoffs.textContent = proj.caseStudy.tradeoffs;
          if (modalGithub) (modalGithub as HTMLAnchorElement).href = proj.href;

          if (modalMetrics) {
            modalMetrics.innerHTML = '';
            proj.caseStudy.metrics.forEach(m => {
              const el = document.createElement('div');
              el.className = 'glass-static p-2.5 rounded-xl text-center border border-white/5 bg-[#080E1E]';
              el.innerHTML = `
                <div class="text-base font-extrabold font-mono text-(--color-teal)">${m.value}</div>
                <div class="text-[9px] text-(--color-text-muted) font-mono uppercase tracking-wider mt-0.5">${m.label}</div>
              `;
              modalMetrics.appendChild(el);
            });
          }

          modal?.classList.remove('hidden');
        });
      });
    }

    initProjectsPage();
    document.addEventListener('astro:page-load', initProjectsPage);
