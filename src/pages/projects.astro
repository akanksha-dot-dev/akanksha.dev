---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ArchitectureVisualizer from '../components/ArchitectureVisualizer.astro';

const projects = [
  // ─── Flagship: Agentic AI ───
  {
    id: 'agentic-ai-workshop',
    title: 'AgenticAI Workshop',
    description: 'Multi-agent AI orchestration framework with Google ADK, MCP protocol integration, tool-use patterns & autonomous workflows. Includes hands-on workshop materials used at INCEPT\'26.',
    tags: ['Google ADK', 'LangChain', 'Agentic AI', 'MCP', 'Python'],
    href: 'https://github.com/akanksha-dot-dev/AgenticAI-Workshop',
    icon: '🤖',
    category: 'Agentic AI',
    impact: 'Speaker workshop materials at INCEPT\'26',
    status: 'active',
    deepDive: {
      overview: 'Comprehensive hands-on curriculum and code repository for building production multi-agent systems using Google ADK and Anthropic\'s Model Context Protocol (MCP).',
      architecture: 'Planner-Executor agent topology with dynamic tool selection, memory persistence, and guardrails evaluation layer.',
      highlights: [
        'Google ADK custom tool-calling agents',
        'MCP (Model Context Protocol) server & client integration',
        'Human-in-the-loop approval hooks for high-risk actions',
        'Evaluation benchmarks comparing single-agent vs multi-agent execution'
      ]
    }
  },
  {
    id: 'multi-agent-mgt',
    title: 'Multi-Agent Research System',
    description: 'Production-grade multi-agent research framework with guardrails, evaluation harness & async pipelines for detecting machine-generated text. Safety-first architecture.',
    tags: ['Python', 'FastAPI', 'Multi-Agent', 'Guardrails', 'Eval'],
    href: 'https://github.com/akanksha-dot-dev/Multi-Agent-For-MGT',
    icon: '🧠',
    category: 'Agentic AI',
    impact: 'Guardrails + eval pipeline for production safety',
    status: 'active',
    deepDive: {
      overview: 'Multi-agent collaborative framework designed for detecting and classifying machine-generated text (MGT) with customizable safety guardrails.',
      architecture: 'Asynchronous task queue with worker agents specialized in perplexity analysis, burstiness scoring, and semantic consistency checking.',
      highlights: [
        'Perplexity & burstiness feature extraction agents',
        'Async FastAPI REST endpoint with WebSocket live progress updates',
        'Automated evaluation harness against benchmark datasets',
        'Configurable hallucination & safety guardrails'
      ]
    }
  },
  {
    id: 'o9-optimizer-agent',
    title: 'o9 Optimizer Agent',
    description: 'AI-powered report optimization & diagnostic advisory suite for o9 enterprise supply chain platform. Intelligent analysis of complex business data.',
    tags: ['Python', 'AI Agent', 'Enterprise', 'o9 Solutions'],
    href: 'https://github.com/akanksha-dot-dev/o9OptimizerAgent',
    icon: '⚙️',
    category: 'Agentic AI',
    impact: 'Enterprise supply chain optimization at scale',
    status: 'active',
    deepDive: {
      overview: 'Enterprise diagnostic agent that parses supply chain execution logs, identifies performance bottlenecks in o9 reports, and suggests automated indexing strategies.',
      architecture: 'LLM reasoning engine integrated with enterprise database schemas and rule-based fallback heuristics.',
      highlights: [
        'Automated query log parser and anomaly detector',
        'Natural language diagnostic report generator',
        'Sub-second query plan advisory recommendations'
      ]
    }
  },
  // ─── Flagship: RAG ───
  {
    id: 'multilingual-mandi',
    title: 'Multilingual Mandi',
    description: 'AI-powered voice-first web app for India\'s local markets — multilingual translation (Hindi/Bhojpuri/Tamil/Telugu/Bengali), price discovery & smart negotiation using AWS Bedrock.',
    tags: ['AWS Bedrock', 'FastAPI', 'GenAI', 'Multilingual', 'Voice AI'],
    href: 'https://github.com/akanksha-dot-dev/multilingual_mandi',
    icon: '🌐',
    category: 'RAG',
    impact: 'Built at PromptWars Noida (🥈 1st Runner-Up)',
    status: 'completed',
    deepDive: {
      overview: 'Voice-enabled AI marketplace negotiation assistant helping Indian farmers and local vendors overcome language barriers during crop sales.',
      architecture: 'Whisper STT -> AWS Bedrock Claude 3 translation & price discovery RAG -> ElevenLabs TTS response generation pipeline.',
      highlights: [
        'Real-time speech-to-speech translation in 5 Indian languages',
        'RAG price discovery against government APMC mandi market data',
        'Built in 24 hours under hackathon constraints (1st Runner-Up)'
      ]
    }
  },
  {
    id: 'productivity-analyzer',
    title: 'Productivity Analyzer',
    description: 'End-to-end RAG system for processing JIRA stories, Confluence documents, and annual reports to deliver automated weekly team productivity reports.',
    tags: ['RAG', 'Python', 'FAISS', 'LLM', 'JIRA API'],
    href: 'https://github.com/akanksha-dot-dev/ProductivityAnalyzer',
    icon: '📊',
    category: 'RAG',
    impact: 'Full RAG pipeline with vector search — used at Samsung SDS',
    status: 'active',
    deepDive: {
      overview: 'Enterprise productivity analytical assistant querying unstructured team sprint data to generate executive action summaries.',
      architecture: 'Hybrid BM25 + FAISS vector retriever with reranking layer and strict source attribution citations.',
      highlights: [
        '92% retrieval accuracy on technical Confluence docs',
        'JIRA API webhooks for real-time document ingestion',
        'Automated Markdown & PDF report generation'
      ]
    }
  },
  // ─── NLP ───
  {
    id: 'near-miss-incident',
    title: 'Near Miss Incident Analysis',
    description: 'Predictive knowledge graph web app leveraging NLP for near-miss incident analysis & prevention. Text mining + graph databases + interactive dashboards.',
    tags: ['NLP', 'Knowledge Graph', 'Python', 'Dashboard', 'ML'],
    href: 'https://github.com/akanksha-dot-dev/Urban-Intelligence-Dashboard-Final',
    icon: '🔬',
    category: 'NLP',
    impact: 'NLP + Knowledge Graph for industrial safety prediction',
    status: 'completed',
    deepDive: {
      overview: 'Industrial safety text mining platform extracting causal entities from unstructured safety incident reports into a Neo4j knowledge graph.',
      architecture: 'SpaCy NER pipeline -> Entity relation extractor -> Neo4j Graph DB -> Streamlit interactive visualization dashboard.',
      highlights: [
        'Entity extraction for equipment, hazards, and root causes',
        'Interactive graph network graph exploring incident paths',
        'Predictive safety risk scoring for upcoming maintenance shifts'
      ]
    }
  },
  {
    id: 'ats-resume-optimizer',
    title: 'ATS Resume Optimizer',
    description: 'AI-powered resume optimization engine that analyzes job descriptions and scores resumes for ATS compatibility using NLP and keyword matching.',
    tags: ['NLP', 'Python', 'ATS', 'Resume', 'AI'],
    href: 'https://github.com/akanksha-dot-dev/ATS-Master-Resume-Optimizer',
    icon: '📄',
    category: 'NLP',
    impact: 'Practical AI tool solving real hiring problem',
    status: 'completed',
    deepDive: {
      overview: 'Automated candidate resume parsing tool that compares resume skill vectors against job posting requirements.',
      architecture: 'PDF/Docx parser -> SentenceTransformer embeddings -> Cosine similarity + TF-IDF keyword gap analysis.',
      highlights: [
        'Actionable keyword gap recommendations',
        'Instant ATS readability score generation',
        'Privacy-first local execution without storing personal data'
      ]
    }
  },
  // ─── DevTools ───
  {
    id: 'gitsetu',
    title: 'gitsetu',
    description: 'Zero-dependency CLI tool for Git multi-identity & SSH key setup. Switch between personal, work & open-source Git identities in seconds. Clone, run, done.',
    tags: ['Shell', 'Git', 'CLI', 'DevTools', 'Zero-dep'],
    href: 'https://github.com/akanksha-dot-dev/gitsetu',
    icon: '🔧',
    category: 'DevTools',
    impact: 'Open-source CLI — zero dependencies, pure shell',
    status: 'completed',
    deepDive: {
      overview: 'Lightweight POSIX shell tool that configures directory-scoped `.gitconfig` includes and SSH key aliases.',
      architecture: 'Zero-dependency pure Bash/Zsh script with interactive wizard and dry-run safety flags.',
      highlights: [
        'Zero external runtime dependencies required',
        'Automatic SSH host alias generation',
        'Prevents embarrassing commits with the wrong email/identity'
      ]
    }
  },
  // ─── Data Engineering ───
  {
    id: 'enterprise-etl',
    title: 'Enterprise ETL Pipeline',
    description: 'Multi-source business data ETL pipeline with bad data trapping, ForEach Loop Container for folder automation, and data conversion transformations.',
    tags: ['ETL', 'Data Pipeline', 'Python', 'Data Engineering'],
    href: 'https://github.com/akanksha-dot-dev/Enterprise-Customer-Data-Warehouse-ETL-Pipeline.',
    icon: '🔄',
    category: 'Data',
    impact: 'Bad Data Trap pattern for enterprise reliability',
    status: 'completed',
    deepDive: {
      overview: 'Enterprise data warehouse ingestion pipeline built to handle malformed schema updates and corrupt rows gracefully.',
      architecture: 'Staging table quarantine queue -> Bad Data Trap handler -> Automated email alerts -> Transformed DW tables.',
      highlights: [
        'Zero data-loss architecture for bad/corrupt records',
        'Automated directory scanner using ForEach polling loop',
        'Comprehensive audit logging and execution metrics'
      ]
    }
  },
  // ─── College/Hackathon (IoT origin story) ───
  {
    id: 'qport-card',
    title: 'QPORT Card — Smart Health Card',
    description: 'Unified medical records health card with RFID + IoT + Blockchain security. Emergency QR code access for critical patient data. Won hackathon prizes, continued as research proposal.',
    tags: ['IoT', 'RFID', 'Blockchain', 'Raspberry Pi', 'Firebase'],
    href: 'https://github.com/akanksha-dot-dev/QPORT-Feed',
    icon: '💳',
    category: 'IoT',
    impact: 'B.Tech major project → hackathon winner → research proposal',
    status: 'completed',
    deepDive: {
      overview: 'Smart emergency healthcare card storing encrypted patient vitals, allergy records, and emergency contact metadata.',
      architecture: 'RFID RC522 reader -> Raspberry Pi gateway -> Encrypted Firebase Firestore -> Emergency QR web interface.',
      highlights: [
        'Sub-second emergency record retrieval via QR scan',
        'Tamper-evident hash validation for record updates',
        'Hardware prototype built during B.Tech Electrical Engineering capstone'
      ]
    }
  },
  {
    id: 'acotmos',
    title: 'ACOTMOS — COVID-19 Testing System',
    description: 'Dual-model automated COVID testing: community IoT kit + individual ML-based screening. Built for MIT COVID-19 Challenge hackathon (Beat the Pandemic II).',
    tags: ['IoT', 'ML', 'Mobile', 'APIs', 'Sensors'],
    href: '#',
    icon: '🦠',
    category: 'IoT',
    impact: 'MIT COVID-19 Challenge — Team Lead',
    status: 'completed',
    deepDive: {
      overview: 'Rapid community COVID-19 diagnostic triage system developed during the international MIT Beat the Pandemic II hackathon.',
      architecture: 'Sensor data collector app -> Random Forest symptom risk classifier -> Micro-triage dashboard.',
      highlights: [
        'Designed under intensive 48-hour hackathon timeframe',
        'Led international multidisciplinary team of engineers & medical researchers',
        'Evaluated by global public health hackathon judges'
      ]
    }
  },
];

const categories = ['All', ...new Set(projects.map(p => p.category))];
const projectSchemas = projects.map(p => ({
  '@type': 'SoftwareApplication',
  'name': p.title,
  'description': p.description,
  'applicationCategory': 'DeveloperApplication',
  'operatingSystem': 'All',
  'author': {
    '@id': 'https://akanksha.dev/#person'
  },
  'codeRepository': p.href,
  'keywords': p.tags.join(', ')
}));
---

<BaseLayout title="Projects — Akanksha | Production AI Engineer" description="Production AI projects: Agentic AI frameworks, Graph RAG systems, LLM fine-tuning, and open-source ML tools built at Samsung SDS & HCLTech.">
  <StructuredData schema={projectSchemas} />
  
  <section class="relative overflow-hidden">
    <div class="orb orb-amber" style="top: -200px; left: -200px;"></div>
    <div class="orb orb-purple" style="bottom: 200px; right: -200px;"></div>
    
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="fade-in mb-12">
        <span class="badge mb-4">Portfolio</span>
        <h1 class="font-(--font-heading) text-4xl md:text-5xl font-800 mb-4 tracking-tight">
          Things I've <span class="gradient-text">Built</span>
        </h1>
        <p class="text-(--color-text-secondary) text-lg max-w-2xl">
          Production-grade AI systems, not tutorial clones. Each project solves a real problem 
          with real engineering — evaluation pipelines, guardrails, and monitoring included.
        </p>
        <p class="text-(--color-text-muted) text-sm mt-2 font-(--font-mono)">
          {projects.length} projects · {projects.filter(p => p.status === 'active').length} actively maintained · Click any card for architecture deep-dive
        </p>
      </div>
      
      <!-- Category Filters -->
      <div class="fade-in flex flex-wrap gap-2 mb-10" id="project-filters">
        {categories.map((cat, i) => (
          <button 
            class:list={['filter-btn badge cursor-pointer transition-all hover:bg-(--color-teal-glow)', i === 0 ? 'active-filter' : '']} 
            data-category={cat}
          >
            {cat}
            {cat !== 'All' && <span class="text-[0.55rem] opacity-60">({projects.filter(p => p.category === cat).length})</span>}
          </button>
        ))}
      </div>
      
      <!-- Project Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="project-grid">
        {projects.map(project => (
          <div 
            class="glass p-5 flex flex-col gap-3 group project-card fade-in cursor-pointer relative"
            data-category={project.category}
            data-id={project.id}
          >
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">{project.icon}</span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="badge-amber badge text-[0.55rem]">{project.category}</span>
                    {project.status === 'active' && (
                      <span class="badge text-[0.55rem]">
                        <span class="pulse-dot" style="width:0.35rem;height:0.35rem;"></span>
                        Active
                      </span>
                    )}
                  </div>
                  <h3 class="font-(--font-heading) font-700 text-base group-hover:text-(--color-teal) transition-colors mt-1">
                    {project.title}
                  </h3>
                </div>
              </div>

              <button 
                class="open-modal-btn text-xs text-(--color-teal) hover:underline font-mono bg-teal-glow/40 px-2 py-1 rounded border border-teal/20 shrink-0"
                data-id={project.id}
              >
                Deep Dive →
              </button>
            </div>
            
            <p class="text-(--color-text-secondary) text-sm leading-relaxed flex-1">
              {project.description}
            </p>
            
            <p class="text-(--color-teal) text-xs font-(--font-mono)">
              ⚡ {project.impact}
            </p>
            
            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-(--color-border)">
              {project.tags.map(tag => (
                <span class="badge text-[0.6rem]">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      
      <!-- GitHub CTA -->
      <div class="fade-in text-center mt-10">
        <a href="https://github.com/akanksha-dot-dev" target="_blank" rel="noopener" class="btn-outline text-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          View All on GitHub →
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Project Deep Dive Modal -->
  <dialog id="project-modal" class="bg-transparent backdrop:bg-space/80 backdrop:backdrop-blur-md p-4 max-w-3xl w-full mx-auto my-auto rounded-2xl border border-(--color-border) text-(--color-text-primary) shadow-2xl">
    <div class="glass-static p-6 md:p-8 rounded-2xl relative overflow-hidden">
      <button id="close-project-modal" class="absolute top-4 right-4 text-(--color-text-muted) hover:text-(--color-teal) transition-colors p-2 text-lg">✕</button>

      <div id="modal-content" class="space-y-4">
        <!-- Dynamically injected via JS -->
      </div>
    </div>
  </dialog>

  <!-- Pre-rendered Architecture Diagram Templates -->
  <div id="arch-templates" class="hidden">
    <div id="arch-template-agentic-ai-workshop">
      <ArchitectureVisualizer projectId="agentic-ai-workshop" />
    </div>
    <div id="arch-template-multi-agent-mgt">
      <ArchitectureVisualizer projectId="multi-agent-mgt" />
    </div>
    <div id="arch-template-multilingual-mandi">
      <ArchitectureVisualizer projectId="multilingual-mandi" />
    </div>
    <div id="arch-template-productivity-analyzer">
      <ArchitectureVisualizer projectId="productivity-analyzer" />
    </div>
    <div id="arch-template-o9-optimizer-agent">
      <ArchitectureVisualizer projectId="agentic-ai-workshop" />
    </div>
  </div>
  
  <style>
    .active-filter {
      background: var(--color-teal) !important;
      color: var(--color-space) !important;
      border-color: var(--color-teal) !important;
    }
  </style>
  
  <script is:inline define:vars={{ projects }}>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    const modal = document.getElementById('project-modal');
    const modalContent = document.getElementById('modal-content');
    const closeModalBtn = document.getElementById('close-project-modal');
    
    // Category filtering
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        
        buttons.forEach(b => b.classList.remove('active-filter'));
        btn.classList.add('active-filter');
        
        cards.forEach(card => {
          if (category === 'All' || card.getAttribute('data-category') === category) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Deep dive modal logic
    function openModal(projectId) {
      const p = projects.find(item => item.id === projectId);
      if (!p || !modal || !modalContent) return;

      const archTemplate = document.getElementById(`arch-template-${projectId}`);
      const archHtml = archTemplate ? archTemplate.innerHTML : '';

      modalContent.innerHTML = `
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-2 pr-6">
          <div class="flex items-center gap-3">
            <span class="text-3xl">${p.icon}</span>
            <div>
              <span class="badge-amber badge text-[0.6rem]">${p.category}</span>
              <h3 class="font-heading font-700 text-xl text-text-primary mt-0.5">${p.title}</h3>
            </div>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex gap-2 border-b border-border pb-2">
          <button id="tab-btn-overview" class="px-3 py-1 text-xs font-mono rounded-lg bg-teal text-space font-semibold cursor-pointer">
            Overview
          </button>
          <button id="tab-btn-arch" class="px-3 py-1 text-xs font-mono rounded-lg bg-white/5 hover:bg-white/10 text-text-secondary cursor-pointer border border-border">
            ⚡ Interactive System Architecture Diagram
          </button>
        </div>

        <!-- Tab 1: Overview -->
        <div id="tab-content-overview" class="space-y-4">
          <p class="text-text-secondary text-sm leading-relaxed">${p.deepDive.overview}</p>

          <div class="glass p-4 rounded-xl space-y-2 border border-border">
            <p class="text-xs font-mono text-teal uppercase tracking-wider font-semibold">⚡ Architecture & Pipeline</p>
            <p class="text-xs text-text-secondary leading-relaxed">${p.deepDive.architecture}</p>
          </div>

          <div>
            <p class="text-xs font-mono text-text-muted uppercase tracking-wider mb-2">Key Technical Highlights</p>
            <ul class="space-y-1.5">
              ${p.deepDive.highlights.map(h => `<li class="flex items-start gap-2 text-xs text-text-secondary"><span class="text-teal mt-0.5">✔</span> <span>${h}</span></li>`).join('')}
            </ul>
          </div>
        </div>

        <!-- Tab 2: Interactive Architecture Diagram -->
        <div id="tab-content-arch" class="hidden space-y-3">
          ${archHtml ? archHtml : `
            <div class="glass p-4 rounded-xl text-xs text-text-secondary">
              <p class="font-mono text-teal mb-1">Architecture Overview</p>
              <p>${p.deepDive.architecture}</p>
            </div>
          `}
        </div>

        <div class="flex flex-wrap gap-1.5 pt-2">
          ${p.tags.map(t => `<span class="badge text-[0.6rem]">${t}</span>`).join('')}
        </div>

        <div class="flex justify-between items-center pt-4 border-t border-border mt-4">
          <span class="text-xs font-mono text-amber">Impact: ${p.impact}</span>
          ${p.href !== '#' ? `<a href="${p.href}" target="_blank" rel="noopener" class="btn-primary py-2 px-4 text-xs">View Code Repository →</a>` : ''}
        </div>
      `;

      // Tab switching logic inside modal
      const overviewBtn = document.getElementById('tab-btn-overview');
      const archBtn = document.getElementById('tab-btn-arch');
      const overviewContent = document.getElementById('tab-content-overview');
      const archContent = document.getElementById('tab-content-arch');

      overviewBtn?.addEventListener('click', () => {
        overviewBtn.className = 'px-3 py-1 text-xs font-mono rounded-lg bg-teal text-space font-semibold cursor-pointer';
        archBtn.className = 'px-3 py-1 text-xs font-mono rounded-lg bg-white/5 hover:bg-white/10 text-text-secondary cursor-pointer border border-border';
        overviewContent?.classList.remove('hidden');
        archContent?.classList.add('hidden');
      });

      archBtn?.addEventListener('click', () => {
        archBtn.className = 'px-3 py-1 text-xs font-mono rounded-lg bg-teal text-space font-semibold cursor-pointer';
        overviewBtn.className = 'px-3 py-1 text-xs font-mono rounded-lg bg-white/5 hover:bg-white/10 text-text-secondary cursor-pointer border border-border';
        archContent?.classList.remove('hidden');
        overviewContent?.classList.add('hidden');
      });

      modal.showModal();
    }

    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const id = card.getAttribute('data-id');
        if (id) openModal(id);
      });
    });

    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });
    }
  </script>
</BaseLayout>
