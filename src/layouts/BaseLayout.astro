            <a href="https://linkedin.com/in/akankshadev" target="_blank" rel="noopener" class="text-(--color-text-secondary) hover:text-(--color-teal) text-sm transition-colors flex items-center gap-1.5">
              <span>LinkedIn</span>
              <span class="text-[10px] text-(--color-text-muted)">↗</span>
            </a>
            <a href="https://github.com/akanksha-dot-dev" target="_blank" rel="noopener" class="text-(--color-text-secondary) hover:text-(--color-teal) text-sm transition-colors flex items-center gap-1.5">
              <span>GitHub</span>
              <span class="text-[10px] text-(--color-text-muted)">↗</span>
            </a>
            <a href="https://x.com/akankshadotdev" target="_blank" rel="noopener" class="text-(--color-text-secondary) hover:text-(--color-teal) text-sm transition-colors flex items-center gap-1.5">
              <span>Twitter/X</span>
              <span class="text-[10px] text-(--color-text-muted)">↗</span>
            </a>
            <a href="https://dev.to/akanksha-dev" target="_blank" rel="noopener" class="text-(--color-text-secondary) hover:text-(--color-teal) text-sm transition-colors flex items-center gap-1.5">
              <span>Dev.to</span>
              <span class="text-[10px] text-(--color-text-muted)">↗</span>
            </a>
            <a href="mailto:me@akanksha.dev" class="text-(--color-teal) hover:underline text-sm transition-colors font-mono mt-1">me@akanksha.dev</a>
          </div>
        </div>
      </div>
      
      <div class="border-t border-(--color-border) pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-(--color-text-muted) text-xs font-(--font-mono)">
          © {new Date().getFullYear()} Akanksha · Production AI Engineering Platform · Hosted on Cloudflare Edge
        </p>
        <div class="flex gap-4 items-center">
          <a href="/llms.txt" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs transition-colors font-(--font-mono)">llms.txt</a>
          <span class="text-(--color-border)">·</span>
          <a href="/sitemap-index.xml" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs transition-colors font-(--font-mono)">sitemap.xml</a>
          <span class="text-(--color-border)">·</span>
          <a href="https://github.com/akanksha-dot-dev/akanksha.dev" target="_blank" rel="noopener" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs transition-colors font-(--font-mono)">source ↗</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ═══ COMMAND PALETTE 3.0 (Cmd+K) ═══ -->
  <div id="command-palette" class="fixed inset-0 z-[100] hidden bg-[#030712]/85 backdrop-blur-md flex items-start justify-center pt-[12vh] px-4" aria-modal="true" role="dialog" aria-label="Command Palette & Local AI Agent">
    <div class="w-full max-w-2xl bg-[#080E1E]/95 border border-(--color-border) rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[75vh] glass-glow-teal">
      <!-- Search Input Header -->
      <div class="flex items-center gap-3 px-4 py-3.5 border-b border-(--color-border) bg-[#030712]/60">
        <svg class="w-5 h-5 text-(--color-teal) shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="text" 
          id="palette-search-input" 
          class="w-full bg-transparent border-0 outline-none text-sm font-(--font-mono) text-(--color-text-primary) placeholder-(--color-text-muted)"
          placeholder="Ask Akanksha's AI Agent or search commands ('skills', 'rag', 'projects', 'resume')..."
          autocomplete="off"
          aria-label="Search prompt or navigation command"
        />
        <button type="button" id="palette-close-btn" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs px-2 py-1 rounded bg-[#030712] border border-(--color-border) font-(--font-mono) cursor-pointer" aria-label="Close search">ESC</button>
      </div>

      <!-- Scrollable content area -->
      <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
