        </button>
        <!-- Mobile Menu Button -->
        <button 
          type="button" 
          id="mobile-menu-btn" 
          class="text-(--color-text-secondary) hover:text-(--color-teal) transition-colors p-2 rounded-lg bg-(--color-surface) border border-(--color-border) cursor-pointer" 
          aria-expanded="false" 
          aria-controls="mobile-menu" 
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Nav Drawer -->
    <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 transition-all duration-300">
      <div class="glass p-5 flex flex-col gap-3.5 border border-(--color-border)">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class:list={['nav-link text-base py-1 px-2 rounded hover:bg-white/5', { active: currentPath === link.href }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <div class="pt-3 border-t border-(--color-border) flex items-center justify-between text-xs text-(--color-text-muted) font-mono">
          <span>⚡ Status: Open to Roles</span>
