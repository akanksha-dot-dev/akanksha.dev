        <span class="w-2.5 h-2.5 rounded-full bg-(--color-teal) shadow-[0_0_8px_rgba(0,229,176,0.8)]"></span>
        <span class="text-(--color-teal) transition-colors">A</span><span class="text-(--color-text-primary) group-hover:text-(--color-teal) transition-colors">kanksha</span><span class="text-(--color-text-muted) font-mono text-xs">.dev</span>
      </a>
      
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-7">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <!-- Search Button (Ctrl+K) -->
        <button 
          type="button" 
          id="nav-search-btn" 
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-(--color-surface) border border-(--color-border) hover:border-(--color-teal) hover:bg-(--color-surface-hover) transition-all text-xs font-(--font-mono) text-(--color-text-secondary) cursor-pointer select-none" 
          aria-label="Open Command Palette (Ctrl+K)"
        >
          <svg class="w-3.5 h-3.5 text-(--color-teal)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <span>Ask Agent</span>
          <kbd class="px-1.5 py-0.5 rounded bg-(--color-space) border border-(--color-border) text-[10px] text-(--color-text-muted)">⌘K</kbd>
        </button>
      </div>
      
      <!-- Mobile Controls -->
      <div class="flex items-center gap-3 md:hidden">
        <!-- Mobile Search Button -->
        <button 
          type="button" 
          id="mobile-search-btn" 
          class="text-(--color-text-secondary) hover:text-(--color-teal) transition-colors cursor-pointer p-2 rounded-lg bg-(--color-surface) border border-(--color-border)" 
          aria-label="Open search and command palette"
        >
          <svg class="w-4 h-4 text-(--color-teal)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
        <!-- Mobile Menu Button -->
        <button 
          type="button" 
          id="mobile-menu-btn" 
          class="text-(--color-text-secondary) hover:text-(--color-teal) transition-colors p-2 rounded-lg bg-(--color-surface) border border-(--color-border) cursor-pointer" 
          aria-expanded="false" 
          aria-controls="mobile-menu" 
          aria-label="Toggle navigation menu"
        >
