      experience: "Professional Career Timeline:\n1. Samsung SDS (Oct 2024 – Present) | Production AI Engineer / Senior Executive Engineer\n2. HCLTech (Sep 2022 – Sep 2024) | Software Engineer (ML recruitment platform, 500+ incidents resolved, 98% reliability)\n3. Collegedunia (2021 – 2024) | Technical & SEO Writing\n4. TRTC Patna (2020 – 2021) | Hardware & Telecom Infrastructure Intern",
      hcltech: "Software Engineer @ HCLTech (Sep 2022 – Sep 2024):\n• Built machine learning features for iTAP enterprise platform (CV parsing, profile matching, smart search)\n• Resolved 500+ production incidents, cutting system downtime by 30%\n• Maintained 98% service reliability on AWS and Azure.",
      hackathons: "Competitions & National Awards:\n• 1st Runner-Up — PromptWars Noida (Hack2skill × Google for Developers, Jun 2026)\n• 1st Place — AI & ML Training Program (EdgeFX × DCE, 2021)\n• 1st Place — TEQIP-III Hackathon (Emerging Technologies, 2019)\n• 2nd Place — SPIU Bihar STEM & Robotics (2020)\n• Team Lead — MIT COVID-19 Challenge (Beat the Pandemic II, 2020)",
      certifications: "300+ Verified Credentials:\n• Flagship: Udacity AI Programming Nanodegree, Google × Kaggle AI Agents Intensive, Anthropic Claude Code + MCP (5 certs), IIT Kanpur Full Stack, ISRO Remote Sensing\n• Platforms: 150+ Coursera (Google, IBM, Meta), 89 LinkedIn Learning, 40+ Skillsoft, Cisco\n• Academic: NPTEL Star, Domain Scholar & Discipline Star",
      speaking: "Speaker Engagements:\n• INCEPT'26 (GLA University) — Industry talk on AI & Production Engineering alongside CampusX founder\n• AI Mobile Hackathon — Deep Dive Session Leader on Transformers & RAG (YouTube video available)\n• 25+ events attended in 2025-2026 across Google Cloud Summit, US Embassy Tech Event, India AI Impact Summit",
      contact: "Get in Touch with Akanksha:\n• Email: me@akanksha.dev\n• LinkedIn: linkedin.com/in/akankshadev\n• GitHub: github.com/akanksha-dot-dev\n• Twitter/X: x.com/akankshadotdev\n• Location: Gurugram, India (Open to Remote / Hybrid)",
      resume: "Resume Dossier:\n• Tailored for Senior/Staff Production AI Engineer roles.\n• Verified metrics on file. Download PDF directly from /contact or type 'download resume'."
    };

    const defaultCommands = [
      { name: "Go to Home", action: () => window.location.href = "/" },
      { name: "Go to About Page", action: () => window.location.href = "/about" },
      { name: "Go to Projects & Architecture Deep-Dives", action: () => window.location.href = "/projects" },
      { name: "Go to Experience (System Changelog)", action: () => window.location.href = "/experience" },
      { name: "Go to Speaking & Community", action: () => window.location.href = "/speaking" },
      { name: "Go to Blog & Technical Insights", action: () => window.location.href = "/blog" },
      { name: "Go to Contact & Conversion Page", action: () => window.location.href = "/contact" },
      { name: "Download Resume Dossier (PDF)", action: () => window.open("/resume/akanksha_resume.pdf", "_blank") },
      { name: "Email Akanksha Directly (me@akanksha.dev)", action: () => window.location.href = "mailto:me@akanksha.dev" }
    ];

    let selectedIndex = 0;
    let streamInterval: ReturnType<typeof setInterval> | null = null;

    function togglePalette() {
      const palette = document.getElementById('command-palette');
      const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
      const aiBox = document.getElementById('palette-ai-box');
      if (!palette) return;

      const isHidden = palette.classList.toggle('hidden');
      if (!isHidden) {
        selectedIndex = 0;
        if (searchInput) {
          searchInput.value = '';
          setTimeout(() => searchInput.focus(), 50);
        }
        aiBox?.classList.add('hidden');
        renderSuggestions('');
      } else {
        if (streamInterval) clearInterval(streamInterval);
      }
    }

    function renderSuggestions(filter = '') {
      const optionsList = document.getElementById('palette-options-list');
      if (!optionsList) return;
      optionsList.innerHTML = '';

      const filtered = defaultCommands.filter(c => 
        c.name.toLowerCase().includes(filter.toLowerCase())
      );

      if (filtered.length === 0) {
        optionsList.innerHTML = `<div class="text-xs text-(--color-text-muted) px-3 py-2 font-(--font-mono)">No commands found matching "${filter}". Searching knowledge base...</div>`;
        return;
      }

      filtered.forEach((cmd, idx) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = `w-full text-left px-3 py-2 rounded-lg text-xs font-(--font-mono) flex items-center justify-between transition-all cursor-pointer ${
          idx === selectedIndex 
            ? 'bg-(--color-teal) text-(--color-space) font-semibold shadow-[0_0_12px_rgba(0,229,176,0.4)]' 
            : 'text-(--color-text-secondary) hover:bg-white/5 hover:text-(--color-text-primary)'
        }`;
        item.innerHTML = `
          <span class="flex items-center gap-2">
            <span class="${idx === selectedIndex ? 'text-(--color-space)' : 'text-(--color-teal)'}">›</span>
            ${cmd.name}
          </span>
          <span class="${idx === selectedIndex ? 'text-(--color-space)/80' : 'text-(--color-text-muted)'} text-[10px]">Action</span>
        `;
        item.addEventListener('click', () => {
          cmd.action();
          togglePalette();
        });
        optionsList.appendChild(item);
      });
    }

    function handleSearchInput() {
      const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
      const aiBox = document.getElementById('palette-ai-box');
      const aiResponse = document.getElementById('palette-ai-response');
      const aiStatus = document.getElementById('palette-ai-status');

      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      selectedIndex = 0;
      renderSuggestions(query);

      if (streamInterval) clearInterval(streamInterval);

      if (query.length < 2) {
        aiBox?.classList.add('hidden');
        return;
      }

      let responseText = '';
      for (const [key, val] of Object.entries(kb)) {
        if (query.includes(key) || key.includes(query)) {
          responseText = val;
          break;
        }
      }

      if (!responseText) {
        if (query.includes('hi') || query.includes('hello') || query.includes('hey')) {
          responseText = "Hello! I'm Akanksha's Local AI Agent. You can query my credentials, RAG architecture, agentic systems, Samsung SDS work, hackathons, speaking engagements, or resume dossier.";
        } else {
          const keys = Object.keys(kb);
          const partial = keys.find(k => k.startsWith(query) || query.startsWith(k));
          if (partial) {
            responseText = kb[partial];
          } else {
            responseText = `Searching Akanksha's static data corpus for "${query}"...\nNo exact match found. Try querying: 'skills', 'rag', 'agents', 'samsung', 'experience', 'hackathons', 'speaking', or 'resume'.`;
          }
        }
      }

      aiBox?.classList.remove('hidden');
      if (aiResponse) aiResponse.textContent = '';
      if (aiStatus) aiStatus.textContent = 'Streaming Response...';

      let i = 0;
      streamInterval = setInterval(() => {
        if (aiResponse) {
          aiResponse.textContent += responseText.charAt(i);
        }
        i++;
        if (i >= responseText.length) {
          if (streamInterval) clearInterval(streamInterval);
          if (aiStatus) aiStatus.textContent = 'Index Response Complete';
        }
      }, 8);
    }

    // Global Key Listener
    if (!(window as any).__AK_GLOBAL_KEYS_INIT__) {
      (window as any).__AK_GLOBAL_KEYS_INIT__ = true;

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const palette = document.getElementById('command-palette');
        const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
        const optionsList = document.getElementById('palette-options-list');

        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          togglePalette();
          return;
        }

        if (palette && !palette.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            e.preventDefault();
            togglePalette();
            return;
          }

          const items = optionsList?.querySelectorAll('button') || [];
          if (items.length > 0) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              selectedIndex = (selectedIndex + 1) % items.length;
              renderSuggestions(searchInput?.value || '');
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              renderSuggestions(searchInput?.value || '');
            } else if (e.key === 'Enter') {
              e.preventDefault();
              const activeItem = items[selectedIndex] as HTMLButtonElement | undefined;
              activeItem?.click();
            }
          }
        }
      });
    }

    // Page-level Initializer
    function initBasePage() {
      // Nav background on scroll
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          nav?.classList.add('nav-scrolled');
        } else {
          nav?.classList.remove('nav-scrolled');
        }
      }, { passive: true });

      // Mobile menu toggle
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });

      // Scroll observer for fade-in animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });

      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

      // Latency & Clock ticker
      if (!(window as any).__AK_TELEMETRY_TIMER__) {
        (window as any).__AK_TELEMETRY_TIMER__ = true;
        
        setInterval(() => {
          const lat = Math.floor(Math.random() * 8) + 14;
          const el = document.getElementById('latency-indicator');
          if (el) el.textContent = `Telemetry: ${lat}ms`;

          const timeEl = document.getElementById('live-time-ticker');
          if (timeEl) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-GB', { timeZone: 'Asia/Kolkata', hour12: false });
            timeEl.textContent = `IST ${timeStr}`;
          }
        }, 3000);
      }

      // Palette event hooks
      const searchInput = document.getElementById('palette-search-input');
      const closeBtn = document.getElementById('palette-close-btn');
      const navSearchBtn = document.getElementById('nav-search-btn');
      const mobileSearchBtn = document.getElementById('mobile-search-btn');
      const paletteBackdrop = document.getElementById('command-palette');

      searchInput?.addEventListener('input', handleSearchInput);
      closeBtn?.addEventListener('click', togglePalette);
      navSearchBtn?.addEventListener('click', togglePalette);
      mobileSearchBtn?.addEventListener('click', togglePalette);
      
      paletteBackdrop?.addEventListener('click', (e) => {
        if (e.target === paletteBackdrop) {
          togglePalette();
        }
      });
    }

    initBasePage();
    document.addEventListener('astro:page-load', initBasePage);
  </script>
</body>
</html>
