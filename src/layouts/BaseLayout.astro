      <span class="text-(--color-text-muted)">|</span>
      <span class="text-(--color-text-muted)">Astro 7</span>
    </div>
  </div>

  <!-- ═══ GLOBAL CLIENT SCRIPT ═══ -->
  <script>
    // ─── 1. KNOWLEDGE BASE & TELEMETRY CORPUS ───
    const kb: Record<string, string> = {
      skills: "Akanksha's Technical Stack:\n• AI Agents & Orchestration: Google ADK, LangChain, LangGraph, CrewAI, MCP Protocol, Multi-Agent Systems\n• RAG & Search: Graph RAG, FAISS, Chroma DB, Hybrid Vector Search, RAGAS Evaluation Framework\n• LLMs & Inference: GPT-4, Llama-3, Mistral, PEFT/LoRA, Prompt Engineering\n• Backend & Infra: Python, FastAPI, Django, PostgreSQL, Docker, Kubernetes, CI/CD\n• Cloud: AWS (Bedrock, SageMaker), Azure ML, Cloudflare Workers",
      rag: "RAG Architecture at Samsung SDS:\n• End-to-end Graph RAG pipeline processing complex annual financial statements\n• Advanced document extraction (GMFT, Partition PDF)\n• 92% evaluation accuracy on 500+ daily queries, 40% retrieval precision improvement over baseline.",
      agents: "Agentic AI Orchestration:\n• Architecting autonomous AI agent loops with Google ADK for enterprise content generation and QA automation\n• 60% reduction in manual engineer effort\n• Multi-agent safety harnesses with verifiers and output guardrails.",
      samsung: "Senior Executive Engineer @ Samsung SDS, Gurugram (Oct 2024 - Present):\n• Leading GenAI developer squad (3 engineers)\n• Architecting enterprise Graph RAG and Google ADK agentic workflows\n• Managing India-Korea cross-border engineering delivery.",
      experience: "Professional Career Timeline:\n1. Samsung SDS (Oct 2024 – Present) | Production AI Engineer / Senior Executive Engineer\n2. HCLTech (Sep 2022 – Sep 2024) | Software Engineer (ML recruitment platform, 500+ incidents resolved, 98% reliability)\n3. Collegedunia (2021 – 2024) | Technical & SEO Writing\n4. TRTC Patna (2020 – 2021) | Hardware & Telecom Infrastructure Intern",
      hcltech: "Software Engineer @ HCLTech (Sep 2022 – Sep 2024):\n• Built machine learning features for iTAP enterprise platform (CV parsing, profile matching, smart search)\n• Resolved 500+ production incidents, cutting system downtime by 30%\n• Maintained 98% service reliability on AWS and Azure.",
      hackathons: "Competitions & National Awards:\n• 1st Runner-Up — PromptWars Noida (Hack2skill × Google for Developers, Jun 2026)\n• 1st Place — AI & ML Training Program (EdgeFX × DCE, 2021)\n• 1st Place — TEQIP-III Hackathon (Emerging Technologies, 2019)\n• 2nd Place — SPIU Bihar STEM & Robotics (2020)\n• Team Lead — MIT COVID-19 Challenge (Beat the Pandemic II, 2020)",
      certifications: "300+ Verified Credentials:\n• Flagship: Udacity AI Programming Nanodegree, Google × Kaggle AI Agents Intensive, Anthropic Claude Code + MCP (5 certs), IIT Kanpur Full Stack, ISRO Remote Sensing\n• Platforms: 150+ Coursera (Google, IBM, Meta), 89 LinkedIn Learning, 40+ Skillsoft, Cisco\n• Academic: NPTEL Star, Domain Scholar & Discipline Star",
      speaking: "Speaker Engagements:\n• INCEPT'26 (GLA University) — Industry talk on AI & Production Engineering alongside CampusX founder\n• AI Mobile Hackathon — Deep Dive Session Leader on Transformers & RAG (YouTube video available)\n• 25+ events attended in 2025-2026 across Google Cloud Summit, US Embassy Tech Event, India AI Impact Summit",
      contact: "Get in Touch with Akanksha:\n• Email: me@akanksha.dev\n• LinkedIn: linkedin.com/in/akankshadev\n• GitHub: github.com/akanksha-dot-dev\n• Twitter/X: x.com/akankshadotdev\n• Location: Gurugram, India (Open to Remote / Hybrid)",
      resume: "Resume Dossier:\n• Tailored for Senior/Staff Production AI Engineer roles.\n• Verified metrics on file. Download PDF directly from /contact or type 'download resume'."
    };

    const defaultCommands = [
      { name: "Go to Home", action: () => window.location.href = "/" },
      { name: "Go to About Page", action: () => window.location.href = "/about" },
      { name: "Go to Projects & Architecture Deep-Dives", action: () => window.location.href = "/projects" },
      { name: "Go to Experience (System Changelog)", action: () => window.location.href = "/experience" },
      { name: "Go to Speaking & Community", action: () => window.location.href = "/speaking" },
      { name: "Go to Blog & Technical Insights", action: () => window.location.href = "/blog" },
      { name: "Go to Contact & Conversion Page", action: () => window.location.href = "/contact" },
      { name: "Download Resume Dossier (PDF)", action: () => window.open("/resume/akanksha_resume.pdf", "_blank") },
      { name: "Email Akanksha Directly (me@akanksha.dev)", action: () => window.location.href = "mailto:me@akanksha.dev" }
    ];

    // ─── 2. WEB AUDIO SYNTHESIZER FOR SUBTLE HAPTIC FEEDBACK ───
    let audioCtx: AudioContext | null = null;
    let audioEnabled = false;

    function getAudioContext(): AudioContext | null {
      if (!audioCtx && typeof window !== 'undefined' && ('AudioContext' in window || 'webkitAudioContext' in (window as any))) {
        const AudioCtor = window.AudioContext || (window as any).webkitAudioContext;
        audioCtx = new AudioCtor();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playAudioCue(type: 'click' | 'success' | 'agent' | 'node') {
      if (!audioEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;

        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        const now = ctx.currentTime;
        if (type === 'click') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(800, now);
          osc.frequency.exponentialRampToValueAtTime(400, now + 0.04);
          gain.gain.setValueAtTime(0.05, now);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.04);
          osc.start(now);
          osc.stop(now + 0.04);
        } else if (type === 'node') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.08);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.08);
          osc.start(now);
          osc.stop(now + 0.08);
        } else if (type === 'success') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(440, now);
          osc.frequency.setValueAtTime(660, now + 0.06);
          osc.frequency.setValueAtTime(880, now + 0.12);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.2);
          osc.start(now);
          osc.stop(now + 0.2);
        } else if (type === 'agent') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1200, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.05);
          gain.gain.setValueAtTime(0.04, now);
          gain.gain.linearRampToValueAtTime(0.001, now + 0.05);
          osc.start(now);
          osc.stop(now + 0.05);
        }
      } catch {
        // Ignore audio errors gracefully
      }
    }

    // Expose sound trigger globally so other components can invoke it
    (window as any).__AK_PLAY_SOUND__ = playAudioCue;

    // ─── 3. WEBMCP PROTOCOL REGISTRATION (MODERN WEB GUIDANCE) ───
    async function initWebMcpTools() {
      const modelContext = (document as any).modelContext || (navigator as any).modelContext;
      
      const mcpTools = {
        query_career_knowledge_base: {
          name: "query_career_knowledge_base",
          description: "Queries Akanksha's static data corpus for verified skills, experience, RAG pipelines, awards, and contact info.",
          inputSchema: {
            type: "object",
            properties: {
              query: { type: "string", description: "Search term e.g. 'rag', 'skills', 'agents', 'samsung'" }
            },
            required: ["query"]
          },
          execute(input: { query: string }) {
            const q = (input.query || '').toLowerCase();
            for (const [k, v] of Object.entries(kb)) {
              if (q.includes(k) || k.includes(q)) return { result: v };
            }
            return { result: "No direct match. Available topics: skills, rag, agents, samsung, experience, hackathons, speaking, contact, resume." };
          },
          annotations: { readOnlyHint: true }
        },
        fetch_candidate_dossier: {
          name: "fetch_candidate_dossier",
          description: "Fetches structured candidate overview of Akanksha for hiring managers and recruiters.",
          inputSchema: { type: "object", properties: {} },
          execute() {
            return {
              name: "Akanksha",
              role: "Production AI Engineer",
              company: "Samsung SDS",
              experience: "4+ years",
              flagshipMetrics: {
                graphRagAccuracy: "92%",
                manualQaReduction: "60%",
                certificationsCount: "300+",
                hackathonWins: 4
              },
              email: "me@akanksha.dev",
              linkedin: "https://linkedin.com/in/akankshadev",
              openToRoles: "Senior / Staff Production AI Engineer"
            };
          },
          annotations: { readOnlyHint: true }
        }
      };

      // Store in window for browser subagents/extensions
      (window as any).__AK_MCP_TOOLS__ = mcpTools;

      if (modelContext && typeof modelContext.registerTool === 'function') {
        try {
          await modelContext.registerTool(mcpTools.query_career_knowledge_base);
          await modelContext.registerTool(mcpTools.fetch_candidate_dossier);
        } catch {
          // Native WebMCP registration fallback
        }
      }
    }

    // ─── 4. COMMAND PALETTE LOGIC ───
    let selectedIndex = 0;
    let streamInterval: ReturnType<typeof setInterval> | null = null;

    function togglePalette() {
      const palette = document.getElementById('command-palette');
      const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
      const aiBox = document.getElementById('palette-ai-box');
      if (!palette) return;

      const isHidden = palette.classList.toggle('hidden');
      if (!isHidden) {
        playAudioCue('agent');
        selectedIndex = 0;
        if (searchInput) {
          searchInput.value = '';
          setTimeout(() => searchInput.focus(), 50);
        }
        aiBox?.classList.add('hidden');
        renderSuggestions('');
      } else {
        if (streamInterval) clearInterval(streamInterval);
      }
    }

    function renderSuggestions(filter = '') {
      const optionsList = document.getElementById('palette-options-list');
      if (!optionsList) return;
      optionsList.innerHTML = '';

      const filtered = defaultCommands.filter(c => 
        c.name.toLowerCase().includes(filter.toLowerCase())
      );

      if (filtered.length === 0) {
        optionsList.innerHTML = `<div class="text-xs text-(--color-text-muted) px-3 py-2 font-(--font-mono)">No commands found matching "${filter}". Searching knowledge base...</div>`;
        return;
      }

      filtered.forEach((cmd, idx) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = `w-full text-left px-3 py-2 rounded-lg text-xs font-(--font-mono) flex items-center justify-between transition-all cursor-pointer ${
          idx === selectedIndex 
            ? 'bg-(--color-teal) text-[#030712] font-semibold shadow-[0_0_12px_rgba(0,240,181,0.4)]' 
            : 'text-(--color-text-secondary) hover:bg-white/5 hover:text-(--color-text-primary)'
        }`;
        item.innerHTML = `
          <span class="flex items-center gap-2">
            <span class="${idx === selectedIndex ? 'text-[#030712]' : 'text-(--color-teal)'}">›</span>
            ${cmd.name}
          </span>
          <span class="${idx === selectedIndex ? 'text-[#030712]/80' : 'text-(--color-text-muted)'} text-[10px]">Action</span>
        `;
        item.addEventListener('click', () => {
          playAudioCue('click');
          cmd.action();
          togglePalette();
        });
        optionsList.appendChild(item);
      });
    }

    function handleSearchInput() {
      const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
      const aiBox = document.getElementById('palette-ai-box');
      const aiResponse = document.getElementById('palette-ai-response');
      const aiStatus = document.getElementById('palette-ai-status');

      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      selectedIndex = 0;
      renderSuggestions(query);

      if (streamInterval) clearInterval(streamInterval);

      if (query.length < 2) {
        aiBox?.classList.add('hidden');
        return;
      }

      let responseText = '';
      for (const [key, val] of Object.entries(kb)) {
        if (query.includes(key) || key.includes(query)) {
          responseText = val;
          break;
        }
      }

      if (!responseText) {
        if (query.includes('hi') || query.includes('hello') || query.includes('hey')) {
          responseText = "Hello! I'm Akanksha's Local AI Agent. You can query my credentials, RAG architecture, agentic systems, Samsung SDS work, hackathons, speaking engagements, or resume dossier.";
        } else {
          const keys = Object.keys(kb);
          const partial = keys.find(k => k.startsWith(query) || query.startsWith(k));
          if (partial) {
            responseText = kb[partial];
          } else {
            responseText = `Searching Akanksha's static data corpus for "${query}"...\nNo exact match found. Try querying: 'skills', 'rag', 'agents', 'samsung', 'experience', 'hackathons', 'speaking', or 'resume'.`;
          }
        }
      }

      aiBox?.classList.remove('hidden');
      if (aiResponse) aiResponse.textContent = '';
      if (aiStatus) aiStatus.textContent = 'Streaming Response...';

      let i = 0;
      streamInterval = setInterval(() => {
        if (aiResponse) {
          aiResponse.textContent += responseText.charAt(i);
        }
        i++;
        if (i >= responseText.length) {
          if (streamInterval) clearInterval(streamInterval);
          if (aiStatus) aiStatus.textContent = 'Index Response Complete';
          playAudioCue('success');
        }
      }, 8);
    }

    // ─── 5. GLOBAL LISTENERS & INITIALIZATION ───
    if (!(window as any).__AK_GLOBAL_KEYS_INIT__) {
      (window as any).__AK_GLOBAL_KEYS_INIT__ = true;

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const palette = document.getElementById('command-palette');
        const searchInput = document.getElementById('palette-search-input') as HTMLInputElement | null;
        const optionsList = document.getElementById('palette-options-list');

        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          togglePalette();
          return;
        }

        if (palette && !palette.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            e.preventDefault();
            togglePalette();
            return;
          }

          const items = optionsList?.querySelectorAll('button') || [];
          if (items.length > 0) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              selectedIndex = (selectedIndex + 1) % items.length;
              renderSuggestions(searchInput?.value || '');
              playAudioCue('click');
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              renderSuggestions(searchInput?.value || '');
              playAudioCue('click');
            } else if (e.key === 'Enter') {
              e.preventDefault();
              const activeItem = items[selectedIndex] as HTMLButtonElement | undefined;
              activeItem?.click();
            }
          }
        }
      });
    }

    function initBasePage() {
      // Top Scroll Progress Bar
      const progressBar = document.getElementById('scroll-progress');
      const nav = document.getElementById('main-nav');

      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) {
          progressBar.style.width = `${pct}%`;
        }

        if (scrollTop > 20) {
          nav?.classList.add('nav-scrolled');
        } else {
          nav?.classList.remove('nav-scrolled');
        }
      }, { passive: true });

      // Audio synthesizer setup from localStorage
      const audioBtn = document.getElementById('audio-synth-toggle');
      const audioIcon = document.getElementById('audio-synth-icon');
      const savedAudio = localStorage.getItem('ak_audio_enabled');
      if (savedAudio === 'true') {
        audioEnabled = true;
        if (audioIcon) audioIcon.textContent = '🔊';
      }

      audioBtn?.addEventListener('click', () => {
        audioEnabled = !audioEnabled;
        localStorage.setItem('ak_audio_enabled', audioEnabled ? 'true' : 'false');
        if (audioIcon) audioIcon.textContent = audioEnabled ? '🔊' : '🔇';
        if (audioEnabled) {
          getAudioContext();
          playAudioCue('success');
        }
      });

      // Mobile menu toggle
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        playAudioCue('click');
      });

      // Scroll observer for fade-in animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });

      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

      // Latency & Clock ticker
      if (!(window as any).__AK_TELEMETRY_TIMER__) {
        (window as any).__AK_TELEMETRY_TIMER__ = true;
        
        setInterval(() => {
          const lat = Math.floor(Math.random() * 6) + 14;
          const el = document.getElementById('latency-indicator');
          if (el) el.textContent = `Telemetry: ${lat}ms`;

          const timeEl = document.getElementById('live-time-ticker');
          if (timeEl) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-GB', { timeZone: 'Asia/Kolkata', hour12: false });
            timeEl.textContent = `IST ${timeStr}`;
          }
        }, 3000);
      }

      // Palette event hooks
      const searchInput = document.getElementById('palette-search-input');
      const closeBtn = document.getElementById('palette-close-btn');
      const navSearchBtn = document.getElementById('nav-search-btn');
      const mobileSearchBtn = document.getElementById('mobile-search-btn');
      const paletteBackdrop = document.getElementById('command-palette');

      searchInput?.addEventListener('input', handleSearchInput);
      closeBtn?.addEventListener('click', togglePalette);
      navSearchBtn?.addEventListener('click', togglePalette);
      mobileSearchBtn?.addEventListener('click', togglePalette);
      
      paletteBackdrop?.addEventListener('click', (e) => {
        if (e.target === paletteBackdrop) {
          togglePalette();
        }
      });

      // Initialize WebMCP tools
      initWebMcpTools();
    }

    initBasePage();
    document.addEventListener('astro:page-load', initBasePage);
  </script>
</body>
