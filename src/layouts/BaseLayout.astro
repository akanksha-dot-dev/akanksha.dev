        ⚡ <span class="text-(--color-teal)">Open to Senior AI Engineer Roles</span>
      </a>
    </div>
    
    <div class="flex items-center gap-3">
      <!-- Sound FX Toggle -->
      <button 
        type="button" 
        id="audio-synth-toggle" 
        class="hover:text-(--color-teal) transition-colors flex items-center gap-1 cursor-pointer"
