          <div class="flex flex-col gap-1.5" id="palette-options-list">
            <!-- Dynamic commands go here -->
          </div>
        </div>
      </div>
      
      <!-- Footer instructions -->
      <div class="px-4 py-2.5 bg-[#030712]/90 border-t border-(--color-border) flex items-center justify-between text-[10px] font-(--font-mono) text-(--color-text-muted) select-none">
        <div class="flex items-center gap-3">
          <span>↑↓ to navigate</span>
          <span>↵ to execute</span>
