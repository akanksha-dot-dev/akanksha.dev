          <svg class="w-3.5 h-3.5 text-(--color-teal)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <span>Ask Agent</span>
          <kbd class="px-1.5 py-0.5 rounded bg-[#030712] border border-(--color-border) text-[10px] text-(--color-text-muted)">⌘K</kbd>
        </button>
      </div>
      
      <!-- Mobile Controls -->
      <div class="flex items-center gap-3 md:hidden">
        <!-- Mobile Search Button -->
        <button 
          type="button" 
          id="mobile-search-btn" 
          class="text-(--color-text-secondary) hover:text-(--color-teal) transition-colors cursor-pointer p-2 rounded-lg bg-(--color-surface) border border-(--color-border)" 
          aria-label="Open search and command palette"
        >
