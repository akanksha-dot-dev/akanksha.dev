                <span class="relative inline-flex rounded-full h-2 w-2 bg-(--color-teal)"></span>
              </span>
              Akanksha's Local AI Agent
            </span>
            <span class="text-(--color-text-muted)" id="palette-ai-status">Synthesizing...</span>
          </div>
          <p id="palette-ai-response" class="text-xs sm:text-sm text-(--color-text-secondary) leading-relaxed font-(--font-body) min-h-[2rem] whitespace-pre-wrap font-normal"></p>
