---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Production AI Engineer building enterprise AI systems — Agentic RAG, autonomous agents (Google ADK), and enterprise LLM orchestration. 4+ years shipping AI at Samsung SDS & HCLTech.",
  ogImage = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://akanksha.dev');
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

// Build breadcrumb for current page
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', url: 'https://akanksha.dev/' },
  ...pathSegments.map((seg, i) => ({
    name: seg.charAt(0).toUpperCase() + seg.slice(1),
    url: `https://akanksha.dev/${pathSegments.slice(0, i + 1).join('/')}/`,
  })),
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://akanksha.dev')} />
  <meta property="og:site_name" content="Akanksha.dev" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@akankshadotdev" />
  <meta name="twitter:creator" content="@akankshadotdev" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://akanksha.dev')} />
  
  <!-- Typography font loading: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />
  </noscript>
  
  <!-- Theme Color for mobile browsers -->
  <meta name="theme-color" content="#030712" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  
  <!-- View Transitions -->
  <ClientRouter />
  
  <!-- JSON-LD Person Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://akanksha.dev/#person",
    "name": "Akanksha",
    "url": "https://akanksha.dev",
    "jobTitle": "Production AI Engineer",
    "description": "Production AI Engineer at Samsung SDS specializing in Agentic RAG systems, autonomous agents (Google ADK), and enterprise LLM orchestration.",
    "email": "me@akanksha.dev",
    "sameAs": [
      "https://linkedin.com/in/akankshadev",
      "https://github.com/akanksha-dot-dev",
      "https://dev.to/akanksha-dev",
      "https://x.com/akankshadotdev",
      "https://huggingface.co/akanksha-dev",
      "https://kaggle.com/akankshadotdev"
    ],
    "knowsAbout": [
      "Generative AI", "Agentic RAG", "Autonomous Agents", "LLM Orchestration",
      "Python", "Google ADK", "LangChain", "LangGraph", "FastAPI",
      "FAISS", "Graph RAG", "RAGAS Evaluation", "Docker", "AWS Bedrock"
    ],
    "worksFor": {
      "@type": "Organization",
      "name": "Samsung SDS",
      "url": "https://www.samsungsds.com"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Darbhanga College of Engineering"
    }
  })} />
  
  <!-- JSON-LD WebSite Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://akanksha.dev/#website",
    "name": "akanksha.dev",
    "url": "https://akanksha.dev",
    "description": "Portfolio and developer platform of Akanksha — Production AI Engineer at Samsung SDS.",
    "publisher": { "@id": "https://akanksha.dev/#person" },
    "inLanguage": "en-US"
  })} />
  
  <!-- JSON-LD BreadcrumbList -->
  {breadcrumbs.length > 1 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((bc, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": bc.name,
        "item": bc.url
      }))
    })} />
  )}
  
  <!-- Cloudflare Web Analytics -->
  {cfAnalyticsToken && (
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}></script>
  )}
</head>

<body class="bg-(--color-space) text-(--color-text-primary) font-(--font-body) antialiased">
  
  <!-- Top Scroll Progress Bar (Modern Web Guidance) -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- Skip to Main Content (WCAG 2.2 AA) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-(--color-teal) focus:text-[#030712] focus:font-bold focus:rounded-lg focus:shadow-2xl focus:outline-none">
    Skip to main content
  </a>

  <!-- ═══ NAVIGATION ═══ -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" aria-label="Primary Navigation">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <!-- Logo: Clean brand mark with pulsing status dot -->
      <a href="/" class="text-lg font-bold font-(--font-heading) tracking-tight group flex items-center gap-2" aria-label="Akanksha.dev Homepage">
        <span class="w-2.5 h-2.5 rounded-full bg-(--color-teal) shadow-[0_0_10px_rgba(0,240,181,0.8)]"></span>
        <span class="text-white tracking-tight">akanksha<span class="text-(--color-teal)">.dev</span></span>
      </a>
      
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-7">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        
        <!-- Search Button (Ctrl+K) -->
        <button 
          type="button" 
          id="nav-search-btn" 
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-(--color-surface) border border-(--color-border) hover:border-(--color-teal) hover:bg-(--color-surface-hover) transition-all text-xs font-(--font-mono) text-(--color-text-secondary) cursor-pointer select-none" 
