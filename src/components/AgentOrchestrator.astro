---
// AgentOrchestrator.astro - Interactive Multi-Agent Workflow Studio
---

<div class="agent-orchestrator rounded-2xl border border-white/10 bg-slate-900/60 p-6 md:p-8 backdrop-blur-xl shadow-2xl">
  <!-- Top Header & Pipeline Selector -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 pb-6 border-b border-white/10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-3">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Multi-Agent Runtime Engine v2.4
      </div>
      <h3 class="text-2xl font-bold text-white tracking-tight">Agent Workflow Orchestrator Studio</h3>
      <p class="text-slate-400 text-sm mt-1">Simulate, inspect, and benchmark multi-agent graph topologies, tool calls, and guardrail validations in real-time.</p>
    </div>

    <!-- Pipeline Presets Picker -->
    <div class="flex flex-wrap items-center gap-2">
      <button 
        data-pipeline="security" 
        class="pipeline-preset-btn active px-4 py-2 rounded-xl text-xs font-medium border transition-all duration-300 bg-cyan-500/20 text-cyan-300 border-cyan-500/40 shadow-lg shadow-cyan-500/10"
      >
        🔒 Enterprise Security Audit
      </button>
      <button 
        data-pipeline="rag" 
        class="pipeline-preset-btn px-4 py-2 rounded-xl text-xs font-medium border transition-all duration-300 bg-white/5 text-slate-400 border-white/10 hover:bg-white/10 hover:text-white"
      >
        📊 Multi-Doc Financial RAG
      </button>
      <button 
        data-pipeline="voice" 
        class="pipeline-preset-btn px-4 py-2 rounded-xl text-xs font-medium border transition-all duration-300 bg-white/5 text-slate-400 border-white/10 hover:bg-white/10 hover:text-white"
      >
        🎙️ Voice AI Customer Support
      </button>
    </div>
  </div>

  <!-- Input & Execution Controls -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-8">
    <div class="lg:col-span-3 flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <input 
          type="text" 
          id="pipelineInput" 
          value="Analyze code repo for SQL injection vulnerabilities & auto-generate fix PR"
          class="w-full bg-slate-950/80 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/50 transition-all"
          placeholder="Enter prompt or query payload for agent pipeline..."
        />
      </div>
      <button 
        id="runPipelineBtn" 
        class="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-semibold text-sm shadow-lg shadow-cyan-500/25 transition-all flex items-center justify-center gap-2 whitespace-nowrap active:scale-[0.98]"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Execute Pipeline
      </button>
    </div>

    <!-- Execution Speed & Reset -->
    <div class="flex items-center justify-between sm:justify-end gap-3 bg-slate-950/60 p-2.5 rounded-xl border border-white/5">
      <span class="text-xs text-slate-400 font-mono">Speed:</span>
      <select id="executionSpeed" class="bg-slate-900 text-xs text-cyan-400 border border-white/10 rounded-lg px-2.5 py-1.5 focus:outline-none">
        <option value="1200">1.0x Normal</option>
        <option value="600">2.0x Fast</option>
        <option value="2000">0.5x Step Debug</option>
      </select>
      <button id="resetPipelineBtn" class="text-xs text-slate-400 hover:text-white px-2 py-1 rounded hover:bg-white/5 transition-colors">
        ↺ Reset
      </button>
    </div>
  </div>

  <!-- Main Pipeline Execution Visualizer -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Visual Node Flow Canvas (Left 7 Cols) -->
    <div class="lg:col-span-7 space-y-4">
      <div class="flex items-center justify-between px-1">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Agent Topology Map</span>
        <span id="pipelineStatusBadge" class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-white/5">
          IDLE — Waiting for Execution
        </span>
      </div>

      <!-- Nodes List Container -->
      <div id="agentNodesContainer" class="space-y-3 relative before:absolute before:left-6 before:top-8 before:bottom-8 before:w-0.5 before:bg-gradient-to-b before:from-cyan-500/40 before:via-purple-500/40 before:to-emerald-500/40">
        <!-- Rendered dynamically via JavaScript -->
      </div>
    </div>

    <!-- Right Side: Step Inspector & Telemetry (Right 5 Cols) -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <!-- Live Metrics Card -->
      <div class="p-5 rounded-xl bg-slate-950/80 border border-white/10 space-y-4">
        <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400 flex items-center justify-between">
          <span>Execution Telemetry</span>
          <span class="text-cyan-400">Live Metrics</span>
        </h4>
        
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 rounded-lg bg-slate-900/80 border border-white/5">
            <div class="text-[10px] text-slate-400 uppercase font-mono">Total Latency</div>
            <div id="metricLatency" class="text-lg font-bold font-mono text-cyan-400">0 ms</div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/80 border border-white/5">
            <div class="text-[10px] text-slate-400 uppercase font-mono">Tokens Processed</div>
            <div id="metricTokens" class="text-lg font-bold font-mono text-purple-400">0 tokens</div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/80 border border-white/5">
            <div class="text-[10px] text-slate-400 uppercase font-mono">Tool Invocations</div>
            <div id="metricTools" class="text-lg font-bold font-mono text-amber-400">0 calls</div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/80 border border-white/5">
            <div class="text-[10px] text-slate-400 uppercase font-mono">Guardrail Score</div>
            <div id="metricGuardrail" class="text-lg font-bold font-mono text-emerald-400">100%</div>
          </div>
        </div>
      </div>

      <!-- Selected Step Log Inspector -->
      <div class="flex-1 p-5 rounded-xl bg-slate-950/80 border border-white/10 flex flex-col">
        <div class="flex items-center justify-between mb-3 pb-3 border-b border-white/5">
          <h4 id="inspectorStepName" class="text-xs font-mono font-bold text-white uppercase tracking-wider">
            Agent Step Inspector
          </h4>
          <span id="inspectorStepStatus" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400">
            Select node
          </span>
        </div>

        <div id="inspectorContent" class="flex-1 text-xs font-mono text-slate-300 overflow-y-auto max-h-[320px] space-y-3 pr-1">
          <div class="text-slate-500 italic py-8 text-center">
            Click on any agent step node on the left map to inspect detailed system prompt, vector inputs, tool parameters, and model response outputs.
          </div>
        </div>

        <!-- Copy Trace Button -->
        <button 
          id="copyTraceBtn" 
          class="mt-4 w-full py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 text-xs font-mono transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          Copy Complete Agent Trace (JSON)
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Agent Workflow Definitions
  const PIPELINES = {
    security: {
      title: "Enterprise Security Audit",
      defaultInput: "Analyze repo for SQL injection vulnerabilities & auto-generate fix PR",
      nodes: [
        {
          id: "sec_1",
          name: "Security Static Scanner",
          role: "AST Code Analyzer & Semgrep Rules Engine",
          icon: "🔍",
          prompt: "Scan repo files for unescaped parameter queries, raw string concatenation, and hardcoded JWT secrets.",
          output: "Detected 2 vulnerability alerts: high-severity SQL concatenation in src/db/user.ts:L42 and API secret key exposure in config.js.",
          latency: 240,
          tokens: 420,
          tools: ["ast_parser", "semgrep_exec"],
          guardrail: "PASS (0 false positives)"
        },
        {
          id: "sec_2",
          name: "LLM Remediation Agent",
          role: "Code Transformer (Claude 3.5 Sonnet / ADK)",
          icon: "⚡",
          prompt: "Generate parametrized SQL queries and move plain text secrets to environment variable bindings.",
          output: "Refactored user.ts to use parameterized knex query builder. Replaced hardcoded string with process.env.API_SECRET_KEY.",
          latency: 890,
          tokens: 1850,
          tools: ["code_refactor_engine", "ast_diff_builder"],
          guardrail: "PASS (AST valid)"
        },
        {
          id: "sec_3",
          name: "NeMo Security Guardrail",
          role: "Prompt Injection & Safety Moderation",
          icon: "🛡️",
          prompt: "Verify proposed code change contains no backdoor functions, prompt leaks, or elevated privilege escalations.",
          output: "NeMo Guardrail check completed: Zero jailbreak attempts detected. Output code verified compliant with OWASP Top 10 guidelines.",
          latency: 180,
          tokens: 310,
          tools: ["nemo_moderator", "safety_classifier"],
          guardrail: "PASS (Confidence: 99.8%)"
        },
        {
          id: "sec_4",
          name: "Git PR Automated Publisher",
          role: "CI/CD & GitHub Integration Agent",
          icon: "🚀",
          prompt: "Create a topic branch `patch/sec-fix-sql`, commit AST diffs, and publish GitHub Pull Request with automated test suite.",
          output: "Pull Request #142 published: 'fix(security): sanitize user query parameters & migrate secrets'. CI check triggered.",
          latency: 410,
          tokens: 540,
          tools: ["octokit_github_api", "git_commit_bot"],
          guardrail: "PASS (Branch protected)"
        }
      ]
    },
    rag: {
      title: "Multi-Doc Financial RAG",
      defaultInput: "Compare Q3 EBITDA performance across Samsung SDS and competitor enterprise reports",
      nodes: [
        {
          id: "rag_1",
          name: "Query Intent & Router Agent",
          role: "Query Decomposer & Vector Index Selection",
          icon: "🔀",
          prompt: "Extract date ranges, financial metrics (EBITDA, Operating Income), and target corporate entities.",
          output: "Decomposed query into 2 vector searches: [Samsung_SDS_Q3_2025_Report] and [Competitor_Peer_Benchmark_2025].",
          latency: 190,
          tokens: 280,
          tools: ["intent_decomposer", "hybrid_router"],
          guardrail: "PASS"
        },
        {
          id: "rag_2",
          name: "Hybrid Vector & BM25 Retriever",
          role: "Pinecone / Qdrant Dense & Sparse Retrieval",
          icon: "📚",
          prompt: "Retrieve top-k=6 chunk embeddings using BGE-M3 model with dense cosine similarity & BM25 keyword matching.",
          output: "Retrieved 6 chunks (avg similarity score: 0.892). Filtered out duplicate disclaimer sections.",
          latency: 350,
          tokens: 1420,
          tools: ["bge_m3_embedder", "qdrant_vector_db"],
          guardrail: "PASS (Rerank score > 0.85)"
        },
        {
          id: "rag_3",
          name: "Ragas Fact Validator Agent",
          role: "Context Precision & Hallucination Guard",
          icon: "⚖️",
          prompt: "Check context faithfulness: Ensure retrieved numerical values (14.2% YoY growth vs $1.8B) map directly to cited source pages.",
          output: "Faithfulness metric score: 0.98. Zero hallucinated claims detected. 100% of generated statements backed by source citations.",
          latency: 610,
          tokens: 950,
          tools: ["ragas_evaluator", "fact_verifier"],
          guardrail: "PASS (Faithfulness: 0.98)"
        },
        {
          id: "rag_4",
          name: "Executive Report Synthesizer",
          role: "Markdown & Data Table Formatter",
          icon: "📝",
          prompt: "Synthesize structured financial comparison table with citation footnotes and executive key takeaways.",
          output: "Generated executive summary with 1 comparison table, 4 inline page references, and risk factor disclaimers.",
          latency: 780,
          tokens: 1640,
          tools: ["markdown_table_gen", "citation_linker"],
          guardrail: "PASS"
        }
      ]
    },
    voice: {
      title: "Voice AI Customer Support",
      defaultInput: "User Audio Input: 'I need to upgrade my enterprise Cloud AI tier and get billing invoice'",
      nodes: [
        {
          id: "voice_1",
          name: "Whisper STT Transcriber",
          role: "Streaming Speech-To-Text Processor",
          icon: "🎙️",
          prompt: "Convert audio input stream to text tokens with entity identification and speech confidence estimation.",
          output: "Transcribed text: 'I need to upgrade my enterprise Cloud AI tier and get billing invoice' (Audio SNR: 32dB, STT Confidence: 99.1%).",
          latency: 310,
          tokens: 180,
          tools: ["whisper_v3_turbo", "vad_audio_filter"],
          guardrail: "PASS"
        },
        {
          id: "voice_2",
          name: "Intent Classifier & API Tool Agent",
          role: "Stripe Billing & Account Manager API",
          icon: "⚙️",
          prompt: "Match intent: UPGRADE_TIER & FETCH_INVOICE. Invoke Stripe Billing API with account ID 'acc_samsung_881'.",
          output: "Stripe API success: Calculated tier upgrade delta ($450/mo -> $1,200/mo). Generated PDF invoice URL.",
          latency: 480,
          tokens: 610,
          tools: ["stripe_billing_api", "crm_account_lookup"],
          guardrail: "PASS (API Authorized)"
        },
        {
          id: "voice_3",
          name: "Real-time Voice TTS Synthesizer",
          role: "ElevenLabs / Bark Low-Latency Voice Engine",
          icon: "🔊",
          prompt: "Synthesize natural spoken response audio buffer with calm professional tone and low-latency chunk streaming.",
          output: "Generated 4.2 sec PCM audio stream chunk. First audio byte latency: 180ms.",
          latency: 420,
          tokens: 380,
          tools: ["elevenlabs_stream", "audio_pcm_encoder"],
          guardrail: "PASS (Audio Latency < 200ms)"
        }
      ]
    }
  };

  let currentPipelineKey = 'security';
  let activeNodeId = null;
  let isExecuting = false;
  let nodeStates = {};

  // DOM Elements
  const container = document.getElementById('agentNodesContainer');
  const pipelineInput = document.getElementById('pipelineInput') as HTMLInputElement;
  const runBtn = document.getElementById('runPipelineBtn');
  const resetBtn = document.getElementById('resetPipelineBtn');
  const speedSelect = document.getElementById('executionSpeed') as HTMLSelectElement;
  const statusBadge = document.getElementById('pipelineStatusBadge');
  
  const metricLatency = document.getElementById('metricLatency');
  const metricTokens = document.getElementById('metricTokens');
  const metricTools = document.getElementById('metricTools');
  const metricGuardrail = document.getElementById('metricGuardrail');

  const inspectorStepName = document.getElementById('inspectorStepName');
  const inspectorStepStatus = document.getElementById('inspectorStepStatus');
  const inspectorContent = document.getElementById('inspectorContent');
  const copyTraceBtn = document.getElementById('copyTraceBtn');

  // Initialize pipeline view
  function renderPipeline(pipelineKey: string) {
    currentPipelineKey = pipelineKey;
    const pipeline = PIPELINES[pipelineKey];
    if (!pipeline) return;

    if (pipelineInput) {
      pipelineInput.value = pipeline.defaultInput;
    }

    // Reset telemetry & states
    nodeStates = {};
    pipeline.nodes.forEach(n => {
      nodeStates[n.id] = { status: 'idle' }; // idle, running, completed
    });

    updateTelemetry(0, 0, 0, "100%");
    if (statusBadge) {
      statusBadge.textContent = "IDLE — Ready to Execute";
      statusBadge.className = "text-xs font-mono px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-white/5";
    }

    // Render node elements
    if (!container) return;
    container.innerHTML = '';

    pipeline.nodes.forEach((node, index) => {
      const nodeEl = document.createElement('div');
      nodeEl.id = `node-${node.id}`;
      nodeEl.className = `agent-node-card cursor-pointer relative pl-12 p-4 rounded-xl border border-white/10 bg-slate-950/70 hover:bg-slate-900/90 transition-all duration-300 group`;
      nodeEl.setAttribute('data-node-id', node.id);

      nodeEl.innerHTML = `
        <!-- Left Icon Circle -->
        <div class="node-icon-circle absolute left-3 top-4 w-7 h-7 rounded-full bg-slate-900 border border-white/20 text-xs flex items-center justify-center shadow-lg transition-transform group-hover:scale-110">
          ${node.icon}
        </div>

        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-white group-hover:text-cyan-300 transition-colors">Step ${index + 1}: ${node.name}</span>
              <span class="node-status-tag text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-white/5">
                Waiting
              </span>
            </div>
            <p class="text-xs text-slate-400 mt-1">${node.role}</p>
          </div>

          <div class="text-right">
            <span class="text-[10px] font-mono text-slate-400 font-bold block">${node.latency} ms</span>
            <span class="text-[10px] font-mono text-purple-400 block">${node.tokens} tok</span>
          </div>
        </div>
      `;

      nodeEl.addEventListener('click', () => selectNode(node.id));
      container.appendChild(nodeEl);
    });

    // Select first node by default
    selectNode(pipeline.nodes[0].id);
  }

  // Select node in inspector
  function selectNode(nodeId: string) {
    activeNodeId = nodeId;
    const pipeline = PIPELINES[currentPipelineKey];
    const node = pipeline.nodes.find(n => n.id === nodeId);
    if (!node) return;

    // Highlight node in list
    document.querySelectorAll('.agent-node-card').forEach(el => {
      el.classList.remove('border-cyan-500/80', 'bg-cyan-950/20', 'ring-1', 'ring-cyan-500/40');
    });
    const activeEl = document.getElementById(`node-${nodeId}`);
    if (activeEl) {
      activeEl.classList.add('border-cyan-500/80', 'bg-cyan-950/20', 'ring-1', 'ring-cyan-500/40');
    }

    // Populate inspector
    if (inspectorStepName) inspectorStepName.textContent = `${node.name} (${node.id})`;
    
    const state = nodeStates[nodeId]?.status || 'idle';
    if (inspectorStepStatus) {
      inspectorStepStatus.textContent = state.toUpperCase();
      inspectorStepStatus.className = `text-[10px] font-mono px-2 py-0.5 rounded ${
        state === 'completed' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' :
        state === 'running' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 animate-pulse' :
        'bg-slate-800 text-slate-400 border border-white/5'
      }`;
    }

    if (inspectorContent) {
      inspectorContent.innerHTML = `
        <div class="space-y-3">
          <div>
            <div class="text-[10px] text-cyan-400 uppercase font-mono mb-1 font-bold">System Role & Persona:</div>
            <div class="p-2.5 rounded bg-slate-900 border border-white/5 text-slate-300">${node.role}</div>
          </div>

          <div>
            <div class="text-[10px] text-cyan-400 uppercase font-mono mb-1 font-bold">Agent Task Prompt:</div>
            <div class="p-2.5 rounded bg-slate-900 border border-white/5 text-slate-300">${node.prompt}</div>
          </div>

          <div>
            <div class="text-[10px] text-purple-400 uppercase font-mono mb-1 font-bold">Tool Execution & Invocation:</div>
            <div class="flex flex-wrap gap-1.5 mt-1">
              ${node.tools.map(t => `<span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-300 border border-purple-500/20 text-[10px]">${t}</span>`).join('')}
            </div>
          </div>

          <div>
            <div class="text-[10px] text-emerald-400 uppercase font-mono mb-1 font-bold">Output & Execution Result:</div>
            <div class="p-2.5 rounded bg-slate-900 border border-emerald-500/20 text-emerald-300 font-mono text-[11px] leading-relaxed">
              ${state === 'idle' ? '<em>Node not executed yet. Click Execute Pipeline to run.</em>' : node.output}
            </div>
          </div>

          <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px]">
            <span class="text-slate-400 font-mono">Guardrail Status:</span>
            <span class="text-emerald-400 font-bold font-mono">${node.guardrail}</span>
          </div>
        </div>
      `;
    }
  }

  // Update telemetry displays
  function updateTelemetry(latency: number, tokens: number, tools: number, guardrailScore: string) {
    if (metricLatency) metricLatency.textContent = `${latency} ms`;
    if (metricTokens) metricTokens.textContent = `${tokens} tokens`;
    if (metricTools) metricTools.textContent = `${tools} calls`;
    if (metricGuardrail) metricGuardrail.textContent = guardrailScore;
  }

  // Run pipeline simulation step by step
  async function runPipeline() {
    if (isExecuting) return;
    isExecuting = true;
    const pipeline = PIPELINES[currentPipelineKey];
    const speed = parseInt(speedSelect?.value || '1200', 10);

    if (runBtn) {
      runBtn.disabled = true;
      runBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
    if (statusBadge) {
      statusBadge.textContent = "RUNNING — Executing Agent Graph";
      statusBadge.className = "text-xs font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 animate-pulse";
    }

    let accumLatency = 0;
    let accumTokens = 0;
    let accumTools = 0;

    for (let i = 0; i < pipeline.nodes.length; i++) {
      const node = pipeline.nodes[i];
      nodeStates[node.id].status = 'running';

      // Update node UI state
      const nodeEl = document.getElementById(`node-${node.id}`);
      if (nodeEl) {
        const tag = nodeEl.querySelector('.node-status-tag');
        if (tag) {
          tag.textContent = 'EXECUTING';
          tag.className = 'node-status-tag text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 animate-pulse';
        }
        const iconCircle = nodeEl.querySelector('.node-icon-circle');
        if (iconCircle) {
          iconCircle.classList.add('border-cyan-400', 'bg-cyan-950', 'scale-125');
        }
      }

      selectNode(node.id);

      // Simulate delay
      await new Promise(r => setTimeout(r, speed));

      // Complete step
      nodeStates[node.id].status = 'completed';
      accumLatency += node.latency;
      accumTokens += node.tokens;
      accumTools += node.tools.length;

      updateTelemetry(accumLatency, accumTokens, accumTools, "99.8%");

      if (nodeEl) {
        const tag = nodeEl.querySelector('.node-status-tag');
        if (tag) {
          tag.textContent = 'PASSED';
          tag.className = 'node-status-tag text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        }
        const iconCircle = nodeEl.querySelector('.node-icon-circle');
        if (iconCircle) {
          iconCircle.classList.remove('border-cyan-400', 'bg-cyan-950', 'scale-125');
          iconCircle.classList.add('border-emerald-400', 'bg-emerald-950');
        }
      }

      selectNode(node.id);
    }

    if (statusBadge) {
      statusBadge.textContent = "COMPLETED — Pipeline Success";
      statusBadge.className = "text-xs font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
    }

    isExecuting = false;
    if (runBtn) {
      runBtn.disabled = false;
      runBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  }

  // Set up event listeners
  document.addEventListener('astro:page-load', () => {
    // Preset buttons
    document.querySelectorAll('.pipeline-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (isExecuting) return;
        const target = e.currentTarget as HTMLButtonElement;
        const key = target.getAttribute('data-pipeline');
        if (!key) return;

        document.querySelectorAll('.pipeline-preset-btn').forEach(b => {
          b.className = 'pipeline-preset-btn px-4 py-2 rounded-xl text-xs font-medium border transition-all duration-300 bg-white/5 text-slate-400 border-white/10 hover:bg-white/10 hover:text-white';
        });
        target.className = 'pipeline-preset-btn active px-4 py-2 rounded-xl text-xs font-medium border transition-all duration-300 bg-cyan-500/20 text-cyan-300 border-cyan-500/40 shadow-lg shadow-cyan-500/10';

        renderPipeline(key);
      });
    });

    runBtn?.addEventListener('click', runPipeline);

    resetBtn?.addEventListener('click', () => {
      if (isExecuting) return;
      renderPipeline(currentPipelineKey);
    });

    copyTraceBtn?.addEventListener('click', () => {
      const pipeline = PIPELINES[currentPipelineKey];
      const tracePayload = {
        pipeline: pipeline.title,
        timestamp: new Date().toISOString(),
        nodesExecuted: pipeline.nodes,
        telemetry: {
          totalLatencyMs: metricLatency?.textContent,
          totalTokens: metricTokens?.textContent,
          totalToolCalls: metricTools?.textContent,
          guardrailScore: metricGuardrail?.textContent
        }
      };
      navigator.clipboard.writeText(JSON.stringify(tracePayload, null, 2));
      const originalText = copyTraceBtn.textContent;
      copyTraceBtn.textContent = "✓ Copied Trace JSON to Clipboard!";
      setTimeout(() => {
        if (copyTraceBtn) copyTraceBtn.textContent = originalText;
      }, 2000);
    });

    // Initial render
    renderPipeline('security');
  });
</script>
