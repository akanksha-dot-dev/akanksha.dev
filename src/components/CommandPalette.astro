    <!-- Search Bar Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-white/10 bg-white/[0.02]">
      <svg class="w-5 h-5 text-cyan-400 shrink-0 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input 
        id="cmd-k-input" 
        type="text" 
        placeholder="Type a command or search portfolio (e.g. Agents, RAG, Samsung SDS)..." 
        class="w-full bg-transparent text-slate-100 placeholder-slate-400 text-sm md:text-base focus:outline-none font-(--font-body)"
        autocomplete="off"
        spellcheck="false"
      />
      <button id="cmd-k-close" class="px-2 py-1 text-xs text-slate-400 hover:text-white bg-white/5 rounded border border-white/10 transition-colors shrink-0 ml-2" aria-label="Close command palette">
        ESC
      </button>
    </div>

    <!-- Command Results Container -->
    <div id="cmd-k-results" class="max-h-[60vh] overflow-y-auto p-2 divide-y divide-white/5">
      <!-- Section: Navigation -->
      <div class="py-2" data-section="Navigation">
