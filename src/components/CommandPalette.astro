<script>
  function setupCommandPalette() {
    const modal = document.getElementById('cmd-k-modal');
    const backdrop = document.getElementById('cmd-k-backdrop');
    const closeBtn = document.getElementById('cmd-k-close');
    const input = document.getElementById('cmd-k-input') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.cmd-k-item'));
    let activeIndex = -1;

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        input?.focus();
        input?.select();
      }, 50);
      resetActive();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      if (input) input.value = '';
      filterItems('');
    }

    function resetActive() {
      items.forEach(el => el.classList.remove('bg-white/15', 'border-cyan-500/40'));
      activeIndex = -1;
    }

    function updateActive(index: number) {
      const visibleItems = items.filter(el => !el.classList.contains('hidden'));
      if (visibleItems.length === 0) return;

      if (index < 0) index = visibleItems.length - 1;
      if (index >= visibleItems.length) index = 0;

      visibleItems.forEach(el => el.classList.remove('bg-white/15', 'border-cyan-500/40'));
      const target = visibleItems[index];
      if (target) {
        target.classList.add('bg-white/15');
        target.scrollIntoView({ block: 'nearest' });
      }
      activeIndex = index;
    }

    function filterItems(query: string) {
      const q = query.toLowerCase().trim();
      items.forEach(item => {
        const searchTerms = (item.dataset.search || '') + ' ' + (item.textContent || '');
        if (!q || searchTerms.toLowerCase().includes(q)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
      resetActive();
    }

    // Event listeners
    document.addEventListener('keydown', (e) => {
      // Cmd+K or Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      } else if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      } else if (!modal?.classList.contains('hidden')) {
        const visibleItems = items.filter(el => !el.classList.contains('hidden'));
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          updateActive(activeIndex + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          updateActive(activeIndex - 1);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && activeIndex < visibleItems.length) {
            visibleItems[activeIndex].click();
          }
        }
      }
    });

    // Input filtering
    input?.addEventListener('input', (e) => {
      filterItems((e.target as HTMLInputElement).value);
    });

    // Triggers
    document.querySelectorAll('[data-cmd-k-trigger]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Close button & backdrop
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Item click closing
    items.forEach(item => {
      item.addEventListener('click', (e) => {
        const prompt = item.dataset.prompt;
        if (prompt) {
          // If it's an AI prompt item, dispatch event for AI Assistant if open or redirect to contact/assistant
          const event = new CustomEvent('open-ai-prompt', { detail: { prompt } });
          window.dispatchEvent(event);
        }
        closeModal();
      });
    });
  }

  // Run on initial load and view transition swap
  setupCommandPalette();
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>
