          log: "Linked ADK to MCP tool interfaces", 
          inspect: "Resolved tool calling schemas for Model Context Protocol (MCP) server endpoints.",
          payload: `{\n  "mcp_server": "localhost:8080/mcp",\n  "registered_tools": ["search_db", "verify_json", "generate_patch"],\n  "protocol": "2025-11-25"\n}`,
          stats: ["Latency: 32ms", "MCP Tools: 4", "Schemas: JSON-RPC"] 
        },
        { 
          label: "Inference", 
          log: "Synthesized multi-agent architecture blueprint", 
          inspect: "Compiled step-by-step state transition diagram for Google ADK squad.",
          payload: `{\n  "orchestrator": "Google-ADK-DAG",\n  "verification_gate": "Strict-Typing",\n  "manual_effort_delta": "-60%",\n  "production_ready": true\n}`,
          stats: ["Latency: 130ms", "Tokens: 310", "Pass Rate: 99.4%"] 
        }
      ],
      output: `Google ADK Multi-Agent Orchestration Architecture:\n\n` +
              `• **State Machine:** Directed Acyclic Graph (DAG) state coordinator managing task decomposition.\n` +
              `• **MCP Protocol:** Standardized tool-use hooks for external API execution and local sandboxes.\n` +
              `• **Efficiency Impact:** **60% reduction in manual effort** in enterprise content and QA pipelines.`,
      latency: "207 ms",
      matches: "3 Patterns + 4 MCP Schemas",
      score: "0.98 / 1.0 (RAGAS)"
    }
  };

  const agentLogs = {
    content: [
      "[0.00s] Initializing Google ADK Agent Cluster...",
      "[0.12s] State Node 1: Planner Agent decomposing objective into 3 sub-tasks",
      "[0.34s] State Node 2: Research Agent calling MCP tool 'search_knowledge_graph'...",
      "[0.65s] MCP Tool Result: Retrieved 12 entity triplets from Neo4j",
      "[0.92s] State Node 3: Drafter Agent generating structured Markdown with citations",
      "[1.34s] State Node 4: Critic Agent executing RAGAS evaluation harness...",
      "[1.65s] Verification Passed: Groundedness = 0.98, Hallucination = 0.00",
      "[1.85s] ✅ Objective Complete! Generated SEO-validated article with 0 human edits needed."
    ],
    qa: [
      "[0.00s] Initializing o9 Platform QA Automation Engine...",
      "[0.15s] State Node 1: Ingesting JSON schemas from test and staging instances",
      "[0.42s] State Node 2: AST schema differ running deep reconciliation...",
      "[0.78s] Detected 2 schema drift discrepancies in supply chain planning tables",
      "[1.12s] State Node 3: Patch Agent formulating verified JSON Schema update payload",
      "[1.50s] State Node 4: Executing PyTest validation suite on local sandbox...",
      "[1.88s] Verification Passed: All 48 assertions succeeded (100% schema match)",
      "[2.10s] ✅ QA Check Complete! Generated differential test report and patch advisory."
    ],
    jira: [
      "[0.00s] Initializing Productivity Analyzer Agent...",
      "[0.18s] State Node 1: Authenticating to Jira & Confluence REST endpoints",
      "[0.55s] State Node 2: Ingested 34 engineering sprint issues and daily worklogs",
      "[0.88s] State Node 3: Graph RAG summarizer analyzing sprint velocity and blockers",
      "[1.32s] State Node 4: Guardrail evaluating sprint risk matrix...",
      "[1.70s] Output Formatted: Weekly executive summary ready for squad leads",
      "[1.95s] ✅ Report Complete! Automated delivery configured via SMTP worker."
    ]
  };

  let activeStreamTimeout: any = null;
  let activeTerminalTimeout: any = null;

  function setupSandbox() {
    const container = document.getElementById('ai-sandbox-container');
    if (!container) return;

    const playSound = (window as any).__AK_PLAY_SOUND__ || (() => {});

    // Tabs
    const btnRagTab = document.getElementById('btn-rag-tab');
    const btnAgentTab = document.getElementById('btn-agent-tab');
    const ragPanel = document.getElementById('rag-panel');
    const agentPanel = document.getElementById('agent-panel');
    const btnAutoDemo = document.getElementById('btn-auto-demo');

    btnRagTab?.addEventListener('click', () => {
      playSound('click');
      btnRagTab.classList.add('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnRagTab.classList.remove('text-(--color-text-secondary)', 'border-transparent');
      btnRagTab.setAttribute('aria-selected', 'true');

      btnAgentTab?.classList.remove('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnAgentTab?.classList.add('text-(--color-text-secondary)', 'border-transparent');
      btnAgentTab?.setAttribute('aria-selected', 'false');

      ragPanel?.classList.remove('hidden');
      agentPanel?.classList.add('hidden');
    });

    btnAgentTab?.addEventListener('click', () => {
      playSound('click');
      btnAgentTab.classList.add('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnAgentTab.classList.remove('text-(--color-text-secondary)', 'border-transparent');
      btnAgentTab.setAttribute('aria-selected', 'true');

      btnRagTab?.classList.remove('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnRagTab?.classList.add('text-(--color-text-secondary)', 'border-transparent');
      btnRagTab?.setAttribute('aria-selected', 'false');

      agentPanel?.classList.remove('hidden');
      ragPanel?.classList.add('hidden');
    });

    // RAG Pipeline Simulation
    const btnRunRag = document.getElementById('btn-run-rag');
    const selectRagQuery = document.getElementById('rag-query-select') as HTMLSelectElement | null;
    const outputRagText = document.getElementById('rag-output-text');
    const logLatency = document.getElementById('rag-log-latency');
    const logMatches = document.getElementById('rag-log-matches');
    const logScore = document.getElementById('rag-log-score');
    const stepBoxes = document.querySelectorAll('.rag-step-box');
    const toggleRouter = document.getElementById('toggle-router') as HTMLInputElement | null;
    const toggleGuardrails = document.getElementById('toggle-guardrails') as HTMLInputElement | null;
    const bannerDegraded = document.getElementById('rag-degraded-banner');

    // Inspector Pane
    const inspectPane = document.getElementById('step-inspect-pane');
    const inspectTitle = document.getElementById('inspect-node-title');
    const inspectDesc = document.getElementById('inspect-node-desc');
    const inspectPayload = document.getElementById('inspect-node-payload');
    const inspectStats = document.getElementById('inspect-node-stats');
    const btnCloseInspect = document.getElementById('btn-close-inspect');

    btnCloseInspect?.addEventListener('click', () => {
      playSound('click');
      inspectPane?.classList.add('hidden');
    });

    function checkDegradation() {
      const isRouterOn = toggleRouter ? toggleRouter.checked : true;
      const isGuardrailsOn = toggleGuardrails ? toggleGuardrails.checked : true;
      if (!isRouterOn || !isGuardrailsOn) {
        bannerDegraded?.classList.remove('hidden');
      } else {
        bannerDegraded?.classList.add('hidden');
      }
    }

    toggleRouter?.addEventListener('change', () => {
      playSound('click');
      checkDegradation();
    });

    toggleGuardrails?.addEventListener('change', () => {
      playSound('click');
      checkDegradation();
    });

    function runRagSimulation() {
      if (activeStreamTimeout) clearTimeout(activeStreamTimeout);
      playSound('click');
      const queryKey = selectRagQuery?.value || 'revenue';
      const data = ragResponses[queryKey as keyof typeof ragResponses];
      const isRouterOn = toggleRouter ? toggleRouter.checked : true;
      const isGuardrailsOn = toggleGuardrails ? toggleGuardrails.checked : true;

      // Reset step boxes
      stepBoxes.forEach((box) => {
        box.classList.remove('border-(--color-teal)', 'bg-teal-500/10', 'border-red-500/50', 'bg-red-500/10');
        box.classList.add('opacity-50', 'border-(--color-border)');
        const badge = box.querySelector('.step-badge');
        if (badge) {
          badge.textContent = 'QUEUED';
          badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-(--color-text-muted) bg-white/5 border border-white/10';
        }
      });

      if (outputRagText) {
        outputRagText.innerHTML = '<span class="text-(--color-teal) font-mono animate-pulse">Initializing pipeline nodes & vector indexing...</span>';
      }

      // Step-by-step progression animation
      data.steps.forEach((st, idx) => {
        setTimeout(() => {
          const box = stepBoxes[idx];
          if (!box) return;

          playSound('node');
          box.classList.remove('opacity-50', 'border-(--color-border)');
          const logEl = box.querySelector(`#rag-step${idx + 1}-log`);
          const badge = box.querySelector('.step-badge');

          if ((!isRouterOn && idx === 1) || (!isGuardrailsOn && idx === 3)) {
            // Degraded path
            box.classList.add('border-red-500/60', 'bg-red-500/10');
            if (badge) {
              badge.textContent = 'DEGRADED';
              badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-red-400 bg-red-500/20 border border-red-500/30';
            }
            if (logEl) logEl.textContent = idx === 1 ? 'Unrouted vector match (diluted context)' : 'Unverified generation (hallucination risk)';
          } else {
            box.classList.add('border-(--color-teal)', 'bg-teal-500/10');
            if (badge) {
              badge.textContent = 'DONE';
              badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-(--color-teal) bg-teal-500/20 border border-teal-500/30';
            }
            if (logEl) logEl.textContent = st.log;
          }
        }, idx * 250);
      });

      // Stream text output
      setTimeout(() => {
        if (!outputRagText) return;
        playSound('success');
        if (!isRouterOn || !isGuardrailsOn) {
          outputRagText.innerHTML = `
            <div class="text-red-300 font-mono text-xs mb-2">⚠️ WARNING: Guardrails or Semantic Router disabled. Output contains hallucinated values:</div>
            <div class="text-(--color-text-secondary) font-sans">${data.output.replace(/92%/g, '<span class="text-red-400 font-mono font-bold line-through">92%</span> <span class="text-red-300 font-bold">58% (degraded)</span>').replace(/240ms/g, '<span class="text-red-400 font-mono line-through">240ms</span> <span class="text-red-300">680ms (context bloat)</span>')}</div>
          `;
          if (logLatency) logLatency.textContent = '680 ms (slow)';
          if (logMatches) logMatches.textContent = '14 Unfiltered Chunks';
          if (logScore) logScore.textContent = '0.58 / 1.0 (Degraded)';
        } else {
          // Clean output
          outputRagText.innerHTML = data.output.replace(/\n/g, '<br/>');
          if (logLatency) logLatency.textContent = data.latency;
          if (logMatches) logMatches.textContent = data.matches;
          if (logScore) logScore.textContent = data.score;
        }
      }, 1100);
    }

    btnRunRag?.addEventListener('click', runRagSimulation);

    // Auto-Demo Simulation
    btnAutoDemo?.addEventListener('click', () => {
      playSound('agent');
      if (selectRagQuery) {
        selectRagQuery.value = 'accuracy';
      }
      runRagSimulation();
    });

    // Node click handlers for telemetry inspection
    stepBoxes.forEach((box, i) => {
      box.addEventListener('click', () => {
        playSound('click');
        const queryKey = selectRagQuery?.value || 'revenue';
        const data = ragResponses[queryKey as keyof typeof ragResponses];
        const stepData = data.steps[i];
        if (!stepData || !inspectPane) return;

        if (inspectTitle) inspectTitle.textContent = `🔍 0${i + 1}. ${stepData.label} — Node Telemetry Inspector`;
        if (inspectDesc) inspectDesc.textContent = stepData.inspect;
        if (inspectPayload) inspectPayload.textContent = stepData.payload;
        if (inspectStats) {
          inspectStats.innerHTML = stepData.stats.map(s => `<span class="px-2 py-1 rounded bg-white/5 border border-white/10 text-(--color-teal)">${s}</span>`).join('');
        }
        inspectPane.classList.remove('hidden');
      });
    });

    // Copy Synthesis
    const btnCopyRag = document.getElementById('btn-copy-rag');
    const copyRagLabel = document.getElementById('copy-rag-label');
    btnCopyRag?.addEventListener('click', () => {
      playSound('click');
      const text = outputRagText?.innerText || '';
      navigator.clipboard.writeText(text).then(() => {
        if (copyRagLabel) copyRagLabel.textContent = 'Copied!';
        setTimeout(() => {
          if (copyRagLabel) copyRagLabel.textContent = 'Copy Synthesis';
        }, 2000);
      });
    });

    // Agent Simulation
    const btnRunAgent = document.getElementById('btn-run-agent');
    const selectAgentTask = document.getElementById('agent-task-select') as HTMLSelectElement | null;
    const terminalEl = document.getElementById('agent-terminal');
    const statCycles = document.getElementById('agent-stat-cycles');
    const statTools = document.getElementById('agent-stat-tools');
    const statStatus = document.getElementById('agent-stat-status');
    const btnCopyAgent = document.getElementById('btn-copy-agent');
    const copyAgentLabel = document.getElementById('copy-agent-label');

    function runAgentSimulation() {
      if (activeTerminalTimeout) clearTimeout(activeTerminalTimeout);
      playSound('click');
      const taskKey = selectAgentTask?.value || 'content';
      const logs = agentLogs[taskKey as keyof typeof agentLogs];
      if (!terminalEl) return;

      terminalEl.innerHTML = '';
      if (statCycles) statCycles.textContent = 'Running...';
      if (statTools) statTools.textContent = 'Searching...';
      if (statStatus) statStatus.textContent = 'Evaluating...';

      logs.forEach((line, idx) => {
        setTimeout(() => {
          playSound('node');
          const div = document.createElement('div');
          div.className = line.includes('✅') ? 'text-teal-300 font-bold' : line.includes('MCP') ? 'text-amber-300' : 'text-emerald-400';
          div.textContent = line;
          terminalEl.appendChild(div);
          terminalEl.scrollTop = terminalEl.scrollHeight;

          if (idx === logs.length - 1) {
            playSound('success');
            if (statCycles) statCycles.textContent = '4 Cycles';
            if (statTools) statTools.textContent = taskKey === 'content' ? '3 Tools (MCP)' : taskKey === 'qa' ? '2 Tools (PyTest)' : '2 Tools (Jira)';
            if (statStatus) statStatus.textContent = '99.4% (Pass)';
          }
        }, idx * 280);
      });
    }

    btnRunAgent?.addEventListener('click', runAgentSimulation);

    btnCopyAgent?.addEventListener('click', () => {
      playSound('click');
      const text = terminalEl?.innerText || '';
      navigator.clipboard.writeText(text).then(() => {
        if (copyAgentLabel) copyAgentLabel.textContent = 'Copied!';
        setTimeout(() => {
          if (copyAgentLabel) copyAgentLabel.textContent = 'Copy Logs';
        }, 2000);
      });
    });

    // Run initial simulation on load
    runRagSimulation();
  }

  setupSandbox();
  document.addEventListener('astro:page-load', setupSandbox);
</script>
