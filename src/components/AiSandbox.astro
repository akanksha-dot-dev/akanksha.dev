---
// src/components/AiSandbox.astro — Production AI Architecture Sandbox 3.0 (Full-Width Responsive)
---

<div class="glass-static p-6 sm:p-8 relative overflow-hidden fade-in border border-(--color-border) bg-(--color-surface) rounded-2xl w-full" id="ai-sandbox-container">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-24 -left-24 w-64 h-64 rounded-full bg-(--color-teal-glow) filter blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-64 h-64 rounded-full bg-(--color-amber-glow) filter blur-3xl pointer-events-none"></div>

  <!-- Component Top Navigation & Mode Switcher -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-(--color-border) relative z-10">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-(--color-teal) animate-pulse"></span>
        <h3 class="font-(--font-heading) font-extrabold text-lg sm:text-xl text-white tracking-tight">
          Interactive <span class="gradient-text">AI Architecture Sandbox</span>
        </h3>
      </div>
      <p class="text-xs text-(--color-text-secondary) font-(--font-mono) mt-1">
        Production-grade execution pipeline, DAG node telemetry & guardrail simulator
      </p>
    </div>
    
    <!-- Tab Switches -->
    <div class="flex p-1 bg-[#080E1E] border border-(--color-border) rounded-xl self-start sm:self-auto" role="tablist" aria-label="Pipeline Simulator Tabs">
      <button 
        type="button"
        id="btn-rag-tab" 
        role="tab"
        aria-selected="true"
        aria-controls="rag-panel"
        class="px-4 py-2 text-xs font-(--font-mono) font-semibold rounded-lg transition-all cursor-pointer bg-(--color-teal-glow) text-(--color-teal) border border-teal-500/40 shadow-sm"
      >
        ⚡ Enterprise Graph RAG
      </button>
      <button 
        type="button"
        id="btn-agent-tab" 
        role="tab"
        aria-selected="false"
        aria-controls="agent-panel"
        class="px-4 py-2 text-xs font-(--font-mono) font-semibold rounded-lg transition-all cursor-pointer text-(--color-text-secondary) hover:text-white border border-transparent"
      >
        🤖 Agent Loop (Google ADK)
      </button>
    </div>
  </div>

  <div class="relative z-10 min-h-[440px] flex flex-col">
    <!-- ═══ RAG VISUALIZER PANEL ═══ -->
    <div id="rag-panel" role="tabpanel" aria-labelledby="btn-rag-tab" class="flex flex-col gap-6 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Main Area (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          <!-- Workload Selector & Run Action -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <label for="rag-query-select" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Select Enterprise Query Workload
              </label>
              <span class="text-[11px] font-(--font-mono) text-(--color-teal) bg-teal-500/10 border border-teal-500/20 px-2 py-0.5 rounded">
                Samsung SDS Cluster
              </span>
            </div>
            <div class="flex flex-col sm:flex-row gap-2.5">
              <select 
                id="rag-query-select" 
                class="bg-[#080E1E] border border-(--color-border) px-3.5 py-2.5 text-xs rounded-xl flex-1 text-white font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) shadow-inner"
              >
                <option value="revenue">"Analyze Samsung SDS Q4 Net Income & retrieval precision"</option>
                <option value="accuracy">"Assess RAG accuracy over 200-page annual financial statements"</option>
                <option value="agents">"Explain Google ADK multi-agent state mapping patterns"</option>
              </select>
              <button 
                type="button"
                id="btn-run-rag" 
                class="btn-primary text-xs py-2.5 px-6 whitespace-nowrap cursor-pointer hover:scale-[1.02] transition-transform flex items-center justify-center gap-2 shadow-[0_0_16px_rgba(0,240,181,0.3)] shrink-0"
              >
                <span>▶ Run Pipeline</span>
              </button>
            </div>
          </div>

          <!-- Degradation Warning Banner (Shown when router is toggled OFF) -->
          <div id="rag-degraded-banner" class="hidden glass-static p-4 rounded-xl border border-red-500/40 bg-red-500/10 text-xs text-red-200 flex items-start gap-3 animate-fadeIn">
            <span class="text-red-400 text-lg shrink-0">⚠️</span>
            <div>
              <span class="font-bold font-(--font-mono) text-red-300 block text-xs">ARCHITECTURAL DEGRADATION SIMULATED</span>
              <p class="text-[0.72rem] text-red-200/90 leading-relaxed mt-0.5">
                Semantic Router Node is disabled. Raw vector similarity without intent classification causes context dilution, token bloat, and hallucinated table interpretations.
              </p>
            </div>
          </div>

          <!-- Interactive Pipeline Visual Flow Nodes -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Execution Flow Nodes (Click any node to inspect telemetry)
              </span>
              <span class="text-[10px] font-(--font-mono) text-(--color-text-muted)">4 Stages Active</span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 relative z-10" id="rag-steps-container">
              <!-- Step 1 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="1"
                title="Click to inspect Segmentation node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">01. SEGMENT</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step1-log">Awaiting launch...</div>
              </button>

              <!-- Step 2 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="2"
                title="Click to inspect FAISS Vector Search node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">02. FAISS SEARCH</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step2-log">Awaiting launch...</div>
              </button>

              <!-- Step 3 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="3"
                title="Click to inspect Graph Enrich node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">03. GRAPH ENRICH</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step3-log">Awaiting launch...</div>
              </button>

              <!-- Step 4 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="4"
                title="Click to inspect LLM Inference node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">04. INFERENCE</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step4-log">Awaiting launch...</div>
              </button>
            </div>
          </div>

          <!-- Step Deep-Inspection Pane (Interactive) -->
          <div id="step-inspect-pane" class="hidden glass-static p-4 rounded-xl border border-(--color-teal)/40 bg-[#080E1E]/90 text-xs font-(--font-mono) flex flex-col gap-2 animate-fadeIn">
            <div class="flex items-center justify-between text-(--color-teal)">
              <span class="font-bold flex items-center gap-1.5" id="inspect-node-title">🔍 Node Telemetry Inspector</span>
              <button type="button" id="btn-close-inspect" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs cursor-pointer px-2 py-0.5 rounded bg-white/5 border border-white/10">✕ Close</button>
            </div>
            <p id="inspect-node-desc" class="text-xs text-(--color-text-secondary) leading-relaxed"></p>
            <div id="inspect-node-stats" class="flex flex-wrap gap-4 pt-2 text-[11px] text-(--color-text-muted) border-t border-white/5 font-(--font-mono)"></div>
          </div>

          <!-- Streamed Synthesis Box -->
          <div class="border border-(--color-border) bg-[#080E1E]/60 p-5 rounded-xl flex-1 flex flex-col gap-3 min-h-[160px] relative shadow-inner">
            <div class="flex items-center justify-between border-b border-white/5 pb-2.5">
              <span class="text-xs font-(--font-mono) text-(--color-teal) uppercase tracking-wider font-semibold flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-(--color-teal) animate-pulse"></span>
                Synthesized Output (Streamed Response)
              </span>
              <button 
                type="button" 
                id="btn-copy-rag" 
                class="text-xs font-(--font-mono) text-(--color-text-secondary) hover:text-(--color-teal) flex items-center gap-1.5 cursor-pointer transition-colors px-2.5 py-1 rounded-lg border border-white/5 hover:border-(--color-teal)/40 bg-white/5"
                title="Copy synthesized output"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-rag-label">Copy Synthesis</span>
              </button>
            </div>
            <div id="rag-output-text" class="text-xs sm:text-sm text-(--color-text-primary) leading-relaxed font-sans" aria-live="polite">
              Select an enterprise query above and run the pipeline to visualize real-time RAG execution.
            </div>
          </div>
        </div>

        <!-- Sidebar Status & Controls (4 cols) -->
        <div class="lg:col-span-4 flex flex-col gap-4">
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>Architecture Controls</span>
            <span class="text-[10px] text-(--color-teal)">Live Node</span>
          </span>
          
          <!-- Semantic Router Switch -->
          <div class="glass-static p-4 flex flex-col gap-2.5 border border-(--color-border) bg-[#080E1E]/60 rounded-xl">
            <div class="flex items-center justify-between">
              <span class="text-xs font-(--font-mono) text-white font-semibold flex items-center gap-1.5">
                Semantic Router
                <span class="text-[10px] text-teal-400 font-mono" title="Routes queries dynamically based on semantic intent">ℹ</span>
              </span>
              <label class="relative inline-flex items-center cursor-pointer" aria-label="Toggle Semantic Router Node">
                <input type="checkbox" id="toggle-router" class="sr-only peer" checked>
                <div class="w-9 h-5 bg-red-500/40 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-(--color-teal)"></div>
              </label>
            </div>
            <p class="text-[11px] text-(--color-text-secondary) font-(--font-mono) leading-relaxed">
              Guarantees 92% retrieval precision. Toggle OFF to test hallucination degradation.
            </p>
          </div>

          <!-- Pipeline Telemetry Box -->
          <div class="glass-static p-4 sm:p-5 flex flex-col gap-3.5 font-(--font-mono) bg-[#080E1E]/60 border border-(--color-border) rounded-xl">
            <div class="flex justify-between items-center pb-2.5 border-b border-white/5">
              <span class="text-xs text-(--color-text-muted) uppercase tracking-wider font-semibold">PIPELINE TELEMETRY</span>
              <span class="text-[10px] text-(--color-teal) font-semibold px-2 py-0.5 rounded bg-teal-500/10 border border-teal-500/20">VALIDATED</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">LATENCY DELTA</span>
              <span id="rag-log-latency" class="text-base font-bold text-(--color-teal)">0.00 ms</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">RETRIEVAL MATCHES</span>
              <span id="rag-log-matches" class="text-base font-bold text-(--color-teal)">-</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">RAGAS RELEVANCE SCORE</span>
              <span id="rag-log-score" class="text-base font-bold text-(--color-amber)">-</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ AGENT ORCHESTRATION PANEL ═══ -->
    <div id="agent-panel" role="tabpanel" aria-labelledby="btn-agent-tab" class="hidden flex flex-col gap-6 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Main Area (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          <!-- Objective Selector -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <label for="agent-task-select" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Select Autonomous Agent Objective
              </label>
              <span class="text-[11px] font-(--font-mono) text-(--color-teal) bg-teal-500/10 border border-teal-500/20 px-2 py-0.5 rounded">
                Google ADK Core
              </span>
            </div>
            <div class="flex flex-col sm:flex-row gap-2.5">
              <select 
                id="agent-task-select" 
                class="bg-[#080E1E] border border-(--color-border) px-3.5 py-2.5 text-xs rounded-xl flex-1 text-white font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) shadow-inner"
              >
                <option value="content">"Generate & evaluate SEO validated article about Graph RAG"</option>
                <option value="qa">"Analyze JSON schema comparisons across o9 test instances"</option>
                <option value="jira">"Extract work logs and generate JIRA story sprint reports"</option>
              </select>
              <button 
                type="button"
                id="btn-run-agent" 
                class="btn-primary text-xs py-2.5 px-6 whitespace-nowrap cursor-pointer hover:scale-[1.02] transition-transform flex items-center justify-center gap-2 shadow-[0_0_16px_rgba(0,240,181,0.3)] shrink-0"
              >
                <span>🚀 Launch Agent</span>
              </button>
            </div>
          </div>

          <!-- Console Terminal -->
          <div class="border border-(--color-border) bg-[#030712] p-5 rounded-xl font-(--font-mono) flex-1 min-h-[260px] flex flex-col gap-2 shadow-2xl">
            <div class="flex items-center justify-between pb-3 border-b border-white/10">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                <span class="text-xs text-(--color-text-muted) ml-2">akanksha@adk-node:~$</span>
              </div>
              <button 
                type="button" 
                id="btn-copy-agent" 
                class="text-xs font-(--font-mono) text-(--color-text-secondary) hover:text-(--color-teal) flex items-center gap-1.5 cursor-pointer transition-colors px-2.5 py-1 rounded border border-white/10 bg-white/5"
                title="Copy terminal logs"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-agent-label">Copy Logs</span>
              </button>
            </div>
            <div id="agent-terminal" class="text-xs text-emerald-400 leading-relaxed overflow-y-auto max-h-[220px] space-y-1.5" aria-live="polite">
              <span class="text-(--color-text-muted)">Ready to initialize. Select an objective and launch the agent.</span>
            </div>
          </div>
        </div>

        <!-- Sidebar Status & Checks (4 cols) -->
        <div class="lg:col-span-4 flex flex-col gap-4">
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>Safety & Guardrails</span>
            <span class="text-[10px] text-(--color-teal)">Active Harness</span>
          </span>
          
          <div class="glass-static p-4 flex flex-col gap-2.5 border border-(--color-border) bg-[#080E1E]/60 rounded-xl">
            <div class="flex items-center justify-between">
              <span class="text-xs font-(--font-mono) text-white font-semibold flex items-center gap-1.5">
                RAGAS Guardrails
                <span class="text-[10px] text-teal-400 font-mono" title="Scores groundedness & alignment against hallucination">ℹ</span>
              </span>
              <label class="relative inline-flex items-center cursor-pointer" aria-label="Toggle RAGAS Guardrails Node">
                <input type="checkbox" id="toggle-guardrails" class="sr-only peer" checked>
                <div class="w-9 h-5 bg-red-500/40 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-(--color-teal)"></div>
              </label>
            </div>
            <p class="text-[11px] text-(--color-text-secondary) font-(--font-mono) leading-relaxed">
              Enforces structured schema validation & anti-hallucination verification before agent execution.
            </p>
          </div>

          <div class="glass-static p-4 sm:p-5 flex flex-col gap-3.5 font-(--font-mono) bg-[#080E1E]/60 border border-(--color-border) rounded-xl">
            <div class="flex justify-between items-center pb-2.5 border-b border-white/5">
              <span class="text-xs text-(--color-text-muted) uppercase tracking-wider font-semibold">AGENT TELEMETRY</span>
              <span class="text-[10px] text-(--color-amber) font-semibold px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/20">STATEFUL</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">EXECUTION CYCLES</span>
              <span id="agent-stat-cycles" class="text-base font-bold text-(--color-teal)">0 Loops</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">MCP TOOLS INVOKED</span>
              <span id="agent-stat-tools" class="text-base font-bold text-(--color-teal)">0 Tools</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">VERIFICATION PASS RATE</span>
              <span id="agent-stat-status" class="text-base font-bold text-(--color-amber)">-</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Simulation Data
  const ragResponses = {
    revenue: {
      steps: [
        { label: "Segment", log: "Parsed FY25 Q4 statements (Table Extraction)", inspect: "Layout parser segmented 200 pages into 14 financial tables using GMFT table detection.", stats: ["Latency: 42ms", "Chunks: 14", "Parser: GMFT Layout"] },
        { label: "FAISS Search", log: "Retrieved 4 chunks via vector similarity", inspect: "FAISS HNSW index queried with embedding cosine similarity >= 0.88.", stats: ["Latency: 18ms", "Index: HNSW32", "Embedding: text-embedding-3"] },
        { label: "Graph Enrich", log: "Graph enriched: linked Net Income to Revenue nodes", inspect: "Neo4j Knowledge Graph matched entity 'Samsung SDS' to subsidiary revenue streams.", stats: ["Latency: 35ms", "Entities: 3", "Graph DB: Neo4j"] },
        { label: "Inference", log: "LLM synthesized response with citations", inspect: "GPT-4 generated final grounded synthesis with direct row-column citations.", stats: ["Latency: 145ms", "Tokens: 240", "Guardrail: 100% Grounded"] }
      ],
      output: `Based on Samsung SDS's official financial disclosure for FY25 Q4:\n\n` +
              `• **Net Income:** Reached strong expansion with an 11.2% YoY increase, driven by enterprise GenAI deployments and cloud managed services.\n` +
              `• **Retrieval Precision:** Graph RAG bypassed context limits with divide-and-conquer processing, hitting **92% context recall** across dense financial tables.\n` +
              `• **Pipeline Latency:** Resolved in **240ms** with sub-millisecond FAISS vector indexing.`,
      latency: "240 ms",
      matches: "4 Chunks + 3 Graph Nodes",
      score: "0.94 / 1.0 (RAGAS)"
    },
    accuracy: {
      steps: [
        { label: "Segment", log: "Parsed 200-page annual report", inspect: "Document structure partitioned into executive summary, disclosures, and appendix.", stats: ["Latency: 55ms", "Pages: 200", "Parser: PartitionPDF"] },
        { label: "FAISS Search", log: "Retrieved 8 contextual chunks", inspect: "High-dimensional vector search against financial domain embeddings.", stats: ["Latency: 22ms", "K: 8", "Similarity: 0.91"] },
        { label: "Graph Enrich", log: "Cross-referenced balance sheet entities", inspect: "Identified multi-year balance sheet continuity relations.", stats: ["Latency: 40ms", "Entities: 7", "Triplets: 12"] },
        { label: "Inference", log: "RAGAS evaluation scored groundedness at 92%", inspect: "Anti-hallucination verification passed with zero synthetic contradictions.", stats: ["Latency: 160ms", "Faithfulness: 0.96", "Recall: 0.92"] }
      ],
      output: `RAG Architecture Evaluation Benchmark on 200-Page Annual Report:\n\n` +
              `• **Context Recall:** **92.4%** on complex queries (vs. 52% baseline sliding-window chunking).\n` +
              `• **Faithfulness Score:** **0.96** via RAGAS automated ground-truth evaluation.\n` +
              `• **Context Precision:** Graph traversal prevented 40% of false-positive table lookups.`,
      latency: "277 ms",
      matches: "8 Chunks + 7 Graph Nodes",
      score: "0.96 / 1.0 (RAGAS)"
    },
    agents: {
      steps: [
        { label: "Segment", log: "Queried ADK orchestration repository", inspect: "Indexed state schemas and DAG node routing configurations.", stats: ["Latency: 30ms", "Repository: ADK-Core", "Files: 6"] },
        { label: "FAISS Search", log: "Retrieved 3 orchestration patterns", inspect: "Vector match on state machine transitions and event-driven triggers.", stats: ["Latency: 15ms", "Matches: 3", "Type: AST Chunks"] },
        { label: "Graph Enrich", log: "Linked ADK to MCP tool interfaces", inspect: "Resolved tool calling schemas for Model Context Protocol (MCP) server endpoints.", stats: ["Latency: 32ms", "MCP Tools: 4", "Schemas: JSON-RPC"] },
        { label: "Inference", log: "Synthesized multi-agent architecture blueprint", inspect: "Compiled step-by-step state transition diagram for Google ADK squad.", stats: ["Latency: 130ms", "Tokens: 310", "Pass Rate: 99.4%"] }
      ],
      output: `Google ADK Multi-Agent Orchestration Architecture:\n\n` +
              `• **State Machine:** Directed Acyclic Graph (DAG) state coordinator managing task decomposition.\n` +
              `• **MCP Protocol:** Standardized tool-use hooks for external API execution and local sandboxes.\n` +
              `• **Efficiency Impact:** **60% reduction in manual effort** in enterprise content and QA pipelines.`,
      latency: "207 ms",
      matches: "3 Patterns + 4 MCP Schemas",
      score: "0.98 / 1.0 (RAGAS)"
    }
  };

  const agentLogs = {
    content: [
      "[0.00s] Initializing Google ADK Agent Cluster...",
      "[0.12s] State Node 1: Planner Agent decomposing objective into 3 sub-tasks",
      "[0.34s] State Node 2: Research Agent calling MCP tool 'search_knowledge_graph'...",
      "[0.65s] MCP Tool Result: Retrieved 12 entity triplets from Neo4j",
      "[0.92s] State Node 3: Drafter Agent generating structured Markdown with citations",
      "[1.34s] State Node 4: Critic Agent executing RAGAS evaluation harness...",
      "[1.65s] Verification Passed: Groundedness = 0.98, Hallucination = 0.00",
      "[1.85s] ✅ Objective Complete! Generated SEO-validated article with 0 human edits needed."
    ],
    qa: [
      "[0.00s] Initializing o9 Platform QA Automation Engine...",
      "[0.15s] State Node 1: Ingesting JSON schemas from test and staging instances",
      "[0.42s] State Node 2: AST schema differ running deep reconciliation...",
      "[0.78s] Detected 2 schema drift discrepancies in supply chain planning tables",
      "[1.12s] State Node 3: Patch Agent formulating verified JSON Schema update payload",
      "[1.50s] State Node 4: Executing PyTest validation suite on local sandbox...",
      "[1.88s] Verification Passed: All 48 assertions succeeded (100% schema match)",
      "[2.10s] ✅ QA Check Complete! Generated differential test report and patch advisory."
    ],
    jira: [
      "[0.00s] Initializing Productivity Analyzer Agent...",
      "[0.18s] State Node 1: Authenticating to Jira & Confluence REST endpoints",
      "[0.55s] State Node 2: Ingested 34 engineering sprint issues and daily worklogs",
      "[0.88s] State Node 3: Graph RAG summarizer analyzing sprint velocity and blockers",
      "[1.32s] State Node 4: Guardrail evaluating sprint risk matrix...",
      "[1.70s] Output Formatted: Weekly executive summary ready for squad leads",
      "[1.95s] ✅ Report Complete! Automated delivery configured via SMTP worker."
    ]
  };

  let activeStreamTimeout: any = null;
  let activeTerminalTimeout: any = null;

  function setupSandbox() {
    const container = document.getElementById('ai-sandbox-container');
    if (!container) return;

    // Tabs
    const btnRagTab = document.getElementById('btn-rag-tab');
    const btnAgentTab = document.getElementById('btn-agent-tab');
    const ragPanel = document.getElementById('rag-panel');
    const agentPanel = document.getElementById('agent-panel');

    btnRagTab?.addEventListener('click', () => {
      btnRagTab.classList.add('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnRagTab.classList.remove('text-(--color-text-secondary)', 'border-transparent');
      btnRagTab.setAttribute('aria-selected', 'true');

      btnAgentTab?.classList.remove('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnAgentTab?.classList.add('text-(--color-text-secondary)', 'border-transparent');
      btnAgentTab?.setAttribute('aria-selected', 'false');

      ragPanel?.classList.remove('hidden');
      agentPanel?.classList.add('hidden');
    });

    btnAgentTab?.addEventListener('click', () => {
      btnAgentTab.classList.add('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnAgentTab.classList.remove('text-(--color-text-secondary)', 'border-transparent');
      btnAgentTab.setAttribute('aria-selected', 'true');

      btnRagTab?.classList.remove('bg-(--color-teal-glow)', 'text-(--color-teal)', 'border-teal-500/40');
      btnRagTab?.classList.add('text-(--color-text-secondary)', 'border-transparent');
      btnRagTab?.setAttribute('aria-selected', 'false');

      agentPanel?.classList.remove('hidden');
      ragPanel?.classList.add('hidden');
    });

    // RAG Pipeline Simulation
    const btnRunRag = document.getElementById('btn-run-rag');
    const selectRagQuery = document.getElementById('rag-query-select') as HTMLSelectElement | null;
    const outputRagText = document.getElementById('rag-output-text');
    const logLatency = document.getElementById('rag-log-latency');
    const logMatches = document.getElementById('rag-log-matches');
    const logScore = document.getElementById('rag-log-score');
    const stepBoxes = document.querySelectorAll('.rag-step-box');
    const toggleRouter = document.getElementById('toggle-router') as HTMLInputElement | null;
    const bannerDegraded = document.getElementById('rag-degraded-banner');

    // Inspector Pane
    const inspectPane = document.getElementById('step-inspect-pane');
    const inspectTitle = document.getElementById('inspect-node-title');
    const inspectDesc = document.getElementById('inspect-node-desc');
    const inspectStats = document.getElementById('inspect-node-stats');
    const btnCloseInspect = document.getElementById('btn-close-inspect');

    btnCloseInspect?.addEventListener('click', () => {
      inspectPane?.classList.add('hidden');
    });

    toggleRouter?.addEventListener('change', () => {
      if (!toggleRouter.checked) {
        bannerDegraded?.classList.remove('hidden');
      } else {
        bannerDegraded?.classList.add('hidden');
      }
    });

    function runRagSimulation() {
      if (activeStreamTimeout) clearTimeout(activeStreamTimeout);
      const queryKey = selectRagQuery?.value || 'revenue';
      const data = ragResponses[queryKey as keyof typeof ragResponses];
      const isRouterOn = toggleRouter ? toggleRouter.checked : true;

      // Reset step boxes
      stepBoxes.forEach((box, i) => {
        box.classList.remove('border-(--color-teal)', 'bg-teal-500/10', 'border-red-500/50', 'bg-red-500/10');
        box.classList.add('opacity-50', 'border-(--color-border)');
        const badge = box.querySelector('.step-badge');
        if (badge) {
          badge.textContent = 'QUEUED';
          badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-(--color-text-muted) bg-white/5 border border-white/10';
        }
      });

      if (outputRagText) {
        outputRagText.innerHTML = '<span class="text-(--color-teal) font-mono animate-pulse">Initializing pipeline nodes & vector indexing...</span>';
      }

      // Step-by-step progression animation
      data.steps.forEach((st, idx) => {
        setTimeout(() => {
          const box = stepBoxes[idx];
          if (!box) return;

          box.classList.remove('opacity-50', 'border-(--color-border)');
          const logEl = box.querySelector(`#rag-step${idx + 1}-log`);
          const badge = box.querySelector('.step-badge');

          if (!isRouterOn && idx === 1) {
            // Degraded path
            box.classList.add('border-red-500/60', 'bg-red-500/10');
            if (badge) {
              badge.textContent = 'DEGRADED';
              badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-red-400 bg-red-500/20 border border-red-500/30';
            }
            if (logEl) logEl.textContent = 'Unrouted vector match (diluted context)';
          } else {
            box.classList.add('border-(--color-teal)', 'bg-teal-500/10');
            if (badge) {
              badge.textContent = 'DONE';
              badge.className = 'text-[9px] font-mono step-badge px-1.5 py-0.5 rounded font-bold whitespace-nowrap text-(--color-teal) bg-teal-500/20 border border-teal-500/30';
            }
            if (logEl) logEl.textContent = st.log;
          }
        }, idx * 250);
      });

      // Stream text output
      setTimeout(() => {
        if (!outputRagText) return;
        if (!isRouterOn) {
          outputRagText.innerHTML = `
            <div class="text-red-300 font-mono text-xs mb-2">⚠️ WARNING: Semantic Router was OFF. Output contains context dilution:</div>
            <div class="text-(--color-text-secondary) font-sans">${data.output.replace(/92%/g, '58% (degraded)').replace(/240ms/g, '680ms (timeout overhead)')}</div>
          `;
          if (logLatency) logLatency.textContent = '680 ms (slow)';
          if (logMatches) logMatches.textContent = '14 Unfiltered Chunks';
          if (logScore) logScore.textContent = '0.58 / 1.0 (Degraded)';
        } else {
          // Stream output formatted
          outputRagText.innerHTML = data.output.replace(/\n/g, '<br/>');
          if (logLatency) logLatency.textContent = data.latency;
          if (logMatches) logMatches.textContent = data.matches;
          if (logScore) logScore.textContent = data.score;
        }
      }, 1100);
    }

    btnRunRag?.addEventListener('click', runRagSimulation);

    // Node click handlers for telemetry inspection
    stepBoxes.forEach((box, i) => {
      box.addEventListener('click', () => {
        const queryKey = selectRagQuery?.value || 'revenue';
        const data = ragResponses[queryKey as keyof typeof ragResponses];
        const stepData = data.steps[i];
        if (!stepData || !inspectPane) return;

        if (inspectTitle) inspectTitle.textContent = `🔍 0${i + 1}. ${stepData.label} — Node Telemetry`;
        if (inspectDesc) inspectDesc.textContent = stepData.inspect;
        if (inspectStats) {
          inspectStats.innerHTML = stepData.stats.map(s => `<span class="px-2 py-1 rounded bg-white/5 border border-white/10 text-(--color-teal)">${s}</span>`).join('');
        }
        inspectPane.classList.remove('hidden');
      });
    });

    // Copy Synthesis
    const btnCopyRag = document.getElementById('btn-copy-rag');
    const copyRagLabel = document.getElementById('copy-rag-label');
    btnCopyRag?.addEventListener('click', () => {
      const text = outputRagText?.innerText || '';
      navigator.clipboard.writeText(text).then(() => {
        if (copyRagLabel) copyRagLabel.textContent = 'Copied!';
        setTimeout(() => {
          if (copyRagLabel) copyRagLabel.textContent = 'Copy Synthesis';
        }, 2000);
      });
    });

    // Agent Simulation
    const btnRunAgent = document.getElementById('btn-run-agent');
    const selectAgentTask = document.getElementById('agent-task-select') as HTMLSelectElement | null;
    const terminalEl = document.getElementById('agent-terminal');
    const statCycles = document.getElementById('agent-stat-cycles');
    const statTools = document.getElementById('agent-stat-tools');
    const statStatus = document.getElementById('agent-stat-status');
    const btnCopyAgent = document.getElementById('btn-copy-agent');
    const copyAgentLabel = document.getElementById('copy-agent-label');

    function runAgentSimulation() {
      if (activeTerminalTimeout) clearTimeout(activeTerminalTimeout);
      const taskKey = selectAgentTask?.value || 'content';
      const logs = agentLogs[taskKey as keyof typeof agentLogs];
      if (!terminalEl) return;

      terminalEl.innerHTML = '';
      if (statCycles) statCycles.textContent = 'Running...';
      if (statTools) statTools.textContent = 'Searching...';
      if (statStatus) statStatus.textContent = 'Evaluating...';

      logs.forEach((line, idx) => {
        setTimeout(() => {
          const div = document.createElement('div');
          div.className = line.includes('✅') ? 'text-teal-300 font-bold' : line.includes('MCP') ? 'text-amber-300' : 'text-emerald-400';
          div.textContent = line;
          terminalEl.appendChild(div);
          terminalEl.scrollTop = terminalEl.scrollHeight;

          if (idx === logs.length - 1) {
            if (statCycles) statCycles.textContent = '4 Cycles';
            if (statTools) statTools.textContent = taskKey === 'content' ? '3 Tools (MCP)' : taskKey === 'qa' ? '2 Tools (PyTest)' : '2 Tools (Jira)';
            if (statStatus) statStatus.textContent = '99.4% (Pass)';
          }
        }, idx * 280);
      });
    }

    btnRunAgent?.addEventListener('click', runAgentSimulation);

    btnCopyAgent?.addEventListener('click', () => {
      const text = terminalEl?.innerText || '';
      navigator.clipboard.writeText(text).then(() => {
        if (copyAgentLabel) copyAgentLabel.textContent = 'Copied!';
        setTimeout(() => {
          if (copyAgentLabel) copyAgentLabel.textContent = 'Copy Logs';
        }, 2000);
      });
    });

    // Run initial simulation on load
    runRagSimulation();
  }

  setupSandbox();
  document.addEventListener('astro:page-load', setupSandbox);
</script>
