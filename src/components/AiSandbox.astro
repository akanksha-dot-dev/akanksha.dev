---
// src/components/AiSandbox.astro — Production AI Architecture Sandbox 4.0 (Interactive Cyber-Physical Lab)
---

<div class="glass-static p-6 sm:p-8 relative overflow-hidden fade-in border border-(--color-border) bg-(--color-surface) rounded-2xl w-full shadow-2xl" id="ai-sandbox-container">
  <!-- Subtle Ambient Glow Orbs -->
  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-(--color-teal-glow) filter blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-72 h-72 rounded-full bg-(--color-amber-glow) filter blur-3xl pointer-events-none"></div>

  <!-- Component Top Navigation & Mode Switcher -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-(--color-border) relative z-10">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-(--color-teal) animate-pulse shadow-[0_0_8px_rgba(0,240,181,0.8)]"></span>
        <h3 class="font-(--font-heading) font-extrabold text-lg sm:text-xl text-white tracking-tight">
          Interactive <span class="gradient-text">AI Architecture Sandbox</span>
        </h3>
      </div>
      <p class="text-xs text-(--color-text-secondary) font-(--font-mono) mt-1">
        DAG node telemetry, SVG dataflow, degradation matrix & autonomous agent runner
      </p>
    </div>
    
    <!-- Tab Switches & Auto-Demo Button -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Auto-Demo Trigger -->
      <button 
        type="button" 
        id="btn-auto-demo" 
        class="px-3 py-1.5 text-xs font-(--font-mono) font-semibold rounded-lg transition-all cursor-pointer bg-(--color-amber-glow) text-(--color-amber) border border-amber-500/40 hover:bg-amber-500/20 shadow-sm flex items-center gap-1.5"
        title="Run automated hands-free pipeline demonstration"
      >
        <span>⚡ Auto-Demo</span>
      </button>

      <div class="flex p-1 bg-[#080E1E] border border-(--color-border) rounded-xl" role="tablist" aria-label="Pipeline Simulator Tabs">
        <button 
          type="button"
          id="btn-rag-tab" 
          role="tab"
          aria-selected="true"
          aria-controls="rag-panel"
          class="px-3.5 py-1.5 text-xs font-(--font-mono) font-semibold rounded-lg transition-all cursor-pointer bg-(--color-teal-glow) text-(--color-teal) border border-teal-500/40 shadow-sm"
        >
          ⚡ Enterprise Graph RAG
        </button>
        <button 
          type="button"
          id="btn-agent-tab" 
          role="tab"
          aria-selected="false"
          aria-controls="agent-panel"
          class="px-3.5 py-1.5 text-xs font-(--font-mono) font-semibold rounded-lg transition-all cursor-pointer text-(--color-text-secondary) hover:text-white border border-transparent"
        >
          🤖 Agent Loop (Google ADK)
        </button>
      </div>
    </div>
  </div>

  <div class="relative z-10 min-h-[460px] flex flex-col">
    <!-- ═══ RAG VISUALIZER PANEL ═══ -->
    <div id="rag-panel" role="tabpanel" aria-labelledby="btn-rag-tab" class="flex flex-col gap-6 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Main Area (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          <!-- Workload Selector & Run Action -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <label for="rag-query-select" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Select Enterprise Query Workload
              </label>
              <span class="text-[11px] font-(--font-mono) text-(--color-teal) bg-teal-500/10 border border-teal-500/20 px-2 py-0.5 rounded">
                Samsung SDS Cluster
              </span>
            </div>
            <div class="flex flex-col sm:flex-row gap-2.5">
              <select 
                id="rag-query-select" 
                class="bg-[#080E1E] border border-(--color-border) px-3.5 py-2.5 text-xs rounded-xl flex-1 text-white font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) shadow-inner"
              >
                <option value="revenue">"Analyze Samsung SDS Q4 Net Income & retrieval precision"</option>
                <option value="accuracy">"Assess RAG accuracy over 200-page annual financial statements"</option>
                <option value="agents">"Explain Google ADK multi-agent state mapping patterns"</option>
              </select>
              <button 
                type="button" 
                id="btn-run-rag" 
                class="btn-primary text-xs py-2.5 px-6 whitespace-nowrap cursor-pointer hover:scale-[1.02] transition-transform flex items-center justify-center gap-2 shadow-[0_0_16px_rgba(0,240,181,0.3)] shrink-0"
              >
                <span>▶ Run Pipeline</span>
              </button>
            </div>
          </div>

          <!-- Degradation Warning Banner -->
          <div id="rag-degraded-banner" class="hidden glass-static p-4 rounded-xl border border-red-500/40 bg-red-500/10 text-xs text-red-200 flex items-start gap-3">
            <span class="text-red-400 text-lg shrink-0">⚠️</span>
            <div>
              <span class="font-bold font-(--font-mono) text-red-300 block text-xs">ARCHITECTURAL DEGRADATION SIMULATED</span>
              <p class="text-[0.72rem] text-red-200/90 leading-relaxed mt-0.5">
                Semantic Router or RAGAS Guardrails is disabled. Raw vector similarity without intent classification causes context dilution, token bloat (+420 tokens), and unverified table hallucinations.
              </p>
            </div>
          </div>

          <!-- Interactive Pipeline Visual Flow Nodes with Connected SVG Dataflow -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Execution Flow Nodes (Click node to inspect telemetry)
              </span>
              <span class="text-[10px] font-(--font-mono) text-(--color-teal) flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-(--color-teal) animate-ping"></span>
                <span>DAG Active</span>
              </span>
            </div>
            
            <!-- Nodes Container -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 relative z-10" id="rag-steps-container">
              <!-- Step 1 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="1"
                title="Click to inspect Segmentation node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">01. SEGMENT</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step1-log">Awaiting launch...</div>
              </button>

              <!-- Step 2 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="2"
                title="Click to inspect FAISS Vector Search node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">02. FAISS SEARCH</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step2-log">Awaiting launch...</div>
              </button>

              <!-- Step 3 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="3"
                title="Click to inspect Graph Enrich node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">03. GRAPH ENRICH</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step3-log">Awaiting launch...</div>
              </button>

              <!-- Step 4 -->
              <button 
                type="button" 
                class="rag-step-box text-left border border-(--color-border) p-3.5 rounded-xl bg-[#080E1E]/70 transition-all opacity-50 cursor-pointer hover:border-(--color-teal)/60 flex flex-col justify-between gap-1.5"
                data-step="4"
                title="Click to inspect LLM Inference node telemetry"
              >
                <div class="flex items-center justify-between gap-1">
                  <span class="text-xs font-(--font-mono) text-white font-bold truncate">04. INFERENCE</span>
                  <span class="text-[9px] font-mono text-(--color-teal) step-badge px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20 font-bold whitespace-nowrap">READY</span>
                </div>
                <div class="text-[11px] font-(--font-mono) text-(--color-text-muted) truncate" id="rag-step4-log">Awaiting launch...</div>
              </button>
            </div>
          </div>

          <!-- Step Deep-Inspection Pane (Interactive) -->
          <div id="step-inspect-pane" class="hidden glass-static p-4 rounded-xl border border-(--color-teal)/40 bg-[#080E1E]/95 text-xs font-(--font-mono) flex flex-col gap-2.5">
            <div class="flex items-center justify-between text-(--color-teal)">
              <span class="font-bold flex items-center gap-1.5" id="inspect-node-title">🔍 Node Telemetry Inspector</span>
              <button type="button" id="btn-close-inspect" class="text-(--color-text-muted) hover:text-(--color-teal) text-xs cursor-pointer px-2 py-0.5 rounded bg-white/5 border border-white/10">✕ Close</button>
            </div>
            <p id="inspect-node-desc" class="text-xs text-(--color-text-secondary) leading-relaxed"></p>
            <div id="inspect-node-payload" class="bg-[#030712] p-3 rounded-lg border border-white/5 font-mono text-[11px] text-teal-300 overflow-x-auto"></div>
            <div id="inspect-node-stats" class="flex flex-wrap gap-3 pt-2 text-[11px] text-(--color-text-muted) border-t border-white/5 font-(--font-mono)"></div>
          </div>

          <!-- Streamed Synthesis Box -->
          <div class="border border-(--color-border) bg-[#080E1E]/60 p-5 rounded-xl flex-1 flex flex-col gap-3 min-h-[160px] relative shadow-inner">
            <div class="flex items-center justify-between border-b border-white/5 pb-2.5">
              <span class="text-xs font-(--font-mono) text-(--color-teal) uppercase tracking-wider font-semibold flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-(--color-teal) animate-pulse"></span>
                Synthesized Output (Streamed Response)
              </span>
              <button 
                type="button" 
                id="btn-copy-rag" 
                class="text-xs font-(--font-mono) text-(--color-text-secondary) hover:text-(--color-teal) flex items-center gap-1.5 cursor-pointer transition-colors px-2.5 py-1 rounded-lg border border-white/5 hover:border-(--color-teal)/40 bg-white/5"
                title="Copy synthesized output"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-rag-label">Copy Synthesis</span>
              </button>
            </div>
            <div id="rag-output-text" class="text-xs sm:text-sm text-(--color-text-primary) leading-relaxed font-sans" aria-live="polite">
              Select an enterprise query above and run the pipeline to visualize real-time RAG execution.
            </div>
          </div>
        </div>

        <!-- Sidebar Status & Controls (4 cols) -->
        <div class="lg:col-span-4 flex flex-col gap-4">
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>Architecture Controls</span>
            <span class="text-[10px] text-(--color-teal)">Live Node</span>
          </span>
          
          <!-- Semantic Router Switch -->
          <div class="glass-static p-4 flex flex-col gap-2.5 border border-(--color-border) bg-[#080E1E]/60 rounded-xl">
            <div class="flex items-center justify-between">
              <span class="text-xs font-(--font-mono) text-white font-semibold flex items-center gap-1.5">
                Semantic Router
                <span class="text-[10px] text-teal-400 font-mono" title="Routes queries dynamically based on semantic intent">ℹ</span>
              </span>
              <label class="relative inline-flex items-center cursor-pointer" aria-label="Toggle Semantic Router Node">
                <input type="checkbox" id="toggle-router" class="sr-only peer" checked>
                <div class="w-9 h-5 bg-red-500/40 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-(--color-teal)"></div>
              </label>
            </div>
            <p class="text-[11px] text-(--color-text-secondary) font-(--font-mono) leading-relaxed">
              Guarantees 92% retrieval precision. Toggle OFF to test hallucination degradation.
            </p>
          </div>

          <!-- Pipeline Telemetry Box -->
          <div class="glass-static p-4 sm:p-5 flex flex-col gap-3.5 font-(--font-mono) bg-[#080E1E]/60 border border-(--color-border) rounded-xl">
            <div class="flex justify-between items-center pb-2.5 border-b border-white/5">
              <span class="text-xs text-(--color-text-muted) uppercase tracking-wider font-semibold">PIPELINE TELEMETRY</span>
              <span class="text-[10px] text-(--color-teal) font-semibold px-2 py-0.5 rounded bg-teal-500/10 border border-teal-500/20">VALIDATED</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">LATENCY DELTA</span>
              <span id="rag-log-latency" class="text-base font-bold text-(--color-teal)">0.00 ms</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">RETRIEVAL MATCHES</span>
              <span id="rag-log-matches" class="text-base font-bold text-(--color-teal)">-</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">RAGAS RELEVANCE SCORE</span>
              <span id="rag-log-score" class="text-base font-bold text-(--color-amber)">-</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ AGENT ORCHESTRATION PANEL ═══ -->
    <div id="agent-panel" role="tabpanel" aria-labelledby="btn-agent-tab" class="hidden flex flex-col gap-6 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Main Area (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          <!-- Objective Selector -->
          <div class="flex flex-col gap-2">
            <div class="flex justify-between items-center">
              <label for="agent-task-select" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">
                Select Autonomous Agent Objective
              </label>
              <span class="text-[11px] font-(--font-mono) text-(--color-teal) bg-teal-500/10 border border-teal-500/20 px-2 py-0.5 rounded">
                Google ADK Core
              </span>
            </div>
            <div class="flex flex-col sm:flex-row gap-2.5">
              <select 
                id="agent-task-select" 
                class="bg-[#080E1E] border border-(--color-border) px-3.5 py-2.5 text-xs rounded-xl flex-1 text-white font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) shadow-inner"
              >
                <option value="content">"Generate & evaluate SEO validated article about Graph RAG"</option>
                <option value="qa">"Analyze JSON schema comparisons across o9 test instances"</option>
                <option value="jira">"Extract work logs and generate JIRA story sprint reports"</option>
              </select>
              <button 
                type="button" 
                id="btn-run-agent" 
                class="btn-primary text-xs py-2.5 px-6 whitespace-nowrap cursor-pointer hover:scale-[1.02] transition-transform flex items-center justify-center gap-2 shadow-[0_0_16px_rgba(0,240,181,0.3)] shrink-0"
              >
                <span>🚀 Launch Agent</span>
              </button>
            </div>
          </div>

          <!-- Multi-Agent Orchestration Flow Graph -->
          <div class="glass-static p-3 rounded-xl border border-white/10 bg-[#030712]/80 flex flex-wrap items-center justify-between gap-2 text-[11px] font-(--font-mono)">
            <span class="text-white font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-(--color-teal)"></span>
              Manager Agent
            </span>
            <span class="text-(--color-text-muted)">➔</span>
            <span class="text-teal-300">Planner</span>
            <span class="text-(--color-text-muted)">➔</span>
            <span class="text-teal-300">Researcher</span>
            <span class="text-(--color-text-muted)">➔</span>
            <span class="text-amber-300">Code Synth</span>
            <span class="text-(--color-text-muted)">➔</span>
            <span class="text-teal-300 font-bold">RAGAS Verifier</span>
          </div>

          <!-- Console Terminal -->
          <div class="border border-(--color-border) bg-[#030712] p-5 rounded-xl font-(--font-mono) flex-1 min-h-[260px] flex flex-col gap-2 shadow-2xl">
            <div class="flex items-center justify-between pb-3 border-b border-white/10">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                <span class="text-xs text-(--color-text-muted) ml-2">akanksha@adk-node:~$</span>
              </div>
              <button 
                type="button" 
                id="btn-copy-agent" 
                class="text-xs font-(--font-mono) text-(--color-text-secondary) hover:text-(--color-teal) flex items-center gap-1.5 cursor-pointer transition-colors px-2.5 py-1 rounded border border-white/10 bg-white/5"
                title="Copy terminal logs"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-agent-label">Copy Logs</span>
              </button>
            </div>
            <div id="agent-terminal" class="text-xs text-emerald-400 leading-relaxed overflow-y-auto max-h-[220px] space-y-1.5" aria-live="polite">
              <span class="text-(--color-text-muted)">Ready to initialize. Select an objective and launch the agent.</span>
            </div>
          </div>
        </div>

        <!-- Sidebar Status & Checks (4 cols) -->
        <div class="lg:col-span-4 flex flex-col gap-4">
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>Safety & Guardrails</span>
            <span class="text-[10px] text-(--color-teal)">Active Harness</span>
          </span>
          
          <div class="glass-static p-4 flex flex-col gap-2.5 border border-(--color-border) bg-[#080E1E]/60 rounded-xl">
            <div class="flex items-center justify-between">
              <span class="text-xs font-(--font-mono) text-white font-semibold flex items-center gap-1.5">
                RAGAS Guardrails
                <span class="text-[10px] text-teal-400 font-mono" title="Scores groundedness & alignment against hallucination">ℹ</span>
              </span>
              <label class="relative inline-flex items-center cursor-pointer" aria-label="Toggle RAGAS Guardrails Node">
                <input type="checkbox" id="toggle-guardrails" class="sr-only peer" checked>
                <div class="w-9 h-5 bg-red-500/40 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-(--color-teal)"></div>
              </label>
            </div>
            <p class="text-[11px] text-(--color-text-secondary) font-(--font-mono) leading-relaxed">
              Enforces structured schema validation & anti-hallucination verification before agent execution.
            </p>
          </div>

          <div class="glass-static p-4 sm:p-5 flex flex-col gap-3.5 font-(--font-mono) bg-[#080E1E]/60 border border-(--color-border) rounded-xl">
            <div class="flex justify-between items-center pb-2.5 border-b border-white/5">
              <span class="text-xs text-(--color-text-muted) uppercase tracking-wider font-semibold">AGENT TELEMETRY</span>
              <span class="text-[10px] text-(--color-amber) font-semibold px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/20">STATEFUL</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">EXECUTION CYCLES</span>
              <span id="agent-stat-cycles" class="text-base font-bold text-(--color-teal)">0 Loops</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">MCP TOOLS INVOKED</span>
              <span id="agent-stat-tools" class="text-base font-bold text-(--color-teal)">0 Tools</span>
            </div>
            <div>
              <span class="text-[10px] text-(--color-text-muted) uppercase tracking-wider block">VERIFICATION PASS RATE</span>
              <span id="agent-stat-status" class="text-base font-bold text-(--color-amber)">-</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Simulation Data 4.0
  const ragResponses = {
    revenue: {
      steps: [
        { 
          label: "Segment", 
          log: "Parsed FY25 Q4 statements (Table Extraction)", 
          inspect: "Layout parser segmented 200 pages into 14 financial tables using GMFT table detection.",
          payload: `{\n  "parser": "GMFT-Layout",\n  "table_bboxes": [[120, 45, 540, 310]],\n  "extracted_cells": 142,\n  "schema_type": "Q4_Financial_Disclosure"\n}`,
          stats: ["Latency: 42ms", "Chunks: 14", "Parser: GMFT Layout"] 
