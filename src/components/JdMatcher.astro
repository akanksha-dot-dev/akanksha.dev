---
// src/components/JdMatcher.astro — Recruiter JD Compatibility & Competency Radar Engine 4.0
---

<div class="glass-static p-6 sm:p-8 relative overflow-hidden fade-in border border-(--color-border) bg-(--color-surface) rounded-2xl w-full shadow-2xl" id="jd-matcher-container">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-(--color-teal-glow) filter blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-(--color-amber-glow) filter blur-3xl pointer-events-none"></div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-(--color-border) relative z-10">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-(--color-amber) animate-pulse shadow-[0_0_8px_rgba(245,163,0,0.8)]"></span>
        <h3 class="font-(--font-heading) font-extrabold text-lg sm:text-xl text-white tracking-tight">
          Recruiter <span class="gradient-text">JD Compatibility Engine</span>
        </h3>
      </div>
      <p class="text-xs text-(--color-text-secondary) font-(--font-mono) mt-1">
        Instant client-side candidate fit analysis, 4-domain radar scoring & STAR story matching
      </p>
    </div>

    <!-- Quick Actions / Dossier Export -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <button 
        type="button" 
        id="btn-copy-jd-report" 
        class="text-xs font-(--font-mono) text-(--color-teal) hover:text-white flex items-center gap-1.5 cursor-pointer transition-colors px-3.5 py-2 rounded-xl border border-teal-500/30 hover:border-(--color-teal) bg-teal-500/10 shadow-sm"
        title="Copy match summary report dossier"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="copy-jd-label">Copy Candidate Dossier</span>
      </button>
    </div>
  </div>

  <div class="relative z-10 flex flex-col gap-6">
    <!-- Paste Area & Role Presets -->
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap gap-2 items-center justify-between">
        <label for="jd-input" class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold flex items-center gap-1.5">
          <span>Target Role Presets or Custom JD:</span>
        </label>
        <div class="flex flex-wrap gap-2">
          <button 
            type="button"
            id="btn-preset-senior" 
            class="text-xs font-(--font-mono) px-3 py-1.5 border border-(--color-teal)/40 bg-(--color-teal-glow) text-(--color-teal) rounded-lg hover:border-(--color-teal) cursor-pointer transition-all font-semibold"
          >
            Senior AI Engineer
          </button>
          <button 
            type="button"
            id="btn-preset-staff" 
            class="text-xs font-(--font-mono) px-3 py-1.5 border border-(--color-border) hover:border-(--color-teal) rounded-lg text-(--color-text-secondary) hover:text-(--color-teal) cursor-pointer transition-colors bg-[#080E1E]"
          >
            Staff RAG & Agent Architect
          </button>
          <button 
            type="button"
            id="btn-preset-eval" 
            class="text-xs font-(--font-mono) px-3 py-1.5 border border-(--color-border) hover:border-(--color-teal) rounded-lg text-(--color-text-secondary) hover:text-(--color-teal) cursor-pointer transition-colors bg-[#080E1E]"
          >
            AI Eval & Reliability Lead
          </button>
          <button 
            type="button"
            id="btn-preset-fde" 
            class="text-xs font-(--font-mono) px-3 py-1.5 border border-(--color-border) hover:border-(--color-teal) rounded-lg text-(--color-text-secondary) hover:text-(--color-teal) cursor-pointer transition-colors bg-[#080E1E]"
          >
            Solutions / FDE
          </button>
          <button 
            type="button"
            id="btn-clear-jd" 
            class="text-xs font-(--font-mono) px-2.5 py-1.5 border border-(--color-border) hover:border-red-400 rounded-lg text-(--color-text-muted) hover:text-red-400 cursor-pointer transition-colors"
            title="Clear input"
          >
            Clear
          </button>
        </div>
      </div>
      
      <textarea 
        id="jd-input" 
        rows="4" 
        placeholder="Paste any Job Description or job posting requirements (e.g. 'Looking for a Senior AI Engineer with Graph RAG experience, multi-agent workflows with Google ADK, LLM fine-tuning, FastAPI, Docker, and RAGAS evaluations...')" 
        class="w-full bg-[#080E1E]/80 border border-(--color-border) p-4 text-xs sm:text-sm rounded-xl text-white font-sans focus:outline-none focus:border-(--color-teal) focus:ring-1 focus:ring-(--color-teal) leading-relaxed shadow-inner"
      ></textarea>
      
      <div class="flex items-center justify-between text-xs font-(--font-mono) text-(--color-text-muted)">
        <span id="jd-typing-status">Type or paste to evaluate candidate fit in real time...</span>
        <button 
          type="button"
          id="btn-match-jd" 
          class="btn-primary text-xs py-2 px-6 cursor-pointer shadow-[0_0_16px_rgba(0,240,181,0.3)] shrink-0"
        >
          ⚡ Recalculate Fit
        </button>
      </div>
    </div>

    <!-- Match Results Area -->
    <div id="matcher-results" class="flex flex-col gap-6 border-t border-(--color-border) pt-6" aria-live="polite">
      <!-- Top Row: Radial Ring + 4-Domain Competency Radar Breakdown -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center bg-[#080E1E]/60 p-6 rounded-2xl border border-(--color-border)">
        <!-- Match Score Ring (4 cols) -->
        <div class="md:col-span-4 flex flex-col items-center justify-center text-center p-2">
          <div 
            class="relative w-32 h-32 flex items-center justify-center" 
            role="progressbar" 
            id="score-progressbar" 
            aria-valuenow="0" 
            aria-valuemin="0" 
            aria-valuemax="100" 
            aria-label="JD Compatibility Score"
          >
            <svg class="absolute inset-0 w-full h-full transform -rotate-90" viewBox="0 0 112 112" aria-hidden="true">
              <circle cx="56" cy="56" r="48" stroke="rgba(255,255,255,0.07)" stroke-width="8" fill="transparent"/>
              <circle id="score-circle" cx="56" cy="56" r="48" stroke="var(--color-teal)" stroke-width="8" fill="transparent" stroke-linecap="round" stroke-dasharray="301.6" stroke-dashoffset="301.6" class="transition-all duration-1000 ease-out"/>
            </svg>
            <div class="flex flex-col items-center justify-center">
              <span id="score-percentage" class="text-3xl font-extrabold font-(--font-heading) text-(--color-teal)">0%</span>
              <span class="text-[9px] font-mono text-teal-400 font-semibold uppercase">MATCH FIT</span>
            </div>
          </div>
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) mt-2 uppercase tracking-wider font-semibold">OVERALL FIT SCORE</span>
        </div>

        <!-- 4-Domain Fit Radar Bars (8 cols) -->
        <div class="md:col-span-8 flex flex-col gap-3.5">
          <div class="flex justify-between items-center pb-2 border-b border-white/5">
            <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">4-Domain Fit Radar</span>
            <span class="text-[11px] font-(--font-mono) text-(--color-teal)">Verified Competencies</span>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5 text-xs font-(--font-mono)">
            <!-- Category 1: Agentic AI -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between text-xs">
                <span class="text-(--color-text-secondary)">Agentic AI & Orchestration</span>
                <span id="cat-agentic-pct" class="text-(--color-teal) font-bold">0%</span>
              </div>
              <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                <div id="cat-agentic-bar" class="h-full bg-(--color-teal) rounded-full transition-all duration-700 w-0"></div>
              </div>
            </div>

            <!-- Category 2: RAG & Search -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between text-xs">
                <span class="text-(--color-text-secondary)">RAG & Vector Search</span>
                <span id="cat-rag-pct" class="text-(--color-teal) font-bold">0%</span>
              </div>
              <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                <div id="cat-rag-bar" class="h-full bg-(--color-teal) rounded-full transition-all duration-700 w-0"></div>
              </div>
            </div>

            <!-- Category 3: LLM Infra -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between text-xs">
                <span class="text-(--color-text-secondary)">LLM Infra & Backend APIs</span>
                <span id="cat-infra-pct" class="text-(--color-amber) font-bold">0%</span>
              </div>
              <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                <div id="cat-infra-bar" class="h-full bg-(--color-amber) rounded-full transition-all duration-700 w-0"></div>
              </div>
            </div>

            <!-- Category 4: Enterprise ML -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between text-xs">
                <span class="text-(--color-text-secondary)">Enterprise ML & Reliability</span>
                <span id="cat-ml-pct" class="text-(--color-amber) font-bold">0%</span>
              </div>
              <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                <div id="cat-ml-bar" class="h-full bg-(--color-amber) rounded-full transition-all duration-700 w-0"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Matched Skills & Keywords -->
      <div class="flex flex-col gap-2.5">
        <div class="flex justify-between items-center">
          <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">Detected Core Competencies</span>
          <span class="text-xs font-(--font-mono) text-(--color-teal)" id="matched-count-label">0 Skills Identified</span>
        </div>
        <div id="matched-tags-container" class="flex flex-wrap gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- 2-Column Split: Filtered Bullets (Left) & Suggested STAR Stories (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Filtered Resume Bullets -->
        <div class="flex flex-col gap-2.5">
          <div class="flex justify-between items-center">
            <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">Tailored Experience Evidence</span>
            <span class="text-xs font-(--font-mono) text-(--color-text-muted)" id="bullet-count-label">0 Bullets Filtered</span>
          </div>
          
          <div class="border border-(--color-border) bg-[#080E1E]/60 rounded-xl p-4 flex flex-col gap-3.5 max-h-[320px] overflow-y-auto" id="filtered-bullets-container">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Suggested STAR Interview Stories -->
        <div class="flex flex-col gap-2.5">
          <div class="flex justify-between items-center">
            <span class="text-xs font-(--font-mono) text-(--color-text-secondary) uppercase tracking-wider font-semibold">Recommended Interview Talking Points (STAR)</span>
            <span class="text-xs font-(--font-mono) text-(--color-amber)">Interview Prep</span>
          </div>
          <div class="flex flex-col gap-3 max-h-[320px] overflow-y-auto" id="suggested-stories-container">
            <!-- Populated via JS -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const sampleJds = {
    senior: "Senior Production AI Engineer (RAG & Multi-Agent Systems)\n\n" +
            "We are looking for a Senior AI Engineer to lead the architecture of production Generative AI systems.\n" +
            "Key Responsibilities:\n" +
            "• Design and scale advanced Retrieval-Augmented Generation (Graph RAG, Hybrid FAISS search, semantic routing).\n" +
            "• Build multi-agent workflows using Google ADK, LangGraph, CrewAI, and MCP tools.\n" +
            "• Deploy robust LLM serving endpoints (GPT-4, Llama-3) with FastAPI backends and Docker/Kubernetes.\n" +
            "• Implement custom evaluation harnesses using RAGAS and LangSmith for groundedness and anti-hallucination.\n" +
            "• Lead and mentor engineering squad members on prompt engineering and safety guardrails.",
    
    staff: "Staff AI Architect (Enterprise LLM Orchestration & Autonomous Agents)\n\n" +
           "Seeking a Staff-level AI Architect to define company-wide GenAI pipelines.\n" +
           "Requirements:\n" +
           "• 4+ years architectural experience in enterprise RAG and autonomous agent loops.\n" +
           "• Deep expertise with Knowledge Graphs (Neo4j), vector databases (FAISS, Chroma), and layout-aware document extraction.\n" +
           "• Proven track record in agent safety harnesses, prompt injection defense, and sub-300ms SLA optimization.\n" +
           "• Cross-border squad leadership and technical roadmap ownership.",

    eval: "AI Evaluation & Reliability Lead\n\n" +
          "Looking for an AI engineer focused on LLM benchmark validation, RAG evaluation, and production reliability.\n" +
          "Key Skills:\n" +
          "• Automated RAGAS evaluation (faithfulness, answer relevance, context recall).\n" +
          "• High-reliability enterprise backend architectures (FastAPI, Docker, CI/CD pipelines).\n" +
          "• 98%+ SLA reliability management, incident response, and performance monitoring.",

    fde: "Forward Deployed AI Engineer / Enterprise Solutions Architect\n\n" +
         "Looking for an AI engineer to drive production ML & LLM deployments for enterprise customers.\n" +
         "Key Requirements:\n" +
         "• 3+ years experience deploying production Machine Learning, NLP, and GenAI integrations at scale.\n" +
         "• Client-facing technical architecture delivery, presenting technical architectures to stakeholders.\n" +
         "• Strong production reliability track record: incident management, reducing downtime, maintaining 98%+ SLA.\n" +
         "• Hands-on expertise with Python, Django/FastAPI, SQL Server/PostgreSQL, Azure, and AWS Bedrock."
  };

  const matchDatabase = {
    skills: [
      // Agentic AI
      { key: "agents", label: "Agentic AI / Autonomous Loops", cat: "agentic", regex: /agentic|agents|multi-agent|autonomous/i },
      { key: "google adk", label: "Google ADK", cat: "agentic", regex: /google\s*adk|adk/i },
      { key: "langgraph", label: "LangGraph / LangChain", cat: "agentic", regex: /langgraph|langchain|crewai/i },
      { key: "mcp", label: "MCP Protocol & Tool-Use", cat: "agentic", regex: /mcp|model\s*context\s*protocol|tool\s*use|tool\s*calling/i },
      // RAG & Search
      { key: "rag", label: "RAG Systems", cat: "rag", regex: /\brag\b|retrieval-augmented|retrieval augmented/i },
      { key: "graph rag", label: "Graph RAG / Knowledge Graph", cat: "rag", regex: /graph\s*rag|knowledge\s*graph|neo4j/i },
      { key: "vector db", label: "FAISS / Chroma / Pinecone", cat: "rag", regex: /faiss|chroma|pinecone|vector\s*db|vector\s*search|embeddings/i },
      { key: "eval", label: "RAGAS / Guardrail Evaluation", cat: "rag", regex: /ragas|eval|evaluation|groundedness|hallucination|langsmith|benchmark/i },
      // LLM Infra & Backend
      { key: "llm", label: "LLM Orchestration (GPT-4 / Llama-3)", cat: "infra", regex: /\bllm\b|large language model|llama|gpt|mistral|gemini|fine-tuning|peft|lora/i },
      { key: "fastapi", label: "FastAPI / REST APIs", cat: "infra", regex: /fastapi|rest\s*api|restful/i },
      { key: "python", label: "Python Core", cat: "infra", regex: /python|pydantic|pytest/i },
      { key: "docker", label: "Docker & Kubernetes", cat: "infra", regex: /docker|kubernetes|k8s|containers/i },
      // Enterprise ML & Cloud
      { key: "nlp", label: "NLP & Machine Learning", cat: "ml", regex: /nlp|natural language|scikit|pytorch|machine learning|transformers|spacy|hugging\s*face/i },
      { key: "aws", label: "AWS Bedrock / SageMaker", cat: "ml", regex: /aws|bedrock|sagemaker/i },
      { key: "azure", label: "Azure ML / Cloud", cat: "ml", regex: /azure/i },
      { key: "sql", label: "SQL / Databases", cat: "ml", regex: /sql|postgresql|mysql|database/i },
      { key: "lead", label: "Tech Leadership & Mentorship", cat: "ml", regex: /lead|mentor|managing|team\s*leader|architect/i },
      { key: "reliability", label: "Production Reliability & SLA", cat: "ml", regex: /reliability|uptime|incidents|downtime|sla/i }
    ],
    bullets: [
      {
        text: "Architected end-to-end Graph RAG pipeline at Samsung SDS processing annual financial reports with advanced PDF extraction, achieving 92% retrieval accuracy on 500+ daily queries (40% gain over baseline).",
        keys: ["rag", "graph rag", "vector db", "llm", "eval", "python"],
        company: "Samsung SDS"
      },
      {
        text: "Engineered autonomous multi-agent systems using Google ADK and LangGraph for enterprise content generation and QA automation, cutting developer manual effort by 60%.",
        keys: ["agents", "google adk", "langgraph", "mcp", "python"],
        company: "Samsung SDS"
      },
      {
        text: "Led a developer squad of 3 engineers on Generative AI solutions and mentored junior engineers on RAG architectures, prompt engineering, and RAGAS evaluation guidelines.",
        keys: ["lead", "rag", "eval", "llm"],
        company: "Samsung SDS"
      },
      {
        text: "Implemented QA Automation Engine with structured JSON comparison and o9 platform custom Python plugins for cross-border Korea-India delivery.",
        keys: ["python", "docker", "fastapi"],
        company: "Samsung SDS"
      },
      {
        text: "Deployed 10+ production Machine Learning and NLP features (CV parsing, profile matching, smart search) for enterprise recruitment platform serving thousands of daily users.",
        keys: ["nlp", "azure", "python", "sql"],
        company: "HCLTech"
      },
      {
        text: "Resolved 500+ production incidents, successfully cutting system downtime by 30% and maintaining 98% Azure & AWS service reliability.",
        keys: ["reliability", "azure", "aws", "docker"],
        company: "HCLTech"
      },
      {
        text: "Built voice-first Multilingual Mandi web app with AWS Bedrock supporting 5 Indian languages (PromptWars Noida 1st Runner-Up).",
        keys: ["aws", "llm", "nlp", "fastapi"],
        company: "Hackathon"
      }
    ],
    stories: [
      {
        title: "Building & Scaling Graph RAG to 92% Accuracy",
        desc: "Situation: 200+ page financial reports failed basic chunking. Action: Built partition PDF layout parser + FAISS index + Neo4j entity graph. Result: 92% retrieval accuracy across 500+ daily queries.",
        keys: ["rag", "graph rag", "vector db", "llm"]
      },
      {
        title: "Google ADK Multi-Agent Loop for 60% Effort Reduction",
        desc: "Situation: Content & QA workflows required manual validation. Action: Built stateful ADK orchestrator with MCP tools and RAGAS guardrails. Result: 60% reduction in manual effort.",
        keys: ["agents", "google adk", "langgraph", "mcp"]
      },
      {
        title: "Enterprise Incident Resolution & 98% Uptime",
        desc: "Situation: Enterprise recruitment platform suffered query bottlenecks. Action: Refactored indexing, tuned DB queries, set up automated monitoring. Result: 30% downtime cut, 500+ tickets resolved.",
        keys: ["reliability", "sql", "azure", "aws"]
      },
      {
        title: "Cross-Border Client Delivery & Leadership",
        desc: "Situation: Multi-tenant o9 platform required strict cross-region integration. Action: Led weekly architecture syncs between India & Korea teams, mentoring engineers on prompt safety. Result: 0 SLA regressions.",
        keys: ["lead", "python", "docker"]
      }
    ]
  };

  let debounceTimer: any = null;
  let countInterval: any = null;

  function setupMatcher() {
    const container = document.getElementById('jd-matcher-container');
    if (!container) return;

    const playSound = (window as any).__AK_PLAY_SOUND__ || (() => {});

    const jdTextarea = document.getElementById('jd-input') as HTMLTextAreaElement | null;
    const btnPresetSenior = document.getElementById('btn-preset-senior');
    const btnPresetStaff = document.getElementById('btn-preset-staff');
    const btnPresetEval = document.getElementById('btn-preset-eval');
    const btnPresetFde = document.getElementById('btn-preset-fde');
    const btnClearJd = document.getElementById('btn-clear-jd');
    const btnMatch = document.getElementById('btn-match-jd');
    const typingStatus = document.getElementById('jd-typing-status');
    
    const resultsPanel = document.getElementById('matcher-results');
    const scoreCircle = document.getElementById('score-circle');
    const scorePercentage = document.getElementById('score-percentage');
    const scoreProgressbar = document.getElementById('score-progressbar');
    const tagsContainer = document.getElementById('matched-tags-container');
    const bulletsContainer = document.getElementById('filtered-bullets-container');
    const labelBulletCount = document.getElementById('bullet-count-label');
    const labelMatchedCount = document.getElementById('matched-count-label');
    const storiesContainer = document.getElementById('suggested-stories-container');

    const catAgenticPct = document.getElementById('cat-agentic-pct');
    const catAgenticBar = document.getElementById('cat-agentic-bar');
    const catRagPct = document.getElementById('cat-rag-pct');
    const catRagBar = document.getElementById('cat-rag-bar');
    const catInfraPct = document.getElementById('cat-infra-pct');
    const catInfraBar = document.getElementById('cat-infra-bar');
    const catMlPct = document.getElementById('cat-ml-pct');
    const catMlBar = document.getElementById('cat-ml-bar');

    const btnCopyJdReport = document.getElementById('btn-copy-jd-report');
    const copyJdLabel = document.getElementById('copy-jd-label');

    function setActivePreset(activeBtn: HTMLElement | null) {
      [btnPresetSenior, btnPresetStaff, btnPresetEval, btnPresetFde].forEach(b => {
        b?.classList.remove('border-(--color-teal)/40', 'bg-(--color-teal-glow)', 'text-(--color-teal)', 'font-semibold');
        b?.classList.add('border-(--color-border)', 'text-(--color-text-secondary)', 'bg-[#080E1E]');
      });
      if (activeBtn) {
        activeBtn.classList.remove('border-(--color-border)', 'text-(--color-text-secondary)', 'bg-[#080E1E]');
        activeBtn.classList.add('border-(--color-teal)/40', 'bg-(--color-teal-glow)', 'text-(--color-teal)', 'font-semibold');
      }
    }

    function runMatching() {
      const text = jdTextarea?.value.trim() || '';
      if (!text) {
        if (typingStatus) typingStatus.textContent = 'Type or paste to evaluate in real time...';
        return;
      }

      if (countInterval) clearInterval(countInterval);
      if (typingStatus) typingStatus.textContent = 'Evaluating candidate compatibility...';
      
      const matchedKeys = new Set<string>();
      const catCounts = { agentic: 0, rag: 0, infra: 0, ml: 0 };
      const catTotals = { agentic: 0, rag: 0, infra: 0, ml: 0 };

      matchDatabase.skills.forEach(s => {
        const cat = s.cat as keyof typeof catCounts;
        catTotals[cat]++;
        if (s.regex.test(text)) {
          matchedKeys.add(s.key);
          catCounts[cat]++;
        }
      });

      // Compute Scores
      const totalSkillsMatched = matchedKeys.size;
      const baseRatio = totalSkillsMatched / matchDatabase.skills.length;
      const overallScore = Math.min(98, Math.max(45, Math.round(baseRatio * 100) + 35));

      const agenticScore = Math.min(100, Math.round((catCounts.agentic / (catTotals.agentic || 1)) * 100) + 25);
      const ragScore = Math.min(100, Math.round((catCounts.rag / (catTotals.rag || 1)) * 100) + 25);
      const infraScore = Math.min(100, Math.round((catCounts.infra / (catTotals.infra || 1)) * 100) + 25);
      const mlScore = Math.min(100, Math.round((catCounts.ml / (catTotals.ml || 1)) * 100) + 25);

      // Populate Category Bars
      if (catAgenticPct && catAgenticBar) {
        catAgenticPct.textContent = `${agenticScore}%`;
        catAgenticBar.style.width = `${agenticScore}%`;
      }
      if (catRagPct && catRagBar) {
        catRagPct.textContent = `${ragScore}%`;
        catRagBar.style.width = `${ragScore}%`;
      }
      if (catInfraPct && catInfraBar) {
        catInfraPct.textContent = `${infraScore}%`;
        catInfraBar.style.width = `${infraScore}%`;
      }
      if (catMlPct && catMlBar) {
        catMlPct.textContent = `${mlScore}%`;
        catMlBar.style.width = `${mlScore}%`;
      }

      // Animate Radial Circle
      if (scoreCircle) {
        const circumference = 2 * Math.PI * 48; // 301.6
        const offset = circumference - (overallScore / 100) * circumference;
        scoreCircle.style.strokeDashoffset = `${offset}`;
      }

      // Count-up numbers
      let currentVal = 0;
      countInterval = setInterval(() => {
        currentVal += 2;
        if (currentVal >= overallScore) {
          currentVal = overallScore;
          clearInterval(countInterval);
          playSound('success');
        }
        if (scorePercentage) scorePercentage.textContent = `${currentVal}%`;
        if (scoreProgressbar) scoreProgressbar.setAttribute('aria-valuenow', `${currentVal}`);
      }, 12);

      // Populate Matched Tags
      if (tagsContainer) {
        tagsContainer.innerHTML = '';
        if (matchedKeys.size === 0) {
          tagsContainer.innerHTML = '<span class="text-xs text-(--color-text-muted) font-mono">No direct keywords matched from dictionary. Try pasting full JD text.</span>';
        } else {
          matchDatabase.skills.forEach(s => {
            if (matchedKeys.has(s.key)) {
              const span = document.createElement('span');
              span.className = 'badge text-xs py-1 px-2.5 border-teal-500/40 bg-teal-500/15 text-teal-300';
              span.textContent = `✔ ${s.label}`;
              tagsContainer.appendChild(span);
            }
          });
        }
      }

      if (labelMatchedCount) {
        labelMatchedCount.textContent = `${matchedKeys.size} Core Skills Identified`;
      }

      // Populate Filtered Experience Bullets
      if (bulletsContainer) {
        bulletsContainer.innerHTML = '';
        let matchingBullets = matchDatabase.bullets.filter(b => 
          b.keys.some(k => matchedKeys.has(k))
        );

        if (matchingBullets.length === 0) {
          matchingBullets = matchDatabase.bullets.slice(0, 3);
        }

        matchingBullets.forEach(b => {
          const item = document.createElement('div');
          item.className = 'flex items-start gap-2.5 text-xs leading-relaxed text-(--color-text-secondary) font-sans';
          const companyBadgeClass = b.company === 'Samsung SDS' ? 'text-teal-300 border-teal-500/30 bg-teal-500/10' : 'text-amber-300 border-amber-500/30 bg-amber-500/10';
          item.innerHTML = `
            <span class="text-teal-400 font-bold shrink-0 mt-0.5">▸</span>
            <div class="flex-1">
              <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono border ${companyBadgeClass} mr-1.5 mb-1 font-semibold">${b.company}</span>
              ${b.text}
            </div>
          `;
          bulletsContainer.appendChild(item);
        });

        if (labelBulletCount) {
          labelBulletCount.textContent = `${matchingBullets.length} Verified Evidence Bullets`;
        }
      }

      // Populate Suggested STAR Stories
      if (storiesContainer) {
        storiesContainer.innerHTML = '';
        const matchingStories = matchDatabase.stories.filter(s => 
          s.keys.some(k => matchedKeys.has(k))
        );

        const displayStories = matchingStories.length > 0 ? matchingStories : matchDatabase.stories.slice(0, 2);

        displayStories.forEach(st => {
          const card = document.createElement('div');
          card.className = 'glass-static p-3.5 rounded-xl border border-(--color-border) bg-[#080E1E]/80 text-xs flex flex-col gap-1.5';
          card.innerHTML = `
            <h4 class="font-bold text-white text-xs font-(--font-heading) flex items-center gap-1.5">
              <span class="text-amber-400">★</span> ${st.title}
            </h4>
            <p class="text-xs text-(--color-text-secondary) leading-relaxed">${st.desc}</p>
          `;
          storiesContainer.appendChild(card);
        });
      }

      if (typingStatus) typingStatus.textContent = 'Match analysis complete.';
    }

    // Input handlers
    jdTextarea?.addEventListener('input', () => {
      if (typingStatus) typingStatus.textContent = 'Analyzing input...';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(runMatching, 250);
    });

    btnMatch?.addEventListener('click', () => {
      playSound('click');
      runMatching();
    });

    btnPresetSenior?.addEventListener('click', () => {
      playSound('click');
      setActivePreset(btnPresetSenior);
      if (jdTextarea) {
        jdTextarea.value = sampleJds.senior;
        runMatching();
      }
    });

    btnPresetStaff?.addEventListener('click', () => {
      playSound('click');
      setActivePreset(btnPresetStaff);
      if (jdTextarea) {
        jdTextarea.value = sampleJds.staff;
        runMatching();
      }
    });

    btnPresetEval?.addEventListener('click', () => {
      playSound('click');
      setActivePreset(btnPresetEval);
      if (jdTextarea) {
        jdTextarea.value = sampleJds.eval;
        runMatching();
      }
    });

    btnPresetFde?.addEventListener('click', () => {
      playSound('click');
      setActivePreset(btnPresetFde);
      if (jdTextarea) {
        jdTextarea.value = sampleJds.fde;
        runMatching();
      }
    });

    btnClearJd?.addEventListener('click', () => {
      playSound('click');
      setActivePreset(null);
      if (jdTextarea) {
        jdTextarea.value = '';
        runMatching();
      }
    });

    // Copy Dossier Markdown
    btnCopyJdReport?.addEventListener('click', () => {
      playSound('click');
      const score = scorePercentage?.textContent || '0%';
      const text = `## Akanksha.dev — Candidate Match Dossier\n` +
                   `**Role Alignment Score:** ${score}\n\n` +
                   `### Core Competencies & Experience at Samsung SDS & HCLTech\n` +
                   `• **Production AI Engineer @ Samsung SDS**: Graph RAG pipelines (92% accuracy), autonomous agents with Google ADK (60% effort reduction), LLM orchestration.\n` +
                   `• **Credentials**: 300+ certifications, 4 Hackathon wins, Keynote speaker at INCEPT'26.\n` +
                   `• **Full Profile & Case Studies**: https://akanksha.dev/projects\n` +
                   `• **Direct Email**: me@akanksha.dev`;

      navigator.clipboard.writeText(text).then(() => {
        if (copyJdLabel) copyJdLabel.textContent = 'Dossier Copied!';
        playSound('success');
        setTimeout(() => {
          if (copyJdLabel) copyJdLabel.textContent = 'Copy Candidate Dossier';
        }, 2000);
      });
    });

    // Load initial sample so recruiters immediately see values
    if (jdTextarea && !jdTextarea.value) {
      jdTextarea.value = sampleJds.senior;
      runMatching();
    }
  }

  setupMatcher();
  document.addEventListener('astro:page-load', setupMatcher);
</script>
